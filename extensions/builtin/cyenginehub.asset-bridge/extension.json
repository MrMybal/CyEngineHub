{
  "schemaVersion": 1,
  "id": "cyenginehub.asset-bridge",
  "displayName": "Asset Bridge Unreal ↔ Unity ↔ Godot ↔ CryEngine",
  "version": "1.0.0",
  "publisher": "CyEngineHub",
  "description": "Transfère sans écrasement les formats d’échange FBX, glTF, OBJ, textures et audio entre projets Unreal, Unity, Godot et CryEngine. Les formats natifs et scripts ne sont pas convertis.",
  "kind": "AssetProcessor",
  "executionKind": "ExternalProcess",
  "capabilities": "AssetCopy, AssetConvert",
  "supportedEngines": [ "Unreal", "Unity", "Godot", "CryEngine" ],
  "supportedFileExtensions": [ ".fbx", ".obj", ".gltf", ".glb", ".png", ".jpg", ".jpeg", ".tga", ".tif", ".tiff", ".exr", ".hdr", ".wav", ".ogg" ],
  "entryPoint": "tools/CyEngineHub.AssetBridge.Tool.exe",
  "arguments": [ "--input", "{Input}", "--output", "{Output}", "--source-engine", "{SourceEngine}", "--target-engine", "{TargetEngine}" ],
  "website": "https://dev.epicgames.com/documentation/unreal-engine/fbx-content-pipeline-in-unreal-engine",
  "writesToOutput": true,
  "uiContributions": [
    { "id": "project-convert", "label": "Convertir des assets", "placement": "ProjectsToolbar", "action": "PrepareExecution", "order": 10 },
    { "id": "plugin-convert", "label": "Asset Bridge", "placement": "PluginsToolbar", "action": "OpenExtension", "order": 20 }
  ]
}
