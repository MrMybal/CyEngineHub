<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../assets/branding/cyenginehub.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CyUiNativeRuntime Condition="'$(CyUiNativeRuntime)' == '' And '$(OS)' == 'Windows_NT'">$(MSBuildThisFileDirectory)../../artifacts/cyui-native/runtime/Release/cimgui.dll</CyUiNativeRuntime>
    <CyUiNativeRuntime Condition="'$(CyUiNativeRuntime)' == '' And $([MSBuild]::IsOSPlatform('Linux'))">$(MSBuildThisFileDirectory)../../artifacts/cyui-native/runtime/cimgui.so</CyUiNativeRuntime>
    <CyUiNativeRuntime Condition="'$(CyUiNativeRuntime)' == '' And $([MSBuild]::IsOSPlatform('OSX'))">$(MSBuildThisFileDirectory)../../artifacts/cyui-native/runtime/cimgui.dylib</CyUiNativeRuntime>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../CyEngineHub.Core/CyEngineHub.Core.csproj" />
    <ProjectReference Include="../CyEngineHub.Mcp/CyEngineHub.Mcp.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../CyEngineHub.Engines/CyEngineHub.Engines.csproj" />
    <ProjectReference Include="../CyEngineHub.Extensions/CyEngineHub.Extensions.csproj" />
    <ProjectReference Include="../CyEngineHub.AssetBridge.Tool/CyEngineHub.AssetBridge.Tool.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../CyEngineHub.VersionBridge.Tool/CyEngineHub.VersionBridge.Tool.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../CyEngineHub.Unity/CyEngineHub.Unity.csproj" />
    <ProjectReference Include="../CyEngineHub.Godot/CyEngineHub.Godot.csproj" />
    <ProjectReference Include="../CyEngineHub.CryEngine/CyEngineHub.CryEngine.csproj" />
    <ProjectReference Include="../CyEngineHub.Unreal/CyEngineHub.Unreal.csproj" />
    <ProjectReference Include="../CyEngineHub.Projects/CyEngineHub.Projects.csproj" />
    <ProjectReference Include="../CyEngineHub.Infrastructure/CyEngineHub.Infrastructure.csproj" />
    <ProjectReference Include="../CyEngineHub.Build/CyEngineHub.Build.csproj" />
    <ProjectReference Include="../CyEngineHub.Git/CyEngineHub.Git.csproj" />
    <ProjectReference Include="../CyEngineHub.Plugins/CyEngineHub.Plugins.csproj" />
    <ProjectReference Include="../CyEngineHub.Toolchains/CyEngineHub.Toolchains.csproj" />
    <ProjectReference Include="../CyEngineHub.Storage/CyEngineHub.Storage.csproj" />
    <ProjectReference Include="../CyEngineHub.Epic/CyEngineHub.Epic.csproj" />
    <ProjectReference Include="../CyEngineHub.Fab/CyEngineHub.Fab.csproj" />
    <ProjectReference Include="../CyEngineHub.Updates/CyEngineHub.Updates.csproj" />
    <ProjectReference Include="../CyEngineHub.Updater/CyEngineHub.Updater.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- The application's CMake target supplies the only native ImGui runtime. -->
    <PackageReference Include="Hexa.NET.ImGui" ExcludeAssets="native" />
    <PackageReference Include="Silk.NET.OpenGLES" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>
  <ItemGroup><EmbeddedResource Include="ImGui/Layouts/*.xml" /></ItemGroup>
  <Target Name="BuildLocalDocumentation" BeforeTargets="AssignTargetPaths;PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Condition="'$(OS)' == 'Windows_NT'" Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)../../.CyDocBuild/build.ps1&quot;" />
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)../../Documentation/Documentation.html')" Text="Generate the offline CyDoc export with .CyDocBuild/build.ps1 before building on this platform." />
    <ItemGroup>
      <_CyDocExport Include="$(MSBuildThisFileDirectory)../../Documentation/**/*" />
      <Content Include="@(_CyDocExport)" Link="Documentation/%(_CyDocExport.RecursiveDir)%(_CyDocExport.Filename)%(_CyDocExport.Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <!-- Marketplace capabilities live in manifests, including for future built-in connectors. -->
  <ItemGroup>
    <None Include="../../extensions/builtin/**/extension.json" Link="Extensions/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../extensions/builtin/cyenginehub.source-converters/**/*" Exclude="../../extensions/builtin/cyenginehub.source-converters/extension.json;../../extensions/builtin/cyenginehub.source-converters/**/__pycache__/**" Link="Extensions/cyenginehub.source-converters/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(CyUiNativeRuntime)" Link="$([System.IO.Path]::GetFileName('$(CyUiNativeRuntime)'))" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../LICENCES/**/*" Link="LICENCES/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../native/CyEngineHub.CyUI/dependencies.lock.json" Link="CyUI/dependencies.lock.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../docs/cyui-migration.md" Link="docs/cyui-migration.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../docs/releases/v2.0.0-alpha.38.md" Link="docs/releases/v2.0.0-alpha.38.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../docs/releases/v2.0.0-alpha.39.md" Link="docs/releases/v2.0.0-alpha.39.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../docs/releases/v2.0.0-alpha.40.md" Link="docs/releases/v2.0.0-alpha.40.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../docs/releases/v2.0.0-alpha.41.md" Link="docs/releases/v2.0.0-alpha.41.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../docs/releases/v2.0.0-alpha.42.md" Link="docs/releases/v2.0.0-alpha.42.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../docs/releases/v2.0.0-alpha.43.md" Condition="Exists('../../docs/releases/v2.0.0-alpha.43.md')" Link="docs/releases/v2.0.0-alpha.43.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../docs/releases/v2.0.0-alpha.44.md" Condition="Exists('../../docs/releases/v2.0.0-alpha.44.md')" Link="docs/releases/v2.0.0-alpha.44.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../docs/releases/v2.0.0-alpha.45.md" Link="docs/releases/v2.0.0-alpha.45.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../docs/application-updates.md" Link="docs/application-updates.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../docs/source-converters.md" Link="docs/source-converters.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../docs/marketplace-connectors.md" Link="docs/marketplace-connectors.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildCyUiNative" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true' And '$(SkipBuildCyUiNative)' != 'true' And '$(OS)' == 'Windows_NT'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)../../tools/ui/build-cyui-native.ps1&quot;" />
  </Target>
  <Target Name="RequireCyUiNative" BeforeTargets="PrepareForBuild" DependsOnTargets="BuildCyUiNative" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('$(CyUiNativeRuntime)')" Text="Build the pinned CyUI runtime first (tools/ui/build-cyui-native.ps1), or set CyUiNativeRuntime to the matching local build." />
  </Target>
  <ItemGroup>
    <None Include="../../LICENSE;../../LICENSING.md;../../THIRD_PARTY_NOTICES.md"
          Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource
        Include="../../assets/branding/cyenginehub-logo.png"
        Link="Assets/Branding/cyenginehub-logo.png" />
  </ItemGroup>
  <!-- Avalonia hosts Core directly; the SDK's WPF/WinForms adapters are not used. -->
  <Target Name="UseWebView2CoreOnly" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf' Or '%(Reference.Filename)' == 'Microsoft.Web.WebView2.WinForms'" />
    </ItemGroup>
  </Target>
  <Target Name="CopyBuiltInHubExtensions" AfterTargets="Build" Condition="'$(SkipBuiltInExtensionCopy)' != 'true'">
    <ItemGroup><EditorPluginSources Include="../../extensions/unreal/CyEngineHub/**/*" /></ItemGroup>
    <Copy SourceFiles="@(EditorPluginSources)" DestinationFiles="@(EditorPluginSources->'$(OutDir)UnrealPlugin/CyEngineHub/%(RecursiveDir)%(Filename)%(Extension)')" />
    <ItemGroup><HubMcpFiles Include="../CyEngineHub.Mcp/bin/$(Configuration)/net8.0/*" /></ItemGroup>
    <Copy SourceFiles="@(HubMcpFiles)" DestinationFolder="$(OutDir)Mcp" />
    <RemoveDir Directories="$(OutDir)Extensions/cyenginehub.unreal-asset-downgrader" />
    <ItemGroup>
      <AssetBridgeToolFiles Include="../CyEngineHub.AssetBridge.Tool/bin/$(Configuration)/net8.0/**/*" />
    </ItemGroup>
    <Copy
        SourceFiles="@(AssetBridgeToolFiles)"
        DestinationFiles="@(AssetBridgeToolFiles->'$(OutDir)Extensions/cyenginehub.asset-bridge/tools/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy
        SourceFiles="../../extensions/builtin/cyenginehub.asset-bridge/extension.json"
        DestinationFolder="$(OutDir)Extensions/cyenginehub.asset-bridge" />
    <ItemGroup>
      <UnrealVersionBridgeFiles Include="../../extensions/builtin/cyenginehub.unreal-version-bridge/**/*" Exclude="../../extensions/builtin/cyenginehub.unreal-version-bridge/**/__pycache__/**;../../extensions/builtin/cyenginehub.unreal-version-bridge/**/*.pyc" />
      <SdkLicenseFiles Include="../../LICENCES/**/*" />
      <NativeTextureAdapterFiles Include="$(NativeBridgeAdapterRoot)/**/CyHubNativeBridge.uplugin;$(NativeBridgeAdapterRoot)/**/*.dll;$(NativeBridgeAdapterRoot)/**/*.modules" Exclude="$(NativeBridgeAdapterRoot)/**/HostProject/**;$(NativeBridgeAdapterRoot)/**/Intermediate/**" />
      <NativeAdapterDescriptors Include="$(NativeBridgeAdapterRoot)/**/CyHubNativeBridge.uplugin" Exclude="$(NativeBridgeAdapterRoot)/**/HostProject/**;$(NativeBridgeAdapterRoot)/**/Intermediate/**" />
      <UnrealRelocatedInstallFiles Include="../../extensions/builtin/cyenginehub.unreal-relocated-install/**/*" />
      <MarketplaceConnectorFiles Include="../../extensions/builtin/cyenginehub.marketplace-cosmos/**/*" />
      <KitBashConnectorFiles Include="../../extensions/builtin/cyenginehub.marketplace-kitbash3d/**/*" />
      <MegascansFabConnectorFiles Include="../../extensions/builtin/cyenginehub.marketplace-megascans-fab/**/*" />
      <UpdaterFiles Include="../CyEngineHub.Updater/bin/$(Configuration)/net8.0/**/*" />
    </ItemGroup>
    <PropertyGroup>
      <VersionBridgeWorkerOutputRoot>../CyEngineHub.VersionBridge.Tool/bin/$(Configuration)/net8.0/</VersionBridgeWorkerOutputRoot>
      <!-- A global -o builds references into OutDir; never package stale default-bin workers. -->
      <VersionBridgeWorkerOutputRoot Condition="Exists('$(OutDir)CyEngineHub.VersionBridge.Tool.dll')">$(OutDir)</VersionBridgeWorkerOutputRoot>
    </PropertyGroup>
    <ItemGroup>
      <VersionBridgeWorkerFiles Include="$(VersionBridgeWorkerOutputRoot)CyEngineHub.VersionBridge.Tool.*;$(VersionBridgeWorkerOutputRoot)CyEngineHub.Fab.dll;$(VersionBridgeWorkerOutputRoot)CyEngineHub.Core.dll;$(VersionBridgeWorkerOutputRoot)CyEngineHub.Unreal.dll;$(VersionBridgeWorkerOutputRoot)CyEngineHub.Projects.dll;$(VersionBridgeWorkerOutputRoot)CyEngineHub.Plugins.dll;$(VersionBridgeWorkerOutputRoot)CyEngineHub.Engines.dll" Exclude="$(VersionBridgeWorkerOutputRoot)*.pdb" />
    </ItemGroup>
    <Copy
        SourceFiles="@(UnrealVersionBridgeFiles)"
        DestinationFiles="@(UnrealVersionBridgeFiles->'$(OutDir)Extensions/cyenginehub.unreal-version-bridge/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(VersionBridgeWorkerFiles)" DestinationFolder="$(OutDir)Extensions/cyenginehub.unreal-version-bridge/mcp/tools" />
    <Copy SourceFiles="../../extensions/builtin/cyenginehub.unreal-version-bridge/scripts/agent-validate.py" DestinationFolder="$(OutDir)Extensions/cyenginehub.unreal-version-bridge/mcp/tools/Extensions/cyenginehub.unreal-version-bridge/scripts" />
    <Copy SourceFiles="@(SdkLicenseFiles)" DestinationFiles="@(SdkLicenseFiles->'$(OutDir)LICENCES/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(NativeTextureAdapterFiles)" DestinationFiles="@(NativeTextureAdapterFiles->'$(OutDir)Extensions/cyenginehub.unreal-version-bridge/native-binaries/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="../../extensions/builtin/cyenginehub.unreal-version-bridge/native-source/CyHubNativeBridge/LICENSE;../../extensions/builtin/cyenginehub.unreal-version-bridge/native-source/CyHubNativeBridge/NOTICE.md"
          DestinationFolder="$(OutDir)Extensions/cyenginehub.unreal-version-bridge/native-binaries/%(NativeAdapterDescriptors.RecursiveDir)" Condition="'@(NativeAdapterDescriptors)' != ''" />
    <Copy
        SourceFiles="@(UnrealRelocatedInstallFiles)"
        DestinationFiles="@(UnrealRelocatedInstallFiles->'$(OutDir)Extensions/cyenginehub.unreal-relocated-install/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy
        SourceFiles="@(MarketplaceConnectorFiles)"
        DestinationFiles="@(MarketplaceConnectorFiles->'$(OutDir)Extensions/cyenginehub.marketplace-cosmos/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(MegascansFabConnectorFiles)" DestinationFiles="@(MegascansFabConnectorFiles->'$(OutDir)Extensions/cyenginehub.marketplace-megascans-fab/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(KitBashConnectorFiles)" DestinationFiles="@(KitBashConnectorFiles->'$(OutDir)Extensions/cyenginehub.marketplace-kitbash3d/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy
        SourceFiles="@(UpdaterFiles)"
        DestinationFiles="@(UpdaterFiles->'$(OutDir)Updater/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
