<UserControl x:Class="CyEngineHub.Desktop.Views.ConnectorLibraryPanel"
    xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CyEngineHub.Desktop.ViewModels" x:DataType="vm:ConnectorLibraryViewModel">
  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="Bold" />
        <WrapPanel>
          <Button Classes="accent" Content="Télécharger depuis mon inventaire web" Command="{Binding OpenInventoryCommand}" Margin="0,0,8,6" />
          <Button Classes="ghost" Content="Ajouter un fichier existant" Command="{Binding ImportExistingCommand}" Margin="0,0,8,6" />
          <Button Classes="ghost" Content="Actualiser les fichiers locaux" Command="{Binding RefreshCommand}" Margin="0,0,8,6" />
        </WrapPanel>
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="11" Foreground="#A4B3C2" />
        <ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="True" Height="3" />
      </StackPanel>
    </Border>
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding IsListVisible}">
      <TextBox Text="{Binding Search}" PlaceholderText="Rechercher dans mes téléchargements…" />
      <TextBlock Grid.Column="1" Text="{Binding Summary}" VerticalAlignment="Center" Foreground="#A4B3C2" />
    </Grid>
    <Grid Grid.Row="2" IsVisible="{Binding IsListVisible}">
      <TextBlock IsVisible="{Binding IsEmpty}" Text="Aucun fichier correspondant. Téléchargez depuis le site ou ajoutez votre archive existante." TextWrapping="Wrap" Margin="18" Foreground="#8294A8" />
      <ListBox ItemsSource="{Binding Assets}" Background="Transparent" IsVisible="{Binding !IsEmpty}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListBox.Styles>
        <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ConnectorAssetViewModel">
            <Border Classes="card" Margin="0,0,0,8">
              <Grid ColumnDefinitions="74,*,Auto" ColumnSpacing="16">
                <Border Background="#172632" CornerRadius="8" Height="74"><TextBlock Text="PACK" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#70A8FA" /></Border>
                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Details}" TextWrapping="Wrap" FontSize="11" Foreground="#A4B3C2" />
                  <TextBlock Text="{Binding Availability}" Foreground="#65CCA9" FontSize="11" />
                </StackPanel>
                <Button Grid.Column="2" Classes="ghost" Content="Voir la fiche" Command="{Binding OpenCommand}" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
    <ScrollViewer Grid.Row="2" IsVisible="{Binding IsProductVisible}" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="16">
        <Button Classes="ghost" Content="← Mes assets téléchargés" Command="{Binding BackCommand}" />
        <Border Classes="card">
          <StackPanel Spacing="12">
            <TextBlock Text="{Binding SelectedAsset.Name}" FontSize="26" FontWeight="Bold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SelectedAsset.Details}" Foreground="#65CCA9" />
            <TextBlock Text="FICHE LOCALE · FICHIER TÉLÉCHARGÉ" FontSize="11" Foreground="#70A8FA" />
            <TextBlock Text="{Binding SelectedAsset.Asset.FilePath}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SelectedAsset.Date}" FontSize="11" />
            <TextBlock Text="{Binding SelectedAsset.Availability}" Foreground="#A4B3C2" />
            <Button Classes="ghost" Content="Ouvrir le dossier du fichier" Command="{Binding OpenFolderCommand}" />
            <TextBlock Text="Le type est déduit des fichiers de l’archive, pas du site. La version moteur et les images officielles ne sont pas récupérées automatiquement." TextWrapping="Wrap" Foreground="#8294A8" FontSize="11" />
          </StackPanel>
        </Border>
        <Border Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Text="Personnaliser ma fiche" FontSize="16" FontWeight="SemiBold" />
            <TextBox Text="{Binding EditName}" PlaceholderText="Nom de l’asset" />
            <TextBox Text="{Binding EditNotes}" PlaceholderText="Notes personnelles" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" />
            <Button Classes="accent" Content="Enregistrer la fiche" Command="{Binding SaveCommand}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
