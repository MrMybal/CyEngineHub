<Window
    x:Class="CyEngineHub.Desktop.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CyEngineHub.Desktop.ViewModels"
    x:DataType="vm:MainWindowViewModel"
    Title="CyEngineHub — Multi-Engine Development Hub"
    Icon="avares://CyEngineHub.Desktop/Assets/Branding/cyenginehub-logo.png"
    Width="1380"
    Height="860"
    MinWidth="1080"
    MinHeight="700"
    Background="#0A0E13">

  <Window.Styles>
    <Style Selector="TextBlock">
      <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
      <Setter Property="Foreground" Value="#D9E2EC" />
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#98A8B9" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="Button.nav:pointerover">
      <Setter Property="Background" Value="#17202B" />
      <Setter Property="Foreground" Value="#F2F7FC" />
    </Style>
    <Style Selector="Button.nav.active">
      <Setter Property="Background" Value="#163149" />
      <Setter Property="Foreground" Value="#F5FAFF" />
      <Setter Property="BorderBrush" Value="#2E73AA" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="#2D7FF9" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.refresh-running:disabled">
      <Setter Property="Background" Value="#4B535E" />
      <Setter Property="Foreground" Value="#F4F7FA" />
      <Setter Property="BorderBrush" Value="#4B535E" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="#18212C" />
      <Setter Property="Foreground" Value="#CFD9E5" />
      <Setter Property="BorderBrush" Value="#263343" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style Selector="Button.asset-action">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="7" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.connection">
      <Setter Property="Width" Value="66" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Background" Value="#111A24" />
      <Setter Property="Foreground" Value="#D7E1EC" />
      <Setter Property="BorderBrush" Value="#26384B" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.history">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="17" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#26384B" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#B9CADB" />
      <Setter Property="FontSize" Value="22" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.history:pointerover">
      <Setter Property="Background" Value="#17283A" />
      <Setter Property="BorderBrush" Value="#438ED1" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.view-mode.active">
      <Setter Property="Background" Value="#1D4E7A" />
      <Setter Property="BorderBrush" Value="#438ED1" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="#8F3042" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#111820" />
      <Setter Property="BorderBrush" Value="#202C39" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="18" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="Border.card.official-engine">
      <Setter Property="Background" Value="#102421" />
      <Setter Property="BorderBrush" Value="#2F8A78" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Border.metric">
      <Setter Property="Background" Value="#111820" />
      <Setter Property="BorderBrush" Value="#202C39" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="20" />
    </Style>
    <Style Selector="ListBox.catalog">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBox.catalog > ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TextBox.path">
      <Setter Property="Background" Value="#0D131A" />
      <Setter Property="BorderBrush" Value="#283748" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="12,9" />
    </Style>
    <Style Selector="ListBox.engine-tabs">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBox.engine-tabs > ListBoxItem">
      <Setter Property="Background" Value="#111A24" />
      <Setter Property="BorderBrush" Value="#26384B" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style Selector="ListBox.engine-tabs > ListBoxItem:selected">
      <Setter Property="Background" Value="#1D4E7A" />
      <Setter Property="BorderBrush" Value="#438ED1" />
    </Style>
    <Style Selector="ListBox.settings-nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBox.settings-nav > ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.settings-nav > ListBoxItem:selected">
      <Setter Property="Background" Value="#132A3D" />
      <Setter Property="BorderBrush" Value="#2D6DA1" />
    </Style>
  </Window.Styles>

  <Grid>
  <Grid ColumnDefinitions="Auto,*" IsHitTestVisible="{Binding !IsAnyFabModalVisible}" IsEnabled="{Binding !IsAnyFabModalVisible}">
    <Grid.Effect>
      <BlurEffect Radius="{Binding FabOptionsModalBlurRadius}" />
    </Grid.Effect>
    <Border Grid.Column="0" Width="184" IsVisible="{Binding IsMainNavigationVisible}" Background="#0D1218" BorderBrush="#1C2632" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto" Margin="12">
        <Grid Margin="-8,-4,0,20" ColumnDefinitions="48,*" ColumnSpacing="8">
          <Image
              Width="44"
              Height="44"
              Source="avares://CyEngineHub.Desktop/Assets/Branding/cyenginehub-logo.png"
              Stretch="Uniform" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Text="CYENGINEHUB" FontSize="13" FontWeight="Bold" Foreground="#F5F8FC" VerticalAlignment="Center" />
              <Border Background="#50331A" BorderBrush="#C77B2B" BorderThickness="1" CornerRadius="4" Padding="5,2" VerticalAlignment="Center">
                <TextBlock Text="ALPHA" FontSize="7" FontWeight="Bold" Foreground="#FFBE73" />
              </Border>
            </StackPanel>
            <TextBlock Text="MULTI-ENGINE DEV HUB" FontSize="7" FontWeight="SemiBold" Foreground="#4F91F9" Margin="1,2,0,0" />
            <TextBlock Text="{Binding ApplicationVersion}" FontSize="8" FontWeight="SemiBold" Foreground="#718398" Margin="1,2,0,0" />
          </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1">
          <TextBlock Text="ENVIRONNEMENT" FontSize="10" FontWeight="Bold" Foreground="#617184" Margin="10,0,0,7" />
          <Button Classes="nav" Classes.active="{Binding IsHomeNavigationActive}" Content="Vue d’ensemble" Command="{Binding ShowHomeCommand}" />
          <Button Classes="nav" Classes.active="{Binding IsEnginesNavigationActive}" Content="Moteurs" Command="{Binding ShowEnginesCommand}" />
          <Button Classes="nav" Classes.active="{Binding IsProjectsNavigationActive}" Content="Projets" Command="{Binding ShowProjectsCommand}" />
          <Button Classes="nav" Classes.active="{Binding IsLibraryNavigationActive}" Content="Bibliothèque" Command="{Binding ShowLibraryCommand}" />
          <Button Classes="nav" Classes.active="{Binding IsExtensionsNavigationActive}" Content="Extensions Hub" Command="{Binding ShowHubExtensionsCommand}" />
          <Button Classes="nav" Classes.active="{Binding IsStorageNavigationActive}" Content="Stockage" Command="{Binding ShowStorageCommand}" />
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="4" Margin="0,12,0,0">
          <TextBlock Text="SYSTÈME" FontSize="10" FontWeight="Bold" Foreground="#617184" Margin="10,0,0,5" />
          <Button Classes="nav" Classes.active="{Binding IsTasksNavigationActive}" Content="Téléchargements" Command="{Binding ShowTasksCommand}" FontSize="12" />
          <Button Classes="nav" Classes.active="{Binding IsLogsNavigationActive}" Content="Logs" Command="{Binding ShowLogsCommand}" IsVisible="{Binding IsLogsNavigationVisible}" />
          <Button Classes="nav" Classes.active="{Binding IsSettingsNavigationActive}" Content="⚙  Paramètres" Command="{Binding ShowSettingsCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">
      <Border Grid.Row="0" BorderBrush="#1C2632" BorderThickness="0,0,0,1" Padding="10,12">
        <Grid ColumnDefinitions="300,*,300">
          <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
            <Button Classes="history" Content="←" Command="{Binding NavigateBackCommand}" ToolTip.Tip="Page précédente" />
            <Button Classes="history" Content="→" Command="{Binding NavigateForwardCommand}" ToolTip.Tip="Page suivante" />
          </StackPanel>
          <StackPanel Grid.Column="1" HorizontalAlignment="Center">
            <TextBlock Text="{Binding HeaderTitle}" FontSize="24" FontWeight="SemiBold" Foreground="#F3F7FB" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding HeaderSubtitle}" FontSize="11" Foreground="#75869A" Margin="0,4,0,0" HorizontalAlignment="Center" />
          </StackPanel>
          <WrapPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button Classes="connection" Command="{Binding ShowEpicConnectionSettingsCommand}" ToolTip.Tip="{Binding EpicConnectionStatus}" Margin="0,0,6,0" IsVisible="{Binding IsEpicConnectionEnabled}">
              <Grid Width="48" Height="22"><TextBlock Text="EPIC" HorizontalAlignment="Center" VerticalAlignment="Center" /><Ellipse Width="8" Height="8" Fill="{Binding EpicConnectionIndicator}" HorizontalAlignment="Right" VerticalAlignment="Bottom" /></Grid>
            </Button>
            <Button Classes="connection" Command="{Binding ShowFabConnectionSettingsCommand}" ToolTip.Tip="{Binding FabConnectionStatus}" Margin="0,0,6,0" IsVisible="{Binding IsFabConnectionEnabled}">
              <Grid Width="48" Height="22"><TextBlock Text="FAB" HorizontalAlignment="Center" VerticalAlignment="Center" /><Ellipse Width="8" Height="8" Fill="{Binding FabConnectionIndicator}" HorizontalAlignment="Right" VerticalAlignment="Bottom" /></Grid>
            </Button>
            <Button Classes="connection" Command="{Binding ShowGitConnectionSettingsCommand}" ToolTip.Tip="{Binding GitConnectionStatus}" Margin="0,0,6,0" IsVisible="{Binding IsGitConnectionEnabled}">
              <Grid Width="48" Height="22"><TextBlock Text="GIT" HorizontalAlignment="Center" VerticalAlignment="Center" /><Ellipse Width="8" Height="8" Fill="{Binding GitConnectionIndicator}" HorizontalAlignment="Right" VerticalAlignment="Bottom" /></Grid>
            </Button>
            <Button Classes="connection" Command="{Binding ShowUnityConnectionSettingsCommand}" ToolTip.Tip="{Binding UnityStoreConnectionStatus}" IsVisible="{Binding IsUnityConnectionEnabled}">
              <Grid Width="48" Height="22"><TextBlock Text="UNITY" HorizontalAlignment="Center" VerticalAlignment="Center" /><Ellipse Width="8" Height="8" Fill="{Binding UnityConnectionIndicator}" HorizontalAlignment="Right" VerticalAlignment="Bottom" /></Grid>
            </Button>
          </WrapPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1" Margin="10,4,16,8">
        <ScrollViewer IsVisible="{Binding IsHomeVisible}" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="18">
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="14">
              <Border Classes="metric">
                <StackPanel>
                  <TextBlock Text="MOTEURS" FontSize="10" FontWeight="Bold" Foreground="#6E8196" />
                  <TextBlock Text="{Binding EngineCount}" FontSize="34" FontWeight="SemiBold" Foreground="#EAF1F8" Margin="0,8,0,0" />
                  <TextBlock Text="Installations détectées" FontSize="11" Foreground="#74869A" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="metric">
                <StackPanel>
                  <TextBlock Text="PROJETS" FontSize="10" FontWeight="Bold" Foreground="#6E8196" />
                  <TextBlock Text="{Binding ProjectCount}" FontSize="34" FontWeight="SemiBold" Foreground="#EAF1F8" Margin="0,8,0,0" />
                  <TextBlock Text="Descripteurs catalogués" FontSize="11" Foreground="#74869A" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Classes="metric">
                <StackPanel>
                  <TextBlock Text="TOOLCHAINS" FontSize="10" FontWeight="Bold" Foreground="#6E8196" />
                  <TextBlock Text="{Binding ToolchainProblemCount}" FontSize="34" FontWeight="SemiBold" Foreground="#F2B84B" Margin="0,8,0,0" />
                  <TextBlock Text="Compatibilités à vérifier" FontSize="11" Foreground="#74869A" />
                </StackPanel>
              </Border>
              <Border Grid.Column="3" Classes="metric">
                <StackPanel>
                  <TextBlock Text="ATTENTION" FontSize="10" FontWeight="Bold" Foreground="#6E8196" />
                  <TextBlock Text="{Binding WarningCount}" FontSize="34" FontWeight="SemiBold" Foreground="#F2B84B" Margin="0,8,0,0" />
                  <TextBlock Text="Éléments à vérifier" FontSize="11" Foreground="#74869A" />
                </StackPanel>
              </Border>
            </Grid>

            <Grid ColumnDefinitions="2*,*" ColumnSpacing="14">
              <Border Classes="card">
                <StackPanel>
                  <TextBlock Text="Démarrage rapide" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock
                      Text="CyEngineHub fédère des providers indépendants pour Unreal, Unity, Godot, CryEngine et les moteurs futurs. Chaque provider contrôle sa détection, ses projets, ses builds et ses assets."
                      TextWrapping="Wrap"
                      Foreground="#8799AC"
                      FontSize="12"
                      Margin="0,8,0,18" />
                  <WrapPanel>
                    <Button Classes="accent" Content="Voir les moteurs" Command="{Binding ShowEnginesCommand}" Margin="0,0,8,0" />
                    <Button Classes="ghost" Content="Voir les projets" Command="{Binding ShowProjectsCommand}" />
                  </WrapPanel>
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="card">
                <StackPanel>
                  <TextBlock Text="Mode local" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding StorageMode}" Foreground="#55C7A6" FontWeight="SemiBold" Margin="0,10,0,0" />
                  <TextBlock Text="{Binding DataDirectory}" TextWrapping="Wrap" Foreground="#718398" FontSize="11" Margin="0,5,0,0" />
                  <TextBlock Text="Aucune télémétrie." Foreground="#718398" FontSize="11" Margin="0,16,0,0" />
                </StackPanel>
              </Border>
            </Grid>

            <Border Classes="card">
              <StackPanel>
                <TextBlock Text="Modules du hub" FontSize="16" FontWeight="SemiBold" />
                <TextBlock
                    Text="Moteurs · Projets · Builds UBT/UAT · Git &amp; LFS · Plugins locaux · Toolchains · Stockage Unreal et Safe Clean"
                    Foreground="#8294A8"
                    Margin="0,9,0,0" />
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Stockage local" FontSize="16" FontWeight="SemiBold" />
                  <Button Grid.Column="1" Classes="ghost" Content="Ouvrir Stockage" Command="{Binding ShowStorageCommand}" />
                </Grid>
                <Grid ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="16">
                  <StackPanel>
                    <TextBlock Text="MOTEURS" FontSize="9" FontWeight="Bold" Foreground="#5F7287" />
                    <TextBlock Text="{Binding StorageEngineSize}" FontSize="15" Margin="0,4,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="PROJETS" FontSize="9" FontWeight="Bold" Foreground="#5F7287" />
                    <TextBlock Text="{Binding StorageProjectSize}" FontSize="15" Margin="0,4,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="DDC" FontSize="9" FontWeight="Bold" Foreground="#5F7287" />
                    <TextBlock Text="{Binding StorageDdcSize}" FontSize="15" Margin="0,4,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="3">
                    <TextBlock Text="VAULT" FontSize="9" FontWeight="Bold" Foreground="#5F7287" />
                    <TextBlock Text="{Binding StorageVaultSize}" FontSize="15" Margin="0,4,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="4">
                    <TextBlock Text="GIT LFS" FontSize="9" FontWeight="Bold" Foreground="#5F7287" />
                    <TextBlock Text="{Binding StorageLfsSize}" FontSize="15" Margin="0,4,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="5">
                    <TextBlock Text="SAFE CLEAN" FontSize="9" FontWeight="Bold" Foreground="#5F7287" />
                    <TextBlock Text="{Binding StorageReclaimableSize}" FontSize="15" Foreground="#55C7A6" Margin="0,4,0,0" />
                  </StackPanel>
                </Grid>
                <TextBlock Text="Valeurs issues du dernier inventaire manuel en cache." FontSize="9" Foreground="#617489" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <Grid IsVisible="{Binding IsEnginesVisible}" RowDefinitions="0,Auto,*">
          <Border Classes="card" Margin="0,0,0,14" IsVisible="False">
            <StackPanel Spacing="9">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="MOTEURS DISPONIBLES" FontSize="10" FontWeight="Bold" Foreground="#65788D" />
                  <TextBlock Text="Activez uniquement les moteurs utilisés. La désactivation masque le provider sans toucher aux installations ni aux projets." FontSize="10" Foreground="#8294A8" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding ActiveEngineModuleCount, StringFormat='{}{0} ACTIF(S)'}" FontSize="9" FontWeight="Bold" Foreground="#65CCA9" VerticalAlignment="Center" />
              </Grid>
              <ItemsControl ItemsSource="{Binding EngineModules}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:EngineModuleCardViewModel">
                    <Border Background="#0D141C" BorderBrush="#202C39" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,6">
                      <Grid ColumnDefinitions="170,90,*,Auto" ColumnSpacing="12">
                        <StackPanel>
                          <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Vendor}" FontSize="9" Foreground="#64768A" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#17283B" CornerRadius="4" Padding="7,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Status}" FontSize="8" FontWeight="Bold" Foreground="#70A8FA" />
                        </Border>
                        <StackPanel Grid.Column="2">
                          <TextBlock Text="{Binding Summary}" FontSize="9" Foreground="#A6B4C3" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Capabilities}" FontSize="8" Foreground="#64768A" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="3" Classes="ghost" Content="{Binding ToggleLabel}" Command="{Binding ToggleEnabledCommand}" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding HubEngineToolbarContributions}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:HubUiContributionButtonViewModel">
                    <Button Classes="accent" Content="{Binding Label}" Command="{Binding InvokeCommand}" ToolTip.Tip="{Binding ToolTip}" Margin="0,0,7,0" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border Grid.Row="1" Classes="card" Margin="0,0,0,14" Padding="10">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                <ListBox Classes="engine-tabs" ItemsSource="{Binding EngineTabs}" SelectedItem="{Binding SelectedEngineTab}" SelectionMode="Single">
                  <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:EngineFamilyOptionViewModel"><TextBlock Text="{Binding Label}" FontWeight="SemiBold" /></DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <ComboBox Grid.Column="1" ItemsSource="{Binding EngineSortOptions}" SelectedItem="{Binding SelectedEngineSort}" MinWidth="175" ToolTip.Tip="Trier les moteurs" />
                <Button Grid.Column="2" Classes="ghost view-mode" Classes.active="{Binding IsEngineCardView}" Content="Cartes" Command="{Binding ShowEngineCardsCommand}" />
                <Button Grid.Column="3" Classes="ghost view-mode" Classes.active="{Binding IsEngineListView}" Content="Liste" Command="{Binding ShowEngineListCommand}" />
                <Button Grid.Column="4" Classes="accent" Content="Ajouter un moteur…" Command="{Binding ToggleEngineImporterCommand}" />
              </Grid>
          </Border>
          <Grid Grid.Row="2">
            <ScrollViewer IsVisible="{Binding IsUnrealEngineCardViewVisible}" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding VisibleEngines}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:EngineCardViewModel">
                    <Border Classes="card" Classes.official-engine="{Binding IsOfficialEpic}" Width="292" Height="244" Margin="0,0,12,12" PointerReleased="OpenDetailsFromItem" Cursor="Hand">
                      <Grid RowDefinitions="Auto,Auto,*,Auto">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel>
                            <TextBlock Text="{Binding Organization.DisplayName}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding TypeLabel}" FontSize="9" Foreground="#718398" Margin="0,3,0,0" />
                            <TextBlock Text="OFFICIEL EPIC" IsVisible="{Binding IsOfficialEpic}" FontSize="8" FontWeight="Bold" Foreground="#65CCA9" Margin="0,4,0,0" />
                          </StackPanel>
                          <Border Grid.Column="1" Background="#18283A" CornerRadius="5" Padding="7,3" VerticalAlignment="Top">
                            <TextBlock Text="{Binding VersionLabel}" FontSize="9" FontWeight="Bold" Foreground="#70A8FA" />
                          </Border>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding Path}" FontSize="9" Foreground="#718398" Margin="0,9,0,0" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Row="2" Margin="0,12,0,0">
                          <TextBlock Text="{Binding HealthLabel}" FontSize="10" FontWeight="Bold" Foreground="#65CCA9" />
                          <TextBlock Text="{Binding EffectiveSizeLabel}" FontSize="10" Foreground="#A8C9F2" Margin="0,5,0,0" />
                          <TextBlock Text="{Binding IssueSummary}" FontSize="10" Foreground="#9DACBB" TextWrapping="Wrap" MaxHeight="56" Margin="0,5,0,0" />
                          <TextBlock Text="{Binding Organization.FolderLabel}" FontSize="9" Foreground="#D9A55C" Margin="0,8,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Row="3" Text="Cliquer pour ouvrir le profil" FontSize="10" FontWeight="SemiBold" Foreground="#70A8FA" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <ScrollViewer IsVisible="{Binding IsLocalEngineCardViewVisible}" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding VisibleLocalEngineInstallations}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LocalEngineInstallationCardViewModel">
                    <Border Classes="card" Width="292" Height="244" Margin="0,0,12,12" PointerReleased="OpenDetailsFromItem" Cursor="Hand">
                      <Grid RowDefinitions="Auto,Auto,*,Auto">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{Binding Organization.DisplayName}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <Border Grid.Column="1" Background="#18283A" CornerRadius="5" Padding="7,3"><TextBlock Text="{Binding Family}" FontSize="9" FontWeight="Bold" Foreground="#70A8FA" /></Border>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding Version}" FontSize="11" Foreground="#AAB7C5" Margin="0,9,0,0" />
                        <StackPanel Grid.Row="2" Margin="0,12,0,0">
                          <TextBlock Text="{Binding Path}" FontSize="9" Foreground="#718398" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Source}" FontSize="10" Foreground="#9DACBB" TextWrapping="Wrap" Margin="0,8,0,0" />
                          <TextBlock Text="{Binding EffectiveSizeLabel}" FontSize="10" Foreground="#A8C9F2" Margin="0,6,0,0" />
                          <TextBlock Text="{Binding Organization.FolderLabel}" FontSize="9" Foreground="#D9A55C" Margin="0,8,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Row="3" Text="Cliquer pour ouvrir le profil" FontSize="10" FontWeight="SemiBold" Foreground="#70A8FA" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <ListBox Classes="catalog" ItemsSource="{Binding VisibleEngines}" IsVisible="{Binding IsUnrealEngineListViewVisible}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:EngineCardViewModel">
                  <Border Classes="card" Classes.official-engine="{Binding IsOfficialEpic}" PointerReleased="OpenDetailsFromItem" Cursor="Hand">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                      <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="9">
                          <TextBlock Text="{Binding Organization.DisplayName}" FontSize="17" FontWeight="SemiBold" Foreground="#F0F5FA" />
                          <Border Background="#18283A" CornerRadius="5" Padding="7,3">
                            <TextBlock Text="{Binding VersionLabel}" FontSize="10" FontWeight="Bold" Foreground="#70A8FA" />
                          </Border>
                          <Border Background="#17251F" CornerRadius="5" Padding="7,3">
                            <TextBlock Text="{Binding HealthLabel}" FontSize="10" FontWeight="Bold" Foreground="#65CCA9" />
                          </Border>
                          <Border Background="#123228" CornerRadius="5" Padding="7,3" IsVisible="{Binding IsOfficialEpic}">
                            <TextBlock Text="OFFICIEL EPIC" FontSize="9" FontWeight="Bold" Foreground="#65CCA9" />
                          </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Path}" FontSize="11" Foreground="#718398" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding EffectiveSizeLabel}" FontSize="10" Foreground="#A8C9F2" Margin="0,5,0,0" />
                        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="20" Margin="0,13,0,0">
                          <StackPanel>
                            <TextBlock Text="TYPE" FontSize="9" FontWeight="Bold" Foreground="#596B7E" />
                            <TextBlock Text="{Binding TypeLabel}" FontSize="11" Margin="0,3,0,0" />
                          </StackPanel>
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="BRANCHE" FontSize="9" FontWeight="Bold" Foreground="#596B7E" />
                            <TextBlock Text="{Binding BranchLabel}" FontSize="11" Margin="0,3,0,0" MaxWidth="280" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <StackPanel Grid.Column="2">
                            <TextBlock Text="DIAGNOSTIC" FontSize="9" FontWeight="Bold" Foreground="#596B7E" />
                            <TextBlock Text="{Binding IssueSummary}" FontSize="11" Margin="0,3,0,0" MaxWidth="420" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <StackPanel Grid.Column="3">
                            <TextBlock Text="ASSOCIATION" FontSize="9" FontWeight="Bold" Foreground="#596B7E" />
                            <TextBlock Text="{Binding RegistrationLabel}" FontSize="11" Margin="0,3,0,0" MaxWidth="260" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Grid>
                      </StackPanel>
                      <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right" MaxWidth="460" Spacing="7">
                        <WrapPanel>
                          <Button Classes="accent" Content="Lancer" Command="{Binding LaunchCommand}" />
                          <Button Classes="ghost" Content="Setup" Command="{Binding SetupCommand}" IsVisible="{Binding CanSetup}" Margin="8,0,0,0" />
                          <Button Classes="ghost" Content="Build Editor" Command="{Binding BuildEditorCommand}" Margin="8,0,0,0" />
                          <Button Classes="ghost" Content="GPF" Command="{Binding GenerateProjectFilesCommand}" Margin="8,0,0,0" />
                          <Button Classes="ghost" Content="Dossier" Command="{Binding OpenFolderCommand}" Margin="8,0,0,0" />
                          <Button Classes="ghost" Content="Enregistrer" Command="{Binding RegisterCommand}" IsVisible="{Binding CanRegister}" Margin="8,0,0,0" />
                          <Button Classes="ghost" Content="Désenregistrer" Command="{Binding RequestUnregisterCommand}" IsVisible="{Binding IsRegistered}" Margin="8,0,0,0" />
                        </WrapPanel>
                        <Border IsVisible="{Binding IsUnregisterConfirmationVisible}" Background="#321A1D" CornerRadius="6" Padding="9">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Retirer l’association Unreal de ce moteur ?" Foreground="#F0B4B7" VerticalAlignment="Center" />
                            <Button Classes="ghost" Content="Confirmer" Command="{Binding ConfirmUnregisterCommand}" />
                            <Button Classes="ghost" Content="Annuler" Command="{Binding CancelUnregisterCommand}" />
                          </StackPanel>
                        </Border>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <ListBox Classes="catalog" ItemsSource="{Binding VisibleLocalEngineInstallations}" IsVisible="{Binding IsLocalEngineListViewVisible}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:LocalEngineInstallationCardViewModel">
                  <Border Classes="card" PointerReleased="OpenDetailsFromItem" Cursor="Hand">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                      <StackPanel Spacing="7">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                          <TextBlock Text="{Binding Organization.DisplayName}" FontSize="17" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Version}" FontSize="10" Foreground="#70A8FA" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Organization.FolderLabel}" FontSize="9" Foreground="#D9A55C" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding Path}" FontSize="10" Foreground="#718398" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Source}" FontSize="9" Foreground="#8294A8" />
                        <TextBlock Text="{Binding EffectiveSizeLabel}" FontSize="10" Foreground="#A8C9F2" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Top">
                        <Button Classes="accent" Content="Lancer" Command="{Binding LaunchCommand}" />
                        <Button Classes="ghost" Content="Dossier" Command="{Binding OpenFolderCommand}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
          <Grid Grid.RowSpan="3" IsVisible="{Binding IsEngineImporterVisible}" Panel.ZIndex="500">
            <Border Background="#CC05080C" />
            <Border Width="900" MaxHeight="660" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#111820" BorderBrush="#31506D" BorderThickness="1" CornerRadius="12" Padding="22">
              <Grid RowDefinitions="Auto,*" RowSpacing="16">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="Ajouter un moteur" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="Choisissez une installation locale ou préparez une version source. Rien n’est installé sans confirmation." FontSize="10" Foreground="#8294A8" Margin="0,5,0,0" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="history" Content="✕" Command="{Binding ToggleEngineImporterCommand}" />
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                  <StackPanel Spacing="12">
                    <Border Classes="card" Margin="0">
                      <StackPanel Spacing="9">
                        <TextBlock Text="INSTALLATION LOCALE" FontSize="10" FontWeight="Bold" Foreground="#70A8FA" />
                        <TextBlock Text="Unreal, Unity, Godot ou CryEngine déjà présent sur ce PC." FontSize="10" Foreground="#8294A8" />
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="9">
                          <TextBox Classes="path" Text="{Binding ManualEnginePath}" PlaceholderText="Dossier racine ou exécutable de l’éditeur" />
                          <Button Grid.Column="1" Classes="ghost" Content="Parcourir…" Click="BrowseManualEnginePath" />
                          <Button Grid.Column="2" Classes="accent" Content="Ajouter et analyser" Command="{Binding AddEnginePathCommand}" />
                        </Grid>
                      </StackPanel>
                    </Border>
                    <Border Classes="card" Margin="0">
                      <StackPanel Spacing="9">
                        <TextBlock Text="UNREAL ENGINE · SOURCES GITHUB" FontSize="10" FontWeight="Bold" Foreground="#70A8FA" />
                        <TextBlock Text="Utilisez le dépôt officiel auquel votre compte GitHub a accès, ou indiquez un fork et une branche personnalisés." FontSize="10" Foreground="#8294A8" TextWrapping="Wrap" />
                        <TextBox Classes="path" Text="{Binding SourceEngineRepository}" PlaceholderText="URL GitHub" />
                        <Grid ColumnDefinitions="220,*,Auto,Auto" ColumnSpacing="9">
                          <ComboBox ItemsSource="{Binding AvailableSourceEngineVersions}" SelectedItem="{Binding SelectedSourceEngineVersion}" PlaceholderText="Branche ou tag officiel" />
                          <TextBox Grid.Column="1" Classes="path" Text="{Binding SourceEngineTargetDirectory}" PlaceholderText="Dossier cible vide" />
                          <Button Grid.Column="2" Classes="ghost" Content="Parcourir…" Click="BrowseSourceEngineTarget" />
                          <Button Grid.Column="3" Classes="accent" Content="Préparer" Command="{Binding PrepareSourceEngineDownloadCommand}" />
                        </Grid>
                        <TextBlock Text="{Binding SourceEngineVersionsStatus}" FontSize="9" Foreground="#8294A8" TextWrapping="Wrap" />
                        <CheckBox Content="Clone léger (profondeur 1)" IsChecked="{Binding SourceEngineShallowClone}" />
                        <Border IsVisible="{Binding HasPendingSourceEngineDownload}" Background="#132A3D" CornerRadius="7" Padding="10">
                          <StackPanel Spacing="8">
                            <TextBlock Text="{Binding PendingSourceEngineDownloadSummary}" FontSize="10" TextWrapping="Wrap" />
                            <WrapPanel><Button Classes="accent" Content="Confirmer le clone" Command="{Binding ConfirmSourceEngineDownloadCommand}" Margin="0,0,8,0" /><Button Classes="ghost" Content="Annuler" Command="{Binding CancelSourceEngineDownloadCommand}" /></WrapPanel>
                          </StackPanel>
                        </Border>
                      </StackPanel>
                    </Border>
                    <Border Classes="card" Margin="0">
                      <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                          <StackPanel>
                            <TextBlock Text="UNREAL ENGINE · VERSIONS OFFICIELLES EPIC" FontSize="10" FontWeight="Bold" Foreground="#70A8FA" />
                            <TextBlock Text="Catalogue et manifests officiels via votre connexion Epic sécurisée. Epic Games Launcher n’est pas utilisé." FontSize="10" Foreground="#8294A8" TextWrapping="Wrap" Margin="0,5,0,0" />
                          </StackPanel>
                          <Button Grid.Column="1" Classes="ghost" Content="Actualiser les versions" Command="{Binding RefreshEpicEngineReleasesCommand}" VerticalAlignment="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="220,*,Auto,Auto" ColumnSpacing="9">
                          <ComboBox ItemsSource="{Binding AvailableEpicEngineReleases}" SelectedItem="{Binding SelectedEpicEngineRelease}" DisplayMemberBinding="{Binding DisplayName}" PlaceholderText="Version Unreal" />
                          <TextBox Grid.Column="1" Classes="path" Text="{Binding EpicEngineTargetDirectory}" PlaceholderText="Dossier cible absent ou vide" />
                          <Button Grid.Column="2" Classes="ghost" Content="Parcourir…" Click="BrowseEpicEngineTarget" />
                          <Button Grid.Column="3" Classes="accent" Content="Télécharger" Command="{Binding DownloadEpicEngineCommand}" />
                        </Grid>
                        <TextBlock Text="{Binding EngineBinaryDownloadSummary}" FontSize="10" Foreground="#D9A55C" TextWrapping="Wrap" />
                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding EpicEngineDownloadProgress}" Height="8" IsVisible="{Binding IsEpicEngineDownloadActive}" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </ScrollViewer>
              </Grid>
            </Border>
          </Grid>
        </Grid>

        <ScrollViewer IsVisible="{Binding IsEngineDetailsVisible}" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="14">
            <StackPanel IsVisible="{Binding IsUnrealEngineDetailsSelected}" Spacing="14">
              <Border Classes="card" Padding="22">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="22">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <TextBlock Text="{Binding SelectedEngineDetails.DisplayName}" FontSize="26" FontWeight="SemiBold" Foreground="#F3F7FB" />
                      <Border Background="#18283A" CornerRadius="5" Padding="8,4"><TextBlock Text="{Binding SelectedEngineDetails.VersionLabel}" FontSize="10" FontWeight="Bold" Foreground="#70A8FA" /></Border>
                      <Border Background="#17251F" CornerRadius="5" Padding="8,4"><TextBlock Text="{Binding SelectedEngineDetails.HealthLabel}" FontSize="10" FontWeight="Bold" Foreground="#65CCA9" /></Border>
                      <Border Background="#123228" CornerRadius="5" Padding="8,4" IsVisible="{Binding SelectedEngineDetails.IsOfficialEpic}"><TextBlock Text="OFFICIEL EPIC" FontSize="10" FontWeight="Bold" Foreground="#65CCA9" /></Border>
                    </StackPanel>
                    <TextBlock Text="{Binding SelectedEngineDetails.Path}" FontSize="11" Foreground="#718398" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SelectedEngineDetails.IssueSummary}" FontSize="11" Foreground="#D9A55C" Margin="0,12,0,0" TextWrapping="Wrap" />
                  </StackPanel>
                  <WrapPanel Grid.Column="1" VerticalAlignment="Center" MaxWidth="520">
                    <Button Classes="accent" Content="Lancer" Command="{Binding SelectedEngineDetails.LaunchCommand}" Margin="0,0,8,8" />
                    <Button Classes="ghost" Content="Setup" Command="{Binding SelectedEngineDetails.SetupCommand}" IsVisible="{Binding SelectedEngineDetails.CanSetup}" Margin="0,0,8,8" />
                    <Button Classes="ghost" Content="Build Editor" Command="{Binding SelectedEngineDetails.BuildEditorCommand}" Margin="0,0,8,8" />
                    <Button Classes="ghost" Content="GPF" Command="{Binding SelectedEngineDetails.GenerateProjectFilesCommand}" Margin="0,0,8,8" />
                    <Button Classes="ghost" Content="Ouvrir le dossier" Command="{Binding SelectedEngineDetails.OpenFolderCommand}" Margin="0,0,8,8" />
                    <Button Classes="ghost" Content="Retirer de CyEngineHub" Command="{Binding RequestRemoveSelectedEngineCommand}" Margin="0,0,8,8" />
                    <Button Classes="danger" Content="Désinstaller" Command="{Binding RequestUninstallSelectedEngineCommand}" Margin="0,0,0,8" />
                  </WrapPanel>
                </Grid>
              </Border>
              <Grid ColumnDefinitions="*" ColumnSpacing="14">
                <Border Classes="card">
                  <StackPanel Spacing="12">
                    <TextBlock Text="INSTALLATION" FontSize="10" FontWeight="Bold" Foreground="#65788D" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="18" RowSpacing="13">
                      <StackPanel><TextBlock Text="TYPE" FontSize="9" Foreground="#596B7E" /><TextBlock Text="{Binding SelectedEngineDetails.TypeLabel}" FontSize="13" Margin="0,4,0,0" /></StackPanel>
                      <StackPanel Grid.Column="1"><TextBlock Text="BRANCHE" FontSize="9" Foreground="#596B7E" /><TextBlock Text="{Binding SelectedEngineDetails.BranchLabel}" FontSize="13" Margin="0,4,0,0" /></StackPanel>
                      <StackPanel Grid.Row="1"><TextBlock Text="ASSOCIATION" FontSize="9" Foreground="#596B7E" /><TextBlock Text="{Binding SelectedEngineDetails.RegistrationLabel}" FontSize="13" Margin="0,4,0,0" /></StackPanel>
                      <WrapPanel Grid.Row="1" Grid.Column="1">
                        <Button Classes="ghost" Content="Enregistrer" Command="{Binding SelectedEngineDetails.RegisterCommand}" IsVisible="{Binding SelectedEngineDetails.CanRegister}" />
                        <Button Classes="danger" Content="Désenregistrer" Command="{Binding SelectedEngineDetails.RequestUnregisterCommand}" IsVisible="{Binding SelectedEngineDetails.IsRegistered}" />
                      </WrapPanel>
                    </Grid>
                  </StackPanel>
                </Border>
              </Grid>
              <Border Classes="card">
                <StackPanel Spacing="11">
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBlock Text="OPTIONS DE L’INSTALLATION" FontSize="10" FontWeight="Bold" Foreground="#65788D" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="ghost" Content="{Binding EngineInstallationEditLabel}" Command="{Binding ToggleEngineInstallationEditCommand}" IsVisible="{Binding SelectedEngineDetails.IsOfficialEpic}" />
                    <Button Grid.Column="2" Classes="accent" Content="Télécharger et installer" Command="{Binding UpdateSelectedEngineComponentsCommand}" IsVisible="{Binding IsEngineInstallationEditing}" />
                  </Grid>
                  <TextBlock Text="État détecté dans les fichiers réellement présents pour cette installation." FontSize="10" Foreground="#8294A8" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding EngineComponentUpdateStatus}" FontSize="10" Foreground="#A8C9F2" TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding SelectedEngineDetails.InstallationOptions}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:EngineInstallationOptionViewModel">
                        <Border Background="#0D141C" BorderBrush="#202C39" BorderThickness="1" CornerRadius="7" Padding="11" Margin="0,0,0,7">
                          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11">
                            <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanEditSelection}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1">
                              <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" />
                              <TextBlock Text="{Binding Description}" FontSize="9" Foreground="#8294A8" Margin="0,3,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="10" FontWeight="SemiBold" Foreground="#65CCA9" VerticalAlignment="Center" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel IsVisible="{Binding IsLocalEngineDetailsSelected}" Spacing="14">
              <Border Classes="card" Padding="22">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="22">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <TextBlock Text="{Binding SelectedLocalEngineDetails.Name}" FontSize="26" FontWeight="SemiBold" Foreground="#F3F7FB" />
                      <Border Background="#18283A" CornerRadius="5" Padding="8,4"><TextBlock Text="{Binding SelectedLocalEngineDetails.Family}" FontSize="10" FontWeight="Bold" Foreground="#70A8FA" /></Border>
                      <Border Background="#17251F" CornerRadius="5" Padding="8,4"><TextBlock Text="{Binding SelectedLocalEngineDetails.Version}" FontSize="10" FontWeight="Bold" Foreground="#65CCA9" /></Border>
                    </StackPanel>
                    <TextBlock Text="{Binding SelectedLocalEngineDetails.Path}" FontSize="11" Foreground="#718398" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SelectedLocalEngineDetails.Source}" FontSize="11" Foreground="#AAB7C5" Margin="0,12,0,0" TextWrapping="Wrap" />
                  </StackPanel>
                  <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button Classes="accent" Content="Lancer" Command="{Binding SelectedLocalEngineDetails.LaunchCommand}" Margin="0,0,8,0" />
                    <Button Classes="ghost" Content="Ouvrir le dossier" Command="{Binding SelectedLocalEngineDetails.OpenFolderCommand}" Margin="0,0,8,0" />
                    <Button Classes="ghost" Content="Retirer de CyEngineHub" Command="{Binding RequestRemoveSelectedEngineCommand}" Margin="0,0,8,0" />
                    <Button Classes="danger" Content="Désinstaller" Command="{Binding RequestUninstallSelectedEngineCommand}" />
                  </WrapPanel>
                </Grid>
              </Border>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                <Border Classes="card">
                  <StackPanel Spacing="10">
                    <TextBlock Text="GESTION DU MOTEUR" FontSize="10" FontWeight="Bold" Foreground="#65788D" />
                    <TextBlock Text="Les plugins et packages sont filtrés selon ce moteur. Les prérequis de build et SDK sont disponibles dans Toolchains." FontSize="11" Foreground="#8294A8" TextWrapping="Wrap" />
                    <WrapPanel>
                      <Button Classes="accent" Content="Installer des plugins" Command="{Binding ShowSelectedEnginePluginsCommand}" Margin="0,0,8,0" />
                      <Button Classes="ghost" Content="Vérifier les toolchains" Command="{Binding ShowSelectedEngineToolchainsCommand}" />
                    </WrapPanel>
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="card">
                  <StackPanel Spacing="12">
                    <TextBlock Text="ORGANISATION &amp; OPTIONS" FontSize="10" FontWeight="Bold" Foreground="#65788D" />
                    <TextBox Classes="path" Text="{Binding SelectedLocalEngineDetails.Organization.Alias}" PlaceholderText="Libellé personnalisé" />
                    <TextBox Classes="path" Text="{Binding SelectedLocalEngineDetails.Organization.FolderPath}" PlaceholderText="Dossier/Sous-dossier" />
                    <Button Classes="accent" Content="Enregistrer les options" Command="{Binding SelectedLocalEngineDetails.Organization.SaveCommand}" HorizontalAlignment="Left" />
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>
            <Border Classes="card" Padding="18">
              <StackPanel Spacing="11">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel>
                    <TextBlock Text="TOOLCHAINS &amp; COMPATIBILITÉ" FontSize="10" FontWeight="Bold" Foreground="#65788D" />
                    <TextBlock Text="SDK, compilateurs et versions réellement requis pour cette installation." FontSize="10" Foreground="#8294A8" Margin="0,4,0,0" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="accent" Content="Analyser maintenant" Command="{Binding RefreshToolchainsCommand}" />
                </Grid>
                <TextBlock IsVisible="{Binding HasNoSelectedEngineToolchains}" Text="Aucune analyse compatible en cache pour ce moteur. Lancez l’analyse pour obtenir les prérequis exacts." FontSize="10" Foreground="#D9A55C" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding SelectedEngineToolchains}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:EngineToolchainCardViewModel">
                      <Border Background="#0D141C" BorderBrush="#26384B" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                        <StackPanel Spacing="9">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="{Binding Version}" FontSize="10" Foreground="#70A8FA" VerticalAlignment="Center" /></StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Summary}" FontSize="10" Foreground="#D9A55C" />
                          </Grid>
                          <ItemsControl ItemsSource="{Binding Checks}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:ToolchainCheckItemViewModel">
                                <Grid ColumnDefinitions="1.1*,0.7*,1.25*,1.25*,2*" ColumnSpacing="10" Margin="0,3">
                                  <TextBlock Text="{Binding Label}" FontSize="9" FontWeight="SemiBold" />
                                  <TextBlock Grid.Column="1" Text="{Binding Health}" FontSize="9" Foreground="#D9A55C" />
                                  <TextBlock Grid.Column="2" Text="{Binding Required}" FontSize="9" Foreground="#8294A8" TextWrapping="Wrap" />
                                  <TextBlock Grid.Column="3" Text="{Binding Installed}" FontSize="9" Foreground="#AAB7C5" TextWrapping="Wrap" />
                                  <TextBlock Grid.Column="4" Text="{Binding Diagnostic}" FontSize="9" Foreground="#718398" TextWrapping="Wrap" />
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <Grid IsVisible="{Binding IsProjectsVisible}" RowDefinitions="0,Auto,Auto,Auto,*">
          <Border Classes="card" Margin="0,0,0,14" IsVisible="False">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
                <TextBox Classes="path" Text="{Binding ManualProjectRoot}" PlaceholderText="Dossier, .uproject, project.godot, ProjectVersion.txt ou .cryproject" />
                <Button Grid.Column="1" Classes="accent" Content="Ajouter manuellement" Command="{Binding AddProjectRootCommand}" />
                <Button Grid.Column="2" Classes="ghost" Content="Restaurer les projets retirés" Command="{Binding RestoreHiddenProjectsCommand}" />
                <Button Grid.Column="3" Classes="accent" Content="Nouveau projet" Command="{Binding ToggleProjectCreatorCommand}" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel>
                  <TextBlock Text="DÉTECTION DES PROJETS" FontSize="9" FontWeight="Bold" Foreground="#65788D" />
                  <TextBlock Text="L’ajout manuel reste disponible même si l’analyse automatique est désactivée. Retirer un projet ne supprime aucun fichier." FontSize="9" Foreground="#718398" Margin="0,3,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Classes="ghost" Content="{Binding AutoDiscoverProjectsLabel}" Command="{Binding ToggleAutoDiscoverProjectsCommand}" VerticalAlignment="Center" />
              </Grid>
              <ItemsControl ItemsSource="{Binding HubProjectToolbarContributions}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:HubUiContributionButtonViewModel">
                    <Button Classes="accent" Content="{Binding Label}" Command="{Binding InvokeCommand}" ToolTip.Tip="{Binding ToolTip}" Margin="0,0,7,0" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border IsVisible="False" Background="#0D141C" BorderBrush="#2A4057" BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel Spacing="9">
                  <Grid ColumnDefinitions="1.2*,1*,1.5*" ColumnSpacing="9">
                    <ComboBox ItemsSource="{Binding ProjectCreationPresets}" SelectedItem="{Binding SelectedProjectCreationPreset}" PlaceholderText="Preset">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProjectCreationPresetOptionViewModel">
                          <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Description}" FontSize="9" Foreground="#718398" TextWrapping="Wrap" /></StackPanel>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBox Grid.Column="1" Classes="path" Text="{Binding NewProjectName}" PlaceholderText="NomDuProjet" />
                    <TextBox Grid.Column="2" Classes="path" Text="{Binding NewProjectParentDirectory}" PlaceholderText="Dossier parent existant" />
                  </Grid>
                  <Grid ColumnDefinitions="1*,2*,Auto" ColumnSpacing="9">
                    <TextBox Classes="path" Text="{Binding NewProjectEngineAssociation}" PlaceholderText="Version/association (ex. 5.5, 6000.0.0f1)" />
                    <TextBox Grid.Column="1" Classes="path" Text="{Binding NewProjectPlugins}" PlaceholderText="Plugins Unreal séparés par virgules (EnhancedInput, GameplayAbilities…)" />
                    <Button Grid.Column="2" Classes="accent" Content="Créer et ajouter" Command="{Binding CreateProjectCommand}" />
                  </Grid>
                  <TextBlock Text="Le preset UE5 ‘profil UE4’ crée un projet C++ et désactive par défaut Lumen, Nanite et Virtual Shadow Maps. Aucun dossier existant n’est écrasé." FontSize="9" Foreground="#D9A55C" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
          <Border Grid.Row="1" Classes="card" Margin="0,0,0,10" Padding="10">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <ListBox Classes="engine-tabs" ItemsSource="{Binding EngineTabs}" SelectedItem="{Binding SelectedProjectTab}" SelectionMode="Single">
                <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:EngineFamilyOptionViewModel"><TextBlock Text="{Binding Label}" FontWeight="SemiBold" /></DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Button Grid.Column="1" Classes="ghost view-mode" Classes.active="{Binding IsProjectCardView}" Content="Cartes" Command="{Binding ShowProjectCardsCommand}" />
              <Button Grid.Column="2" Classes="ghost view-mode" Classes.active="{Binding IsProjectListView}" Content="Liste" Command="{Binding ShowProjectListCommand}" />
            </Grid>
          </Border>
          <Border Grid.Row="2" Classes="card" Margin="0,0,0,10" Padding="10">
            <StackPanel Spacing="9">
              <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                <Button Classes="accent" Content="Nouveau projet" Command="{Binding ToggleProjectCreatorCommand}" />
                <Button Grid.Column="1" Classes="ghost" Content="Profils de création" Command="{Binding ShowProjectProfilesCommand}" />
                <Button Grid.Column="3" Classes="ghost" Content="Importer des projets…" Command="{Binding ToggleManualProjectAddCommand}" />
              </Grid>
              <Border IsVisible="False" Background="#0D141C" BorderBrush="#2A4057" BorderThickness="1" CornerRadius="8" Padding="14">
                <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto">
                  <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                      <StackPanel>
                        <TextBlock Text="CRÉER UN PROJET" FontSize="16" FontWeight="Bold" />
                        <TextBlock Text="Le projet est construit par étapes : moteur, profil, collections, puis scripts post-création." FontSize="10" Foreground="#8294A8" Margin="0,3,0,0" />
                      </StackPanel>
                      <Button Grid.Column="1" Classes="ghost" Content="Fermer" Command="{Binding ToggleProjectCreatorCommand}" />
                    </Grid>

                    <StackPanel Spacing="7">
                      <TextBlock Text="1 · PROJET ET MOTEUR" FontSize="10" FontWeight="Bold" Foreground="#70A8FA" />
                      <Grid ColumnDefinitions="1.05*,1.2*,1.2*" ColumnSpacing="9">
                        <ComboBox ItemsSource="{Binding ProjectCreationPresets}" SelectedItem="{Binding SelectedProjectCreationPreset}" PlaceholderText="Type de projet">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProjectCreationPresetOptionViewModel">
                              <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Description}" FontSize="9" Foreground="#718398" TextWrapping="Wrap" /></StackPanel>
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox Grid.Column="1" IsVisible="{Binding IsUnrealProjectCreation}" ItemsSource="{Binding ProjectCreationEngines}" SelectedItem="{Binding SelectedProjectCreationEngine}" PlaceholderText="Version Unreal installée">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProjectCreationEngineOptionViewModel">
                              <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Version}" FontSize="9" Foreground="#70A8FA" /><TextBlock Text="{Binding Path}" FontSize="8" Foreground="#65788D" TextTrimming="CharacterEllipsis" /></StackPanel>
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox Grid.Column="2" IsVisible="{Binding IsUnrealProjectCreation}" ItemsSource="{Binding ProjectCreationConfigurations}" SelectedItem="{Binding SelectedProjectCreationConfiguration}" PlaceholderText="Configuration">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProjectCreationConfigurationOptionViewModel">
                              <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                  <TextBlock Text="{Binding Origin}" FontSize="8" Foreground="#65CFA1" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding Description}" FontSize="9" Foreground="#718398" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Inventory}" FontSize="8" Foreground="#5F9BD3" />
                              </StackPanel>
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </Grid>
                      <Grid IsVisible="{Binding IsUnrealProjectCreation}" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding ProjectCreationPluginCompatibilitySummary}" FontSize="9" Foreground="#8FB9F4" TextWrapping="Wrap" />
                          <TextBlock Text="Un profil intégré s’ouvre comme une copie ; vos profils personnalisés restent modifiables." FontSize="8" Foreground="#65788D" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="ghost" Content="Nouveau profil" Command="{Binding NewProjectProfileCommand}" />
                        <Button Grid.Column="2" Classes="ghost" Content="Modifier / Dupliquer" Command="{Binding EditProjectProfileCommand}" />
                      </Grid>
                      <Grid ColumnDefinitions="1*,1.55*,0.75*" ColumnSpacing="9">
                        <TextBox Classes="path" Text="{Binding NewProjectName}" PlaceholderText="Nom technique du projet" />
                        <TextBox Grid.Column="1" Classes="path" Text="{Binding NewProjectParentDirectory}" PlaceholderText="Dossier parent existant" />
                        <TextBox Grid.Column="2" Classes="path" Text="{Binding NewProjectEngineAssociation}" PlaceholderText="Association moteur" />
                      </Grid>
                    </StackPanel>

                    <StackPanel Spacing="7" IsVisible="{Binding IsUnrealProjectCreation}">
                      <TextBlock Text="2 · PLUGINS UNREAL" FontSize="10" FontWeight="Bold" Foreground="#70A8FA" />
                      <Grid ColumnDefinitions="*,*" ColumnSpacing="9">
                        <StackPanel Spacing="4">
                          <TextBlock Text="ACTIVER" FontSize="9" FontWeight="Bold" Foreground="#65CFA1" />
                          <TextBox Classes="path" Text="{Binding NewProjectPlugins}" PlaceholderText="EnhancedInput, OpenXR…" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                          <TextBlock Text="DÉSACTIVER EXPLICITEMENT" FontSize="9" FontWeight="Bold" Foreground="#D9A55C" />
                          <TextBox Classes="path" Text="{Binding NewProjectDisabledPlugins}" PlaceholderText="Plugins de base à désactiver…" />
                        </StackPanel>
                      </Grid>
                      <TextBlock Text="Le profil remplit ces listes, mais elles restent modifiables avant création." FontSize="9" Foreground="#718398" />
                    </StackPanel>

                    <StackPanel Spacing="7">
                      <TextBlock Text="3 · COLLECTIONS ET PACKAGES INITIAUX" FontSize="10" FontWeight="Bold" Foreground="#70A8FA" />
                      <TextBlock IsVisible="{Binding !HasProjectCreationCollections}" Text="Aucune collection personnelle n’est encore définie dans la Bibliothèque." FontSize="10" Foreground="#718398" />
                      <ItemsControl ItemsSource="{Binding ProjectCreationCollections}" IsVisible="{Binding HasProjectCreationCollections}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ProjectCreationCollectionOptionViewModel">
                            <Border Background="#111C27" BorderBrush="#26384B" BorderThickness="1" CornerRadius="7" Padding="10" Width="245" Margin="0,0,8,8">
                              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Top" />
                                <StackPanel Grid.Column="1">
                                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                  <TextBlock Text="{Binding Summary}" FontSize="9" Foreground="#718398" TextWrapping="Wrap" />
                                </StackPanel>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Text="Les assets Fab et Megascans sélectionnés seront téléchargés puis installés en arrière-plan après la création du projet." FontSize="9" Foreground="#8294A8" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <StackPanel>
                          <TextBlock Text="4 · SCRIPTS POST-CRÉATION" FontSize="10" FontWeight="Bold" Foreground="#70A8FA" />
                          <TextBlock Text="Actions exécutées après la structure de base et avant la publication du projet." FontSize="9" Foreground="#718398" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="ghost" Content="Actualiser les scripts" Command="{Binding RefreshProjectCreationScriptsCommand}" />
                        <Button Grid.Column="2" Classes="ghost" Content="Dossier des scripts" Command="{Binding OpenProjectCreationScriptsFolderCommand}" />
                      </Grid>
                      <ItemsControl ItemsSource="{Binding ProjectPostCreationScripts}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ProjectPostCreationScriptOptionViewModel">
                            <Border Background="#111C27" BorderBrush="#26384B" BorderThickness="1" CornerRadius="7" Padding="11" Margin="0,0,0,8">
                              <StackPanel Spacing="9">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                  <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Top" />
                                  <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}" FontSize="9" Foreground="#8294A8" TextWrapping="Wrap" />
                                  </StackPanel>
                                  <TextBlock Grid.Column="2" Text="{Binding Origin}" FontSize="8" Foreground="#65CFA1" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Options}" IsVisible="{Binding IsSelected}">
                                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ProjectPostCreationOptionValueViewModel">
                                      <StackPanel Width="245" Margin="0,0,9,7" Spacing="3">
                                        <TextBlock Text="{Binding Name}" FontSize="9" FontWeight="Bold" Foreground="#8FB9F4" />
                                        <TextBox IsVisible="{Binding IsText}" Classes="path" Text="{Binding Value}" />
                                        <ComboBox IsVisible="{Binding IsChoice}" ItemsSource="{Binding Choices}" SelectedItem="{Binding Value}" />
                                        <CheckBox IsVisible="{Binding IsBoolean}" IsChecked="{Binding BooleanValue}" Content="{Binding Description}" />
                                        <TextBlock IsVisible="{Binding !IsBoolean}" Text="{Binding Description}" FontSize="8" Foreground="#65788D" TextWrapping="Wrap" />
                                      </StackPanel>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                      <TextBlock Text="Aucun dossier existant n’est écrasé. En cas d’échec d’un script, le projet incomplet est supprimé." FontSize="9" Foreground="#D9A55C" VerticalAlignment="Center" TextWrapping="Wrap" />
                      <Button Grid.Column="1" Classes="accent" Content="Créer le projet" Command="{Binding CreateProjectCommand}" Padding="20,10" />
                    </Grid>
                  </StackPanel>
                </ScrollViewer>
              </Border>
            </StackPanel>
          </Border>
          <Border Grid.Row="3" Classes="card" Margin="0,0,0,10" Padding="10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <TextBox Classes="path" Text="{Binding ProjectSearchQuery}" PlaceholderText="Rechercher un projet par nom ou chemin…" />
              <TextBlock Grid.Column="1" Text="{Binding VisibleProjectCount, StringFormat='{}{0} résultat(s)'}" FontSize="10" Foreground="#718398" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <Grid Grid.Row="4">
            <ScrollViewer IsVisible="{Binding IsUnrealProjectCardViewVisible}" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding VisibleProjects}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProjectCardViewModel">
                    <Border Classes="card" Width="300" Height="286" Margin="0,0,12,12" Padding="12" PointerReleased="OpenDetailsFromItem" Cursor="Hand">
                      <Grid RowDefinitions="116,Auto,*,Auto">
                        <Border Background="#0B121A" CornerRadius="7" ClipToBounds="True">
                          <Grid>
                            <TextBlock Text="UE" FontSize="28" FontWeight="Bold" Foreground="#29415A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" IsVisible="{Binding HasThumbnail}" />
                          </Grid>
                        </Border>
                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                          <TextBlock Text="{Binding Organization.DisplayName}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <Border Grid.Column="1" Background="#18283A" CornerRadius="5" Padding="7,3"><TextBlock Text="{Binding EngineLabel}" FontSize="9" FontWeight="Bold" Foreground="#70A8FA" /></Border>
                        </Grid>
                        <StackPanel Grid.Row="2" Margin="0,7,0,0">
                          <TextBlock Text="{Binding Path}" FontSize="9" Foreground="#718398" TextTrimming="CharacterEllipsis" />
                          <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,7,0,0">
                            <TextBlock Text="{Binding ModuleCount, StringFormat='{}{0} module(s)'}" FontSize="9" Foreground="#AAB7C5" />
                            <TextBlock Text="{Binding PluginCount, StringFormat='{}{0} plugin(s)'}" FontSize="9" Foreground="#AAB7C5" />
                          </StackPanel>
                        </StackPanel>
                        <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="7">
                          <Button Classes="accent" Content="Ouvrir" Command="{Binding LaunchCommand}" />
                          <Button Grid.Column="1" Classes="ghost" Content="Dossier" Command="{Binding OpenFolderCommand}" />
                          <Button Grid.Column="2" Classes="danger" Content="Retirer" Command="{Binding Organization.HideCommand}" />
                        </Grid>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <ScrollViewer IsVisible="{Binding IsLocalProjectCardViewVisible}" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding VisibleLocalEngineProjects}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LocalEngineProjectCardViewModel">
                    <Border Classes="card" Width="300" Height="246" Margin="0,0,12,12" PointerReleased="OpenDetailsFromItem" Cursor="Hand">
                      <Grid RowDefinitions="Auto,Auto,*,Auto">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{Binding Organization.DisplayName}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <Border Grid.Column="1" Background="#18283A" CornerRadius="5" Padding="7,3"><TextBlock Text="{Binding Family}" FontSize="9" FontWeight="Bold" Foreground="#70A8FA" /></Border>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding Version}" FontSize="10" Foreground="#D9A55C" Margin="0,8,0,0" />
                        <StackPanel Grid.Row="2" Margin="0,12,0,0">
                          <TextBlock Text="{Binding Description}" FontSize="10" Foreground="#AAB7C5" TextWrapping="Wrap" MaxHeight="58" />
                          <TextBlock Text="{Binding Path}" FontSize="9" Foreground="#718398" TextTrimming="CharacterEllipsis" Margin="0,8,0,0" />
                          <TextBlock Text="{Binding Organization.FolderLabel}" FontSize="9" Foreground="#D9A55C" Margin="0,8,0,0" />
                        </StackPanel>
                        <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="7">
                          <Button Classes="accent" Content="Ouvrir" Command="{Binding LaunchCommand}" />
                          <Button Grid.Column="1" Classes="ghost" Content="Dossier" Command="{Binding OpenFolderCommand}" />
                          <Button Grid.Column="2" Classes="danger" Content="Retirer" Command="{Binding Organization.HideCommand}" />
                        </Grid>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <ListBox Classes="catalog" ItemsSource="{Binding VisibleProjects}" IsVisible="{Binding IsUnrealProjectListViewVisible}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ProjectCardViewModel">
                  <Border Classes="card" PointerReleased="OpenDetailsFromItem" Cursor="Hand">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                      <Border Width="128" Height="78" Background="#0B121A" CornerRadius="7" ClipToBounds="True" VerticalAlignment="Top">
                        <Grid>
                          <TextBlock Text="UE" FontSize="22" FontWeight="Bold" Foreground="#29415A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" IsVisible="{Binding HasThumbnail}" />
                        </Grid>
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="7">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                          <TextBlock Text="{Binding Organization.DisplayName}" FontSize="17" FontWeight="SemiBold" Foreground="#F0F5FA" />
                          <Border Background="#18283A" CornerRadius="5" Padding="7,3"><TextBlock Text="{Binding EngineLabel}" FontSize="10" FontWeight="Bold" Foreground="#70A8FA" /></Border>
                          <Border Background="#17251F" CornerRadius="5" Padding="7,3"><TextBlock Text="{Binding HealthLabel}" FontSize="10" FontWeight="Bold" Foreground="#65CCA9" /></Border>
                          <TextBlock Text="{Binding Organization.FolderLabel}" FontSize="9" Foreground="#D9A55C" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding Path}" FontSize="10" Foreground="#718398" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="20">
                          <TextBlock Text="{Binding ModuleCount, StringFormat='{}{0} module(s)'}" FontSize="10" Foreground="#AAB7C5" />
                          <TextBlock Text="{Binding PluginCount, StringFormat='{}{0} plugin(s) actif(s)'}" FontSize="10" Foreground="#AAB7C5" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                          <TextBox Classes="path" Text="{Binding Organization.Alias}" PlaceholderText="Libellé personnalisé" />
                          <TextBox Grid.Column="1" Classes="path" Text="{Binding Organization.FolderPath}" PlaceholderText="Dossier/Sous-dossier" />
                          <Button Grid.Column="2" Classes="ghost" Content="Ranger" Command="{Binding Organization.SaveCommand}" />
                        </Grid>
                      </StackPanel>
                      <WrapPanel Grid.Column="2" VerticalAlignment="Center" Width="390">
                        <Button Classes="accent" Content="Ouvrir" Command="{Binding LaunchCommand}" />
                        <Button Classes="ghost" Content="Build" Command="{Binding BuildEditorCommand}" Margin="8,0,0,0" />
                        <Button Classes="ghost" Content="Package" Command="{Binding PackageCommand}" Margin="8,0,0,0" />
                        <Button Classes="ghost" Content="GPF" Command="{Binding GenerateProjectFilesCommand}" Margin="8,0,0,0" />
                        <Button Classes="ghost" Content="Dossier" Command="{Binding OpenFolderCommand}" Margin="8,0,0,0" />
                        <Button Classes="danger" Content="Retirer de l’app" Command="{Binding Organization.HideCommand}" Margin="8,8,0,0" />
                      </WrapPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <ListBox Classes="catalog" ItemsSource="{Binding VisibleLocalEngineProjects}" IsVisible="{Binding IsLocalProjectListViewVisible}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:LocalEngineProjectCardViewModel">
                  <Border Classes="card" PointerReleased="OpenDetailsFromItem" Cursor="Hand">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                      <StackPanel Spacing="7">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                          <TextBlock Text="{Binding Organization.DisplayName}" FontSize="17" FontWeight="SemiBold" />
                          <Border Background="#18283A" CornerRadius="5" Padding="7,3"><TextBlock Text="{Binding Family}" FontSize="9" FontWeight="Bold" Foreground="#70A8FA" /></Border>
                          <TextBlock Text="{Binding Version}" FontSize="10" Foreground="#D9A55C" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Organization.FolderLabel}" FontSize="9" Foreground="#D9A55C" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" FontSize="10" Foreground="#8294A8" />
                        <TextBlock Text="{Binding Path}" FontSize="10" Foreground="#718398" TextTrimming="CharacterEllipsis" />
                        <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                          <TextBox Classes="path" Text="{Binding Organization.Alias}" PlaceholderText="Libellé personnalisé" />
                          <TextBox Grid.Column="1" Classes="path" Text="{Binding Organization.FolderPath}" PlaceholderText="Dossier/Sous-dossier" />
                          <Button Grid.Column="2" Classes="ghost" Content="Ranger" Command="{Binding Organization.SaveCommand}" />
                        </Grid>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <Button Classes="accent" Content="Ouvrir" Command="{Binding LaunchCommand}" />
                        <Button Classes="ghost" Content="Dossier" Command="{Binding OpenFolderCommand}" />
                        <Button Classes="danger" Content="Retirer de l’app" Command="{Binding Organization.HideCommand}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
          <Grid Grid.RowSpan="5" IsVisible="{Binding IsManualProjectAddVisible}" Panel.ZIndex="200">
            <Border Background="#B0060B10" />
            <Border Width="760" MaxHeight="590" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#101922" BorderBrush="#38536D" BorderThickness="1" CornerRadius="12" Padding="20">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="Importer des projets" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock Text="Ajoutez un dossier à analyser. CyEngineHub compare les descripteurs détectés avec les projets déjà présents avant l’ajout." FontSize="10" Foreground="#8294A8" Margin="0,5,0,0" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="history" Content="✕" Command="{Binding ToggleManualProjectAddCommand}" ToolTip.Tip="Fermer" />
                </Grid>
                <TextBlock Text="DOSSIER OU DESCRIPTEUR À ANALYSER" FontSize="9" FontWeight="Bold" Foreground="#65788D" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox Classes="path" Text="{Binding ManualProjectRoot}" PlaceholderText="Dossier, .uproject, project.godot, ProjectVersion.txt ou .cryproject" />
                  <Button Grid.Column="1" Classes="accent" Content="Scanner et comparer" Command="{Binding ScanProjectImportCandidatesCommand}" />
                </Grid>
                <Border Background="#0B121A" CornerRadius="8" Padding="13">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel>
                      <TextBlock Text="COMPARAISON DU CATALOGUE" FontSize="9" FontWeight="Bold" Foreground="#65788D" />
                      <TextBlock Text="{Binding ProjectCount, StringFormat='{}{0} projet(s) actuellement catalogué(s)'}" FontSize="12" Margin="0,5,0,0" />
                      <TextBlock Text="Les doublons sont identifiés par leur descripteur et leur chemin canonique. Aucun fichier de projet n’est modifié." FontSize="10" Foreground="#8294A8" Margin="0,5,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="ghost" Content="Relancer l’analyse" Command="{Binding RefreshCommand}" VerticalAlignment="Center" />
                  </Grid>
                </Border>
                <ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding ProjectImportCandidates}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ProjectImportCandidateViewModel">
                        <Border Background="#0B121A" BorderBrush="#26384B" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,7">
                          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding !IsAlreadyCatalogued}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1">
                              <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="{Binding Engine}" FontSize="9" Foreground="#70A8FA" VerticalAlignment="Center" /></StackPanel>
                              <TextBlock Text="{Binding MarkerPath}" FontSize="9" Foreground="#718398" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="9" Foreground="#D9A55C" VerticalAlignment="Center" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Cochez uniquement les nouveaux projets à intégrer. Aucun fichier de projet n’est modifié." FontSize="10" Foreground="#8294A8" TextWrapping="Wrap" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="accent" Content="Ajouter la sélection" Command="{Binding ConfirmProjectImportCandidatesCommand}" />
                </Grid>
              </StackPanel>
            </Border>
          </Grid>
        </Grid>

        <ScrollViewer IsVisible="{Binding IsProjectDetailsVisible}" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
              <Button Classes="ghost" Content="← Retour aux projets" Command="{Binding BackFromProjectDetailsCommand}" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="PROFIL DU PROJET" FontSize="10" FontWeight="Bold" Foreground="#65788D" />
                <TextBlock Text="Moteur, plugins, build, packaging et organisation" FontSize="11" Foreground="#8294A8" Margin="0,4,0,0" />
              </StackPanel>
              <WrapPanel Grid.Column="2" VerticalAlignment="Center">
                <Button Classes="ghost" Content="Plugins &amp; packages" Command="{Binding ShowSelectedProjectPluginsCommand}" Margin="0,0,8,0" />
                <Button Classes="ghost" Content="Build &amp; Packaging" Command="{Binding ShowSelectedProjectBuildsCommand}" />
              </WrapPanel>
            </Grid>

            <StackPanel IsVisible="{Binding IsUnrealProjectDetailsSelected}" Spacing="14">
              <Border Classes="card" Padding="20">
                <Grid ColumnDefinitions="180,*,Auto" ColumnSpacing="20">
                  <Border Width="180" Height="110" Background="#0B121A" CornerRadius="8" ClipToBounds="True">
                    <Grid>
                      <TextBlock Text="UE" FontSize="28" FontWeight="Bold" Foreground="#29415A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <Image Source="{Binding SelectedProjectDetails.Thumbnail}" Stretch="UniformToFill" IsVisible="{Binding SelectedProjectDetails.HasThumbnail}" />
                    </Grid>
                  </Border>
                  <StackPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <TextBlock Text="{Binding SelectedProjectDetails.Name}" FontSize="25" FontWeight="SemiBold" Foreground="#F3F7FB" />
                      <Border Background="#18283A" CornerRadius="5" Padding="8,4"><TextBlock Text="{Binding SelectedProjectDetails.EngineLabel}" FontSize="10" FontWeight="Bold" Foreground="#70A8FA" /></Border>
                      <Border Background="#17251F" CornerRadius="5" Padding="8,4"><TextBlock Text="{Binding SelectedProjectDetails.HealthLabel}" FontSize="10" FontWeight="Bold" Foreground="#65CCA9" /></Border>
                    </StackPanel>
                    <TextBlock Text="{Binding SelectedProjectDetails.Path}" FontSize="10" Foreground="#718398" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="18" Margin="0,12,0,0">
                      <TextBlock Text="{Binding SelectedProjectDetails.ModuleCount, StringFormat='{}{0} module(s)'}" FontSize="10" Foreground="#AAB7C5" />
                      <TextBlock Text="{Binding SelectedProjectDetails.PluginCount, StringFormat='{}{0} plugin(s) actif(s)'}" FontSize="10" Foreground="#AAB7C5" />
                    </StackPanel>
                  </StackPanel>
                  <WrapPanel Grid.Column="2" VerticalAlignment="Center" MaxWidth="430">
                    <Button Classes="accent" Content="Ouvrir le projet" Command="{Binding SelectedProjectDetails.LaunchCommand}" Margin="0,0,8,8" />
                    <Button Classes="ghost" Content="Build" Command="{Binding SelectedProjectDetails.BuildEditorCommand}" Margin="0,0,8,8" />
                    <Button Classes="ghost" Content="Package" Command="{Binding SelectedProjectDetails.PackageCommand}" Margin="0,0,8,8" />
                    <Button Classes="ghost" Content="GPF" Command="{Binding SelectedProjectDetails.GenerateProjectFilesCommand}" Margin="0,0,8,8" />
                    <Button Classes="ghost" Content="Dossier" Command="{Binding SelectedProjectDetails.OpenFolderCommand}" Margin="0,0,0,8" />
                  </WrapPanel>
                </Grid>
              </Border>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                <Border Classes="card">
                  <StackPanel Spacing="11">
                    <TextBlock Text="PLUGINS &amp; CONFIGURATION" FontSize="10" FontWeight="Bold" Foreground="#65788D" />
                    <TextBlock Text="Gérez les plugins déclarés, leurs versions compatibles et les installations propres au projet." FontSize="11" Foreground="#8294A8" TextWrapping="Wrap" />
                    <Button Classes="accent" Content="Gérer les plugins du projet" Command="{Binding ShowSelectedProjectPluginsCommand}" HorizontalAlignment="Left" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="card">
                  <StackPanel Spacing="11">
                    <TextBlock Text="ORGANISATION &amp; OPTIONS" FontSize="10" FontWeight="Bold" Foreground="#65788D" />
                    <TextBox Classes="path" Text="{Binding SelectedProjectDetails.Organization.Alias}" PlaceholderText="Libellé personnalisé" />
                    <TextBox Classes="path" Text="{Binding SelectedProjectDetails.Organization.FolderPath}" PlaceholderText="Dossier/Sous-dossier" />
                    <WrapPanel>
                      <Button Classes="accent" Content="Enregistrer" Command="{Binding SelectedProjectDetails.Organization.SaveCommand}" Margin="0,0,8,0" />
                      <Button Classes="danger" Content="Retirer de l’app" Command="{Binding SelectedProjectDetails.Organization.HideCommand}" />
                    </WrapPanel>
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>

            <StackPanel IsVisible="{Binding IsLocalProjectDetailsSelected}" Spacing="14">
              <Border Classes="card" Padding="20">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <TextBlock Text="{Binding SelectedLocalProjectDetails.Name}" FontSize="25" FontWeight="SemiBold" Foreground="#F3F7FB" />
                      <Border Background="#18283A" CornerRadius="5" Padding="8,4"><TextBlock Text="{Binding SelectedLocalProjectDetails.Family}" FontSize="10" FontWeight="Bold" Foreground="#70A8FA" /></Border>
                      <Border Background="#17251F" CornerRadius="5" Padding="8,4"><TextBlock Text="{Binding SelectedLocalProjectDetails.Version}" FontSize="10" FontWeight="Bold" Foreground="#65CCA9" /></Border>
                    </StackPanel>
                    <TextBlock Text="{Binding SelectedLocalProjectDetails.Description}" FontSize="11" Foreground="#AAB7C5" Margin="0,10,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SelectedLocalProjectDetails.Path}" FontSize="10" Foreground="#718398" Margin="0,8,0,0" TextWrapping="Wrap" />
                  </StackPanel>
                  <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button Classes="accent" Content="Ouvrir le projet" Command="{Binding SelectedLocalProjectDetails.LaunchCommand}" Margin="0,0,8,0" />
                    <Button Classes="ghost" Content="Dossier" Command="{Binding SelectedLocalProjectDetails.OpenFolderCommand}" />
                  </WrapPanel>
                </Grid>
              </Border>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                <Border Classes="card"><StackPanel Spacing="11"><TextBlock Text="PACKAGES &amp; OUTILS" FontSize="10" FontWeight="Bold" Foreground="#65788D" /><TextBlock Text="Ouvrez la gestion des packages du moteur associé à ce projet." FontSize="11" Foreground="#8294A8" TextWrapping="Wrap" /><Button Classes="accent" Content="Gérer les packages" Command="{Binding ShowSelectedProjectPluginsCommand}" HorizontalAlignment="Left" /></StackPanel></Border>
                <Border Grid.Column="1" Classes="card"><StackPanel Spacing="11"><TextBlock Text="ORGANISATION &amp; OPTIONS" FontSize="10" FontWeight="Bold" Foreground="#65788D" /><TextBox Classes="path" Text="{Binding SelectedLocalProjectDetails.Organization.Alias}" PlaceholderText="Libellé personnalisé" /><TextBox Classes="path" Text="{Binding SelectedLocalProjectDetails.Organization.FolderPath}" PlaceholderText="Dossier/Sous-dossier" /><WrapPanel><Button Classes="accent" Content="Enregistrer" Command="{Binding SelectedLocalProjectDetails.Organization.SaveCommand}" Margin="0,0,8,0" /><Button Classes="danger" Content="Retirer de l’app" Command="{Binding SelectedLocalProjectDetails.Organization.HideCommand}" /></WrapPanel></StackPanel></Border>
              </Grid>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <Grid IsVisible="{Binding IsPluginsVisible}" RowDefinitions="Auto,Auto,Auto,*">
          <Border Classes="card" Margin="0,0,0,14">
            <StackPanel Spacing="11">
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                <TextBox
                    Classes="path"
                    Text="{Binding ManualPluginLibraryRoot}"
                    PlaceholderText="D:\BibliothèquePlugins ou chemin vers un .uplugin" />
                <Button Grid.Column="1" Classes="ghost" Content="Ajouter la bibliothèque" Command="{Binding AddPluginLibraryRootCommand}" />
                <Button Grid.Column="2" Classes="accent" Content="Analyser les plugins" Command="{Binding RefreshPluginsCommand}" />
              </Grid>
              <Grid ColumnDefinitions="*,430" ColumnSpacing="18">
                <StackPanel>
                  <TextBlock Text="CATALOGUE PLUGINS LOCAL" FontSize="10" FontWeight="Bold" Foreground="#65788D" />
                  <TextBlock Text="{Binding PluginStatusSummary}" FontSize="12" Foreground="#A4B3C2" Margin="0,5,0,0" TextWrapping="Wrap" />
                  <TextBlock Text="Analyse manuelle uniquement; le dernier catalogue est relu depuis SQLite au démarrage." FontSize="10" Foreground="#687B90" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="CIBLE D’INSTALLATION / BUILDPLUGIN" FontSize="10" FontWeight="Bold" Foreground="#65788D" />
                  <ComboBox
                      ItemsSource="{Binding PluginTargets}"
                      SelectedItem="{Binding SelectedPluginTarget}"
                      IsEnabled="{Binding HasPluginTargets}"
                      PlaceholderText="Aucun moteur compatible"
                      Margin="0,5,0,0">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:PluginInstallTargetViewModel">
                        <TextBlock Text="{Binding SelectionLabel}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
              </Grid>
              <ListBox Classes="engine-tabs" ItemsSource="{Binding EngineTabs}" SelectedItem="{Binding SelectedPluginTab}" SelectionMode="Single">
                <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:EngineFamilyOptionViewModel"><TextBlock Text="{Binding Label}" FontWeight="SemiBold" /></DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <ItemsControl ItemsSource="{Binding HubPluginToolbarContributions}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:HubUiContributionButtonViewModel">
                    <Button Classes="accent" Content="{Binding Label}" Command="{Binding InvokeCommand}" ToolTip.Tip="{Binding ToolTip}" Margin="0,0,7,0" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border
              Grid.Row="1"
              IsVisible="{Binding HasPendingPluginInstall}"
              Background="#2A2415"
              BorderBrush="#665426"
              BorderThickness="1"
              CornerRadius="8"
              Padding="13"
              Margin="0,0,0,14">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
              <StackPanel>
                <TextBlock Text="CONFIRMATION REQUISE" FontSize="10" FontWeight="Bold" Foreground="#F2B84B" />
                <TextBlock Text="{Binding PendingPluginInstallSummary}" FontSize="11" Foreground="#E2D2A6" TextWrapping="Wrap" Margin="0,5,0,0" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Classes="accent" Content="Confirmer l’installation" Command="{Binding ConfirmPluginInstallCommand}" />
                <Button Classes="ghost" Content="Annuler" Command="{Binding CancelPluginInstallCommand}" />
              </StackPanel>
            </Grid>
          </Border>

          <Border Grid.Row="2" Classes="card" Margin="0,0,0,14" IsVisible="{Binding IsLocalPackageTabSelected}">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel>
                  <TextBlock Text="PACKAGES &amp; ADDONS MULTI-MOTEURS" FontSize="10" FontWeight="Bold" Foreground="#65788D" />
                  <TextBlock Text="Inventaire natif pour Unity, Godot et CRYENGINE. Les packages projet sûrs peuvent être installés, retirés et restaurés après analyse et confirmation; CRYENGINE reste en lecture seule." FontSize="10" Foreground="#687B90" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="1" Background="#18283A" CornerRadius="5" Padding="8,4" VerticalAlignment="Center">
                  <TextBlock Text="{Binding LocalEnginePackages.Count, StringFormat='{}{0} DÉTECTÉ(S)'}" FontSize="9" FontWeight="Bold" Foreground="#70A8FA" />
                </Border>
              </Grid>
              <Grid ColumnDefinitions="*,330,Auto" ColumnSpacing="10">
                <TextBox
                    Classes="path"
                    Text="{Binding ManualLocalEnginePackageSource}"
                    PlaceholderText="Dossier package Unity ou addon Godot déjà extrait" />
                <ComboBox
                    Grid.Column="1"
                    ItemsSource="{Binding LocalPackageInstallProjects}"
                    SelectedItem="{Binding SelectedLocalPackageInstallProject}"
                    IsEnabled="{Binding HasLocalPackageInstallTargets}"
                    PlaceholderText="Projet Unity/Godot cible">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LocalEngineProjectCardViewModel">
                      <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Text="{Binding Family}" FontSize="9" FontWeight="Bold" Foreground="#70A8FA" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Name}" />
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="2" Classes="accent" Content="Analyser l’installation" Command="{Binding PrepareLocalEnginePackageInstallCommand}" />
              </Grid>
              <Border
                  IsVisible="{Binding HasPendingLocalEnginePackageInstall}"
                  Background="#2A2415"
                  BorderBrush="#665426"
                  BorderThickness="1"
                  CornerRadius="7"
                  Padding="11">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel>
                    <TextBlock Text="PACKAGE LOCAL · CONFIRMATION REQUISE" FontSize="9" FontWeight="Bold" Foreground="#F2B84B" />
                    <TextBlock Text="{Binding PendingLocalEnginePackageInstallSummary}" FontSize="10" Foreground="#E2D2A6" TextWrapping="Wrap" Margin="0,4,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <Button Classes="accent" Content="Installer" Command="{Binding ConfirmLocalEnginePackageInstallCommand}" />
                    <Button Classes="ghost" Content="Annuler" Command="{Binding CancelLocalEnginePackageInstallCommand}" />
                  </StackPanel>
                </Grid>
              </Border>
              <Border
                  IsVisible="{Binding HasPendingLocalEnginePackageRollback}"
                  Background="#321C20"
                  BorderBrush="#74404A"
                  BorderThickness="1"
                  CornerRadius="7"
                  Padding="11">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel>
                    <TextBlock Text="ROLLBACK PACKAGE · CONFIRMATION REQUISE" FontSize="9" FontWeight="Bold" Foreground="#E58B9A" />
                    <TextBlock Text="{Binding PendingLocalEnginePackageRollbackSummary}" FontSize="10" Foreground="#E2B8BF" TextWrapping="Wrap" Margin="0,4,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <Button Classes="danger" Content="Confirmer l’annulation" Command="{Binding ConfirmLocalEnginePackageRollbackCommand}" />
                    <Button Classes="ghost" Content="Conserver" Command="{Binding CancelLocalEnginePackageRollbackCommand}" />
                  </StackPanel>
                </Grid>
              </Border>
              <Border
                  IsVisible="{Binding HasPendingLocalEnginePackageRemoval}"
                  Background="#321C20"
                  BorderBrush="#74404A"
                  BorderThickness="1"
                  CornerRadius="7"
                  Padding="11">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel>
                    <TextBlock Text="RETRAIT PACKAGE · CONFIRMATION REQUISE" FontSize="9" FontWeight="Bold" Foreground="#E58B9A" />
                    <TextBlock Text="{Binding PendingLocalEnginePackageRemovalSummary}" FontSize="10" Foreground="#E2B8BF" TextWrapping="Wrap" Margin="0,4,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <Button Classes="danger" Content="Retirer du projet" Command="{Binding ConfirmLocalEnginePackageRemovalCommand}" />
                    <Button Classes="ghost" Content="Conserver" Command="{Binding CancelLocalEnginePackageRemovalCommand}" />
                  </StackPanel>
                </Grid>
              </Border>
              <Border
                  IsVisible="{Binding HasPendingLocalEnginePackageRestore}"
                  Background="#162A24"
                  BorderBrush="#2F6754"
                  BorderThickness="1"
                  CornerRadius="7"
                  Padding="11">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel>
                    <TextBlock Text="RESTAURATION PACKAGE · CONFIRMATION REQUISE" FontSize="9" FontWeight="Bold" Foreground="#65CCA9" />
                    <TextBlock Text="{Binding PendingLocalEnginePackageRestoreSummary}" FontSize="10" Foreground="#B7DDCF" TextWrapping="Wrap" Margin="0,4,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <Button Classes="accent" Content="Restaurer" Command="{Binding ConfirmLocalEnginePackageRestoreCommand}" />
                    <Button Classes="ghost" Content="Annuler" Command="{Binding CancelLocalEnginePackageRestoreCommand}" />
                  </StackPanel>
                </Grid>
              </Border>
              <TextBlock
                  IsVisible="{Binding HasNoLocalEnginePackages}"
                  Text="Aucun package multi-moteurs détecté. Actualisez d’abord les projets, puis relancez l’analyse des plugins."
                  Foreground="#718398"
                  HorizontalAlignment="Center"
                  Margin="0,10" />
              <ScrollViewer
                  IsVisible="{Binding HasLocalEnginePackages}"
                  MaxHeight="200"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding VisibleLocalEnginePackages}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:LocalEnginePackageCardViewModel">
                      <Border Background="#101923" BorderBrush="#243448" BorderThickness="1" CornerRadius="7" Padding="11" Margin="0,0,0,7">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                          <StackPanel Spacing="5">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <Border Background="#18283A" CornerRadius="4" Padding="6,3">
                                <TextBlock Text="{Binding Family}" FontSize="9" FontWeight="Bold" Foreground="#70A8FA" />
                              </Border>
                              <TextBlock Text="{Binding Organization.DisplayName}" FontSize="14" FontWeight="SemiBold" Foreground="#F0F5FA" />
                              <TextBlock Text="{Binding Version}" FontSize="10" Foreground="#91A5BA" VerticalAlignment="Center" />
                              <Border Background="#17251F" CornerRadius="4" Padding="6,3">
                                <TextBlock Text="{Binding Health}" FontSize="9" FontWeight="Bold" Foreground="#65CCA9" />
                              </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Description}" IsVisible="{Binding HasDescription}" FontSize="10" Foreground="#A7B5C4" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Path}" FontSize="9" Foreground="#64778B" TextTrimming="CharacterEllipsis" />
                            <Grid ColumnDefinitions="1.1*,1.2*,1.3*" ColumnSpacing="16">
                              <TextBlock Text="{Binding Project, StringFormat='Projet · {0}'}" FontSize="10" Foreground="#8496A9" />
                              <TextBlock Grid.Column="1" Text="{Binding Source}" FontSize="10" Foreground="#8496A9" />
                              <TextBlock Grid.Column="2" Text="{Binding State}" FontSize="10" Foreground="#8496A9" />
                            </Grid>
                            <TextBlock Text="{Binding DependencySummary}" FontSize="9" Foreground="#708398" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding IssueSummary}" IsVisible="{Binding HasIssues}" FontSize="9" Foreground="#D9A55C" TextWrapping="Wrap" />
                            <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                              <TextBox Classes="path" Text="{Binding Organization.Alias}" PlaceholderText="Libellé personnalisé" />
                              <TextBox Grid.Column="1" Classes="path" Text="{Binding Organization.FolderPath}" PlaceholderText="Dossier/Sous-dossier" />
                              <Button Grid.Column="2" Classes="ghost" Content="Ranger" Command="{Binding Organization.SaveCommand}" />
                            </Grid>
                          </StackPanel>
                          <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center">
                            <Button Classes="ghost" Content="Dossier" Command="{Binding OpenFolderCommand}" />
                            <Button Classes="danger" Content="Préparer le retrait" Command="{Binding PrepareRemovalCommand}" IsVisible="{Binding CanRemove}" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,3,0,0">
                <TextBlock Text="HISTORIQUE DES INSTALLATIONS CYENGINEHUB" FontSize="9" FontWeight="Bold" Foreground="#65788D" />
                <TextBlock Grid.Column="1" Text="{Binding LocalEnginePackageInstallHistory.Count, StringFormat='{}{0} REÇU(S)'}" FontSize="9" Foreground="#718398" />
              </Grid>
              <TextBlock
                  IsVisible="{Binding HasNoLocalEnginePackageInstallHistory}"
                  Text="Aucune installation Unity/Godot effectuée par CyEngineHub pour les projets détectés."
                  FontSize="9"
                  Foreground="#718398" />
              <ScrollViewer
                  IsVisible="{Binding HasLocalEnginePackageInstallHistory}"
                  MaxHeight="165"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding LocalEnginePackageInstallHistory}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:LocalEnginePackageInstallHistoryCardViewModel">
                      <Border Background="#111A24" BorderBrush="#243448" BorderThickness="1" CornerRadius="6" Padding="9" Margin="0,0,0,6">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                          <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                              <TextBlock Text="{Binding Family}" FontSize="9" FontWeight="Bold" Foreground="#70A8FA" />
                              <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="#EAF1F7" />
                              <TextBlock Text="{Binding Version}" FontSize="9" Foreground="#91A5BA" VerticalAlignment="Center" />
                              <TextBlock Text="{Binding Status}" FontSize="9" FontWeight="Bold" Foreground="#65CCA9" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding Project, StringFormat='Projet · {0}'}" FontSize="9" Foreground="#8496A9" />
                            <TextBlock Text="{Binding InstalledAt, StringFormat='Installé le {0}'}" FontSize="9" Foreground="#708398" />
                            <TextBlock Text="{Binding Detail}" FontSize="9" Foreground="#708398" />
                            <TextBlock Text="{Binding Recovery}" IsVisible="{Binding HasRecovery}" FontSize="9" Foreground="#D9A55C" TextWrapping="Wrap" />
                          </StackPanel>
                          <Button
                              Grid.Column="1"
                              Classes="ghost"
                              Content="Préparer l’annulation"
                              Command="{Binding PrepareRollbackCommand}"
                              IsVisible="{Binding CanRollback}"
                              VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,3,0,0">
                <TextBlock Text="HISTORIQUE DES RETRAITS RÉVERSIBLES" FontSize="9" FontWeight="Bold" Foreground="#65788D" />
                <TextBlock Grid.Column="1" Text="{Binding LocalEnginePackageRemovalHistory.Count, StringFormat='{}{0} REÇU(S)'}" FontSize="9" Foreground="#718398" />
              </Grid>
              <TextBlock
                  IsVisible="{Binding HasNoLocalEnginePackageRemovalHistory}"
                  Text="Aucun package Unity/Godot retiré par CyEngineHub pour les projets détectés."
                  FontSize="9"
                  Foreground="#718398" />
              <ScrollViewer
                  IsVisible="{Binding HasLocalEnginePackageRemovalHistory}"
                  MaxHeight="165"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding LocalEnginePackageRemovalHistory}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:LocalEnginePackageRemovalHistoryCardViewModel">
                      <Border Background="#111A24" BorderBrush="#243448" BorderThickness="1" CornerRadius="6" Padding="9" Margin="0,0,0,6">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                          <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                              <TextBlock Text="{Binding Family}" FontSize="9" FontWeight="Bold" Foreground="#70A8FA" />
                              <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="#EAF1F7" />
                              <TextBlock Text="{Binding Version}" FontSize="9" Foreground="#91A5BA" VerticalAlignment="Center" />
                              <TextBlock Text="{Binding Status}" FontSize="9" FontWeight="Bold" Foreground="#D9A55C" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding Project, StringFormat='Projet · {0}'}" FontSize="9" Foreground="#8496A9" />
                            <TextBlock Text="{Binding RemovedAt, StringFormat='Retiré le {0}'}" FontSize="9" Foreground="#708398" />
                            <TextBlock Text="{Binding Detail}" FontSize="9" Foreground="#708398" />
                            <TextBlock Text="{Binding Recovery}" FontSize="9" Foreground="#D9A55C" TextWrapping="Wrap" />
                          </StackPanel>
                          <Button
                              Grid.Column="1"
                              Classes="accent"
                              Content="Préparer la restauration"
                              Command="{Binding PrepareRestoreCommand}"
                              IsVisible="{Binding CanRestore}"
                              VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Border>

          <Grid Grid.Row="3" IsVisible="{Binding IsUnrealPluginTabSelected}">
            <TextBlock
                IsVisible="{Binding HasNoPlugins}"
                Text="Aucun plugin en cache. Ajoutez une bibliothèque ou lancez l’analyse manuelle."
                Foreground="#718398"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
            <ListBox Classes="catalog" ItemsSource="{Binding VisiblePlugins}" IsVisible="{Binding IsUnrealPluginTabSelected}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:PluginCardViewModel">
                  <Border Classes="card">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                      <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                          <TextBlock Text="{Binding Organization.DisplayName}" FontSize="17" FontWeight="SemiBold" Foreground="#F0F5FA" />
                          <Border Background="#18283A" CornerRadius="5" Padding="7,3">
                            <TextBlock Text="{Binding VersionLabel}" FontSize="10" FontWeight="Bold" Foreground="#70A8FA" />
                          </Border>
                          <Border Background="#17251F" CornerRadius="5" Padding="7,3">
                            <TextBlock Text="{Binding HealthLabel}" FontSize="10" FontWeight="Bold" Foreground="#65CCA9" />
                          </Border>
                          <Border Background="#2A2415" CornerRadius="5" Padding="7,3" IsVisible="{Binding HasSource}">
                            <TextBlock Text="SOURCE" FontSize="9" FontWeight="Bold" Foreground="#F2B84B" />
                          </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Path}" FontSize="10" Foreground="#708398" TextTrimming="CharacterEllipsis" />
                        <Grid ColumnDefinitions="1.2*,1.3*,1.4*,1.4*" ColumnSpacing="18">
                          <StackPanel>
                            <TextBlock Text="ORIGINE" FontSize="9" FontWeight="Bold" Foreground="#5F7287" />
                            <TextBlock Text="{Binding SourceLabel}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />
                          </StackPanel>
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="MOTEUR" FontSize="9" FontWeight="Bold" Foreground="#5F7287" />
                            <TextBlock Text="{Binding EngineVersionLabel}" FontSize="11" Margin="0,3,0,0" />
                          </StackPanel>
                          <StackPanel Grid.Column="2">
                            <TextBlock Text="MODULES" FontSize="9" FontWeight="Bold" Foreground="#5F7287" />
                            <TextBlock Text="{Binding ModuleSummary}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />
                          </StackPanel>
                          <StackPanel Grid.Column="3">
                            <TextBlock Text="PLATEFORMES" FontSize="9" FontWeight="Bold" Foreground="#5F7287" />
                            <TextBlock Text="{Binding PlatformSummary}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />
                          </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding DependencySummary}" FontSize="10" Foreground="#8496A9" />
                        <TextBlock Text="{Binding IssueSummary}" FontSize="10" Foreground="#D9A55C" TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                          <TextBox Classes="path" Text="{Binding Organization.Alias}" PlaceholderText="Libellé personnalisé" />
                          <TextBox Grid.Column="1" Classes="path" Text="{Binding Organization.FolderPath}" PlaceholderText="Dossier/Sous-dossier" />
                          <Button Grid.Column="2" Classes="ghost" Content="Ranger" Command="{Binding Organization.SaveCommand}" />
                        </Grid>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Width="190" Spacing="8" VerticalAlignment="Center">
                        <Button Classes="accent" Content="Préparer l’installation" Command="{Binding PrepareInstallCommand}" />
                        <Button Classes="ghost" Content="BuildPlugin Win64" Command="{Binding BuildPluginCommand}" IsVisible="{Binding HasSource}" />
                        <Button Classes="ghost" Content="Dossier" Command="{Binding OpenFolderCommand}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Grid>

        <Grid IsVisible="{Binding IsHubExtensionsVisible}" RowDefinitions="Auto,Auto,Auto,Auto,*">
          <Border Classes="card" Margin="0,0,0,14">
            <StackPanel Spacing="11">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel>
                  <TextBlock Text="EXTENSIONS CYENGINEHUB" FontSize="10" FontWeight="Bold" Foreground="#65788D" />
                  <TextBlock Text="{Binding HubExtensionStatus}" FontSize="12" Foreground="#A4B3C2" Margin="0,5,0,0" TextWrapping="Wrap" />
                  <TextBlock Text="Les .uplugin Unreal restent dans la page Plugins. Ici, chaque extension utilise un extension.json validé; aucun assembly tiers n’est chargé dans le hub." FontSize="10" Foreground="#687B90" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Classes="accent" Content="Actualiser" Command="{Binding RefreshHubExtensionsCommand}" VerticalAlignment="Center" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBox
                    Classes="path"
                    Text="{Binding ManualHubExtensionPackage}"
                    PlaceholderText="D:\MonExtensionCyEngineHub · dossier contenant extension.json" />
                <Button Grid.Column="1" Classes="ghost" Content="Préparer l’installation" Command="{Binding PrepareHubExtensionInstallCommand}" />
              </Grid>
            </StackPanel>
          </Border>

          <Border
              Grid.Row="1"
              IsVisible="{Binding HasPendingHubExtensionInstall}"
              Background="#2A2415"
              BorderBrush="#665426"
              BorderThickness="1"
              CornerRadius="8"
              Padding="13"
              Margin="0,0,0,14">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
              <StackPanel>
                <TextBlock Text="INSTALLATION À CONFIRMER" FontSize="10" FontWeight="Bold" Foreground="#F2B84B" />
                <TextBlock Text="{Binding PendingHubExtensionInstallSummary}" FontSize="11" Foreground="#E2D2A6" TextWrapping="Wrap" Margin="0,5,0,0" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Classes="accent" Content="Installer" Command="{Binding ConfirmHubExtensionInstallCommand}" />
                <Button Classes="ghost" Content="Annuler" Command="{Binding CancelHubExtensionInstallCommand}" />
              </StackPanel>
            </Grid>
          </Border>

          <Border Grid.Row="2" Classes="card" Margin="0,0,0,14">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel>
                  <TextBlock Text="OUTIL SÉLECTIONNÉ" FontSize="10" FontWeight="Bold" Foreground="#65788D" />
                  <TextBlock Text="{Binding SelectedHubExtension.Name}" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" />
                  <TextBlock Text="Asset Bridge inspecte la source avant confirmation. Il accepte uniquement les formats d’échange exportés; les .uasset, Blueprints, shaders et matériaux natifs ne sont pas convertis directement." FontSize="10" Foreground="#D9A55C" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                  <Button
                      Classes="accent"
                      Content="Ouvrir l’interface"
                      Command="{Binding OpenHubExtensionWindowCommand}"
                      IsVisible="{Binding CanOpenSelectedHubExtensionWindow}"
                      Margin="0,0,8,0" />
                  <Button
                      Classes="ghost"
                      Content="Page officielle"
                      Command="{Binding OpenHubExtensionWebsiteCommand}"
                      IsVisible="{Binding CanOpenSelectedHubExtensionWebsite}" />
                </WrapPanel>
              </Grid>
              <Grid ColumnDefinitions="150,150,*,*,Auto" ColumnSpacing="9">
                <ComboBox ItemsSource="{Binding HubExtensionEngineFamilies}" SelectedItem="{Binding HubExtensionSourceEngine}" PlaceholderText="Moteur source" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding HubExtensionEngineFamilies}" SelectedItem="{Binding HubExtensionTargetEngine}" PlaceholderText="Moteur cible" />
                <TextBox Grid.Column="2" Classes="path" Text="{Binding HubExtensionInputPath}" PlaceholderText="Fichier ou dossier source exporté" />
                <TextBox Grid.Column="3" Classes="path" Text="{Binding HubExtensionOutputPath}" PlaceholderText="Projet Unity, .uproject, project.godot ou staging reconnu" />
                <Button
                    Grid.Column="4"
                    Classes="accent"
                    Content="Préparer l’outil"
                    Command="{Binding PrepareHubExtensionExecutionCommand}"
                    IsVisible="{Binding CanRunSelectedHubExtension}" />
              </Grid>
            </StackPanel>
          </Border>

          <Border
              Grid.Row="3"
              IsVisible="{Binding HasPendingHubExtensionExecution}"
              Background="#14283A"
              BorderBrush="#285078"
              BorderThickness="1"
              CornerRadius="8"
              Padding="13"
              Margin="0,0,0,14">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
              <StackPanel>
                <TextBlock Text="EXÉCUTION FIRST-PARTY À CONFIRMER" FontSize="10" FontWeight="Bold" Foreground="#70A8FA" />
                <TextBlock Text="{Binding PendingHubExtensionExecutionSummary}" FontSize="11" Foreground="#B6CCE3" TextWrapping="Wrap" Margin="0,5,0,0" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Classes="accent" Content="Exécuter Asset Bridge" Command="{Binding ConfirmHubExtensionExecutionCommand}" />
                <Button Classes="ghost" Content="Annuler" Command="{Binding CancelHubExtensionExecutionCommand}" />
              </StackPanel>
            </Grid>
          </Border>

          <Grid Grid.Row="4">
            <TextBlock
                IsVisible="{Binding HasNoHubExtensions}"
                Text="Aucune extension valide. Vérifiez le dossier Extensions du binaire."
                Foreground="#718398"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
            <ListBox
                Classes="catalog"
                ItemsSource="{Binding HubExtensions}"
                SelectedItem="{Binding SelectedHubExtension}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:HubExtensionCardViewModel">
                  <Border Classes="card">
                    <Grid ColumnDefinitions="*,220" ColumnSpacing="18">
                      <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
                          <Border Background="#18283A" CornerRadius="5" Padding="7,3">
                            <TextBlock Text="{Binding Version}" FontSize="9" FontWeight="Bold" Foreground="#70A8FA" />
                          </Border>
                          <Border Background="#17251F" CornerRadius="5" Padding="7,3">
                            <TextBlock Text="{Binding Health}" FontSize="9" FontWeight="Bold" Foreground="#65CCA9" />
                          </Border>
                          <Border Background="#252117" CornerRadius="5" Padding="7,3">
                            <TextBlock Text="{Binding Origin}" FontSize="9" FontWeight="Bold" Foreground="#E4B95D" />
                          </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Publisher}" FontSize="9" Foreground="#6F8297" />
                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#AAB8C6" TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="1.1*,1.1*,2*" ColumnSpacing="16">
                          <StackPanel>
                            <TextBlock Text="MOTEURS" FontSize="8" FontWeight="Bold" Foreground="#596B7E" />
                            <TextBlock Text="{Binding Engines}" FontSize="10" Margin="0,3,0,0" />
                          </StackPanel>
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="CAPACITÉS" FontSize="8" FontWeight="Bold" Foreground="#596B7E" />
                            <TextBlock Text="{Binding Capabilities}" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap" />
                          </StackPanel>
                          <StackPanel Grid.Column="2">
                            <TextBlock Text="FORMATS" FontSize="8" FontWeight="Bold" Foreground="#596B7E" />
                            <TextBlock Text="{Binding Formats}" FontSize="9" Margin="0,3,0,0" TextWrapping="Wrap" />
                          </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="#EE8D94" FontSize="10" TextWrapping="Wrap" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Kind}" FontSize="9" FontWeight="Bold" Foreground="#6C91B7" />
                        <TextBlock Text="{Binding ExecutionPolicy}" FontSize="10" Foreground="#9EB0C2" TextWrapping="Wrap" Margin="0,5,0,0" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Grid>

        <Grid IsVisible="{Binding IsGitVisible}" RowDefinitions="Auto,*,190">
          <Border Classes="card" Margin="0,0,0,14">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel>
                <TextBlock Text="SNAPSHOTS GIT LOCAUX" FontSize="10" FontWeight="Bold" Foreground="#65788D" />
                <TextBlock Text="{Binding GitStatusSummary}" FontSize="12" Foreground="#A4B3C2" Margin="0,6,0,0" />
                <TextBlock Text="Rafraîchissement manuel uniquement; aucun polling sur les gros dépôts." FontSize="10" Foreground="#687B90" Margin="0,4,0,0" />
              </StackPanel>
              <Button Grid.Column="1" Classes="accent" Content="Analyser Git" Command="{Binding RefreshGitCommand}" VerticalAlignment="Center" />
            </Grid>
          </Border>

          <Grid Grid.Row="1">
            <TextBlock
                IsVisible="{Binding HasNoGitRepositories}"
                Text="Aucun snapshot Git en cache. Lancez une analyse manuelle."
                Foreground="#718398"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
            <ListBox Classes="catalog" ItemsSource="{Binding GitRepositories}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:GitRepositoryCardViewModel">
                  <Border Classes="card">
                    <StackPanel Spacing="10">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel>
                          <StackPanel Orientation="Horizontal" Spacing="9">
                            <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold" />
                            <Border Background="#17283B" CornerRadius="5" Padding="7,3">
                              <TextBlock Text="{Binding OwnerKinds}" FontSize="9" Foreground="#6FA9F8" />
                            </Border>
                          </StackPanel>
                          <TextBlock Text="{Binding RepositoryRoot}" FontSize="10" Foreground="#708398" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="ghost" Content="Dossier" Command="{Binding OpenFolderCommand}" />
                      </Grid>

                      <Grid ColumnDefinitions="1.2*,1.2*,1*,2.4*,2*" ColumnSpacing="16">
                        <StackPanel>
                          <TextBlock Text="BRANCHE" FontSize="9" FontWeight="Bold" Foreground="#5F7287" />
                          <TextBlock Text="{Binding Branch}" FontSize="11" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="COMMIT" FontSize="9" FontWeight="Bold" Foreground="#5F7287" />
                          <TextBlock Text="{Binding Commit}" FontFamily="Consolas" FontSize="11" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                          <TextBlock Text="DIVERGENCE" FontSize="9" FontWeight="Bold" Foreground="#5F7287" />
                          <TextBlock Text="{Binding Divergence}" FontSize="11" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                          <TextBlock Text="WORKTREE" FontSize="9" FontWeight="Bold" Foreground="#5F7287" />
                          <TextBlock Text="{Binding Changes}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                          <TextBlock Text="GIT LFS" FontSize="9" FontWeight="Bold" Foreground="#5F7287" />
                          <TextBlock Text="{Binding LfsSummary}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                      </Grid>

                      <TextBlock Text="{Binding Upstream, StringFormat='Upstream : {0}'}" FontSize="10" Foreground="#7E91A6" />
                      <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="#EE8D94" FontSize="11" TextWrapping="Wrap" />
                      <ItemsControl ItemsSource="{Binding Remotes}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:GitRemoteItemViewModel">
                            <Border Background="#101721" BorderBrush="#263343" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,8,0">
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <StackPanel Width="270">
                                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11" />
                                  <TextBlock Text="{Binding Url}" FontSize="9" Foreground="#6F8297" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Classes="ghost" Content="Fetch" Command="{Binding FetchCommand}" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>

          <Border Grid.Row="2" Background="#080B0F" BorderBrush="#202C39" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,10,0,0">
            <Grid RowDefinitions="Auto,*">
              <TextBlock Text="{Binding ActiveGitOperation}" FontSize="11" FontWeight="SemiBold" Foreground="#8FA3B8" Margin="5,0,0,5" />
              <Grid Grid.Row="1">
                <TextBlock IsVisible="{Binding HasNoGitLogs}" Text="Les sorties de git fetch apparaîtront ici." Foreground="#5F7287" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <ListBox Classes="catalog" ItemsSource="{Binding GitLogs}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:GitLogItemViewModel">
                      <Grid ColumnDefinitions="68,42,*" ColumnSpacing="8" Margin="5,1">
                        <TextBlock Text="{Binding Timestamp}" FontFamily="Consolas" FontSize="10" Foreground="#586B7F" />
                        <TextBlock Grid.Column="1" Text="{Binding Channel}" FontFamily="Consolas" FontSize="10" Foreground="#D99C52" />
                        <SelectableTextBlock Grid.Column="2" Text="{Binding Text}" FontFamily="Consolas" FontSize="10" Foreground="#B8C5D2" TextWrapping="Wrap" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Grid>
          </Border>
        </Grid>

        <ScrollViewer IsVisible="{Binding IsToolchainsVisible}" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="14">
            <Border Classes="card">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel>
                  <TextBlock Text="INVENTAIRE LOCAL ET COMPATIBILITÉ UNREAL" FontSize="10" FontWeight="Bold" Foreground="#65788D" />
                  <TextBlock Text="{Binding ToolchainStatusSummary}" FontSize="12" Foreground="#A4B3C2" Margin="0,6,0,0" TextWrapping="Wrap" />
                  <TextBlock Text="Analyse manuelle et lecture seule. Aucun installateur, SetupAndroid ou changement de variable d’environnement n’est lancé." FontSize="10" Foreground="#687B90" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Classes="accent"
                    Content="Analyser les toolchains"
                    Command="{Binding RefreshToolchainsCommand}"
                    VerticalAlignment="Center" />
              </Grid>
            </Border>

            <TextBlock Text="COMPATIBILITÉ PAR MOTEUR" FontSize="10" FontWeight="Bold" Foreground="#65788D" Margin="4,4,0,0" />
            <TextBlock
                IsVisible="{Binding HasNoEngineToolchains}"
                Text="Aucune compatibilité en cache. Lancez l’analyse manuelle pour comparer les prérequis de chaque moteur."
                Foreground="#718398"
                Margin="4,2,0,8" />
            <ItemsControl ItemsSource="{Binding EngineToolchains}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:EngineToolchainCardViewModel">
                  <Border Classes="card">
                    <StackPanel Spacing="11">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                          <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" Foreground="#F0F5FA" />
                          <Border Background="#18283A" CornerRadius="5" Padding="7,3">
                            <TextBlock Text="{Binding Version}" FontSize="10" FontWeight="Bold" Foreground="#70A8FA" />
                          </Border>
                          <Border Background="#2A2415" CornerRadius="5" Padding="7,3">
                            <TextBlock Text="{Binding Health}" FontSize="10" FontWeight="Bold" Foreground="#F2B84B" />
                          </Border>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Summary}" FontSize="11" Foreground="#8EA0B3" VerticalAlignment="Center" />
                      </Grid>
                      <Grid ColumnDefinitions="1.1*,0.8*,1.6*,1.4*,2.5*" ColumnSpacing="14" Margin="2,2,2,0">
                        <TextBlock Text="COMPOSANT" FontSize="9" FontWeight="Bold" Foreground="#5F7287" />
                        <TextBlock Grid.Column="1" Text="ÉTAT" FontSize="9" FontWeight="Bold" Foreground="#5F7287" />
                        <TextBlock Grid.Column="2" Text="REQUIS" FontSize="9" FontWeight="Bold" Foreground="#5F7287" />
                        <TextBlock Grid.Column="3" Text="INSTALLÉ" FontSize="9" FontWeight="Bold" Foreground="#5F7287" />
                        <TextBlock Grid.Column="4" Text="DIAGNOSTIC" FontSize="9" FontWeight="Bold" Foreground="#5F7287" />
                      </Grid>
                      <ItemsControl ItemsSource="{Binding Checks}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ToolchainCheckItemViewModel">
                            <Grid ColumnDefinitions="1.1*,0.8*,1.6*,1.4*,2.5*" ColumnSpacing="14" Margin="2,4">
                              <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" />
                              <TextBlock Grid.Column="1" Text="{Binding Health}" FontSize="10" Foreground="#D9A55C" />
                              <TextBlock Grid.Column="2" Text="{Binding Required}" FontSize="10" Foreground="#99A9B9" TextWrapping="Wrap" />
                              <TextBlock Grid.Column="3" Text="{Binding Installed}" FontSize="10" Foreground="#B6C2CE" TextWrapping="Wrap" />
                              <TextBlock Grid.Column="4" Text="{Binding Diagnostic}" FontSize="10" Foreground="#7F91A5" TextWrapping="Wrap" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid ColumnDefinitions="1.1*,0.9*" ColumnSpacing="14">
              <StackPanel>
                <TextBlock Text="APPAREILS ANDROID / META QUEST" FontSize="10" FontWeight="Bold" Foreground="#65788D" Margin="4,4,0,7" />
                <Border Classes="card" IsVisible="{Binding HasNoAndroidDevices}">
                  <TextBlock Text="Aucun appareil ADB détecté. Branchez et autorisez l’appareil, puis relancez l’analyse." FontSize="11" Foreground="#718398" TextWrapping="Wrap" />
                </Border>
                <ItemsControl ItemsSource="{Binding AndroidDevices}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AndroidDeviceCardViewModel">
                      <Border Classes="card">
                        <StackPanel Spacing="7">
                          <StackPanel Orientation="Horizontal" Spacing="9">
                            <TextBlock Text="{Binding Model}" FontSize="15" FontWeight="SemiBold" />
                            <Border Background="#17283B" CornerRadius="5" Padding="7,3">
                              <TextBlock Text="{Binding Kind}" FontSize="9" FontWeight="Bold" Foreground="#70A8FA" />
                            </Border>
                            <Border Background="#17251F" CornerRadius="5" Padding="7,3">
                              <TextBlock Text="{Binding State}" FontSize="9" FontWeight="Bold" Foreground="#65CCA9" />
                            </Border>
                          </StackPanel>
                          <TextBlock Text="{Binding Serial, StringFormat='Série : {0}'}" FontFamily="Consolas" FontSize="10" Foreground="#8395A8" />
                          <TextBlock Text="{Binding Product, StringFormat='Produit : {0}'}" FontSize="10" Foreground="#718398" />
                          <TextBlock Text="{Binding Transport, StringFormat='Transport ADB : {0}'}" FontSize="10" Foreground="#718398" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <StackPanel Grid.Column="1">
                <TextBlock Text="VARIABLES D’ENVIRONNEMENT" FontSize="10" FontWeight="Bold" Foreground="#65788D" Margin="4,4,0,7" />
                <ItemsControl ItemsSource="{Binding ToolchainEnvironmentVariables}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:EnvironmentVariableCardViewModel">
                      <Border Classes="card">
                        <StackPanel Spacing="6">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding Name}" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{Binding Health}" FontSize="9" Foreground="#D9A55C" />
                          </Grid>
                          <TextBlock Text="{Binding ProcessValue, StringFormat='Processus : {0}'}" FontSize="9" Foreground="#8496A9" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding UserValue, StringFormat='Utilisateur : {0}'}" FontSize="9" Foreground="#8496A9" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding MachineValue, StringFormat='Système : {0}'}" FontSize="9" Foreground="#8496A9" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Grid>

            <TextBlock Text="INSTALLATIONS DÉTECTÉES" FontSize="10" FontWeight="Bold" Foreground="#65788D" Margin="4,4,0,0" />
            <TextBlock
                IsVisible="{Binding HasNoToolchainInstallations}"
                Text="Aucune installation en cache. L’analyse inspecte uniquement les emplacements standards, le registre et les variables connues."
                Foreground="#718398"
                Margin="4,2,0,8" />
            <ItemsControl ItemsSource="{Binding ToolchainInstallations}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ToolchainInstallationCardViewModel">
                  <Border Classes="card">
                    <Grid ColumnDefinitions="1.1*,0.9*,2.3*,1.2*,Auto" ColumnSpacing="16">
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Kind}" FontSize="9" Foreground="#6FA9F8" Margin="0,3,0,0" />
                      </StackPanel>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="VERSION" FontSize="9" FontWeight="Bold" Foreground="#5F7287" />
                        <TextBlock Text="{Binding Version}" FontFamily="Consolas" FontSize="10" Margin="0,3,0,0" />
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Text="EMPLACEMENT" FontSize="9" FontWeight="Bold" Foreground="#5F7287" />
                        <TextBlock Text="{Binding Path}" FontSize="9" Foreground="#8395A8" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <StackPanel Grid.Column="3">
                        <TextBlock Text="SOURCE / ÉTAT" FontSize="9" FontWeight="Bold" Foreground="#5F7287" />
                        <TextBlock Text="{Binding Source}" FontSize="9" Margin="0,3,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding IssueSummary}" FontSize="9" Foreground="#D9A55C" TextWrapping="Wrap" />
                      </StackPanel>
                      <Button Grid.Column="4" Classes="ghost" Content="Dossier" Command="{Binding OpenFolderCommand}" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <Grid IsVisible="{Binding IsLibraryVisible}" ColumnDefinitions="190,*" ColumnSpacing="12">
          <Border Classes="card" Margin="0" Padding="12" VerticalAlignment="Stretch">
            <StackPanel Spacing="8">
              <TextBlock Text="SOURCES" FontSize="10" FontWeight="Bold" Foreground="#65788D" Margin="6,2,0,6" />
              <Button Classes="ghost" Command="{Binding ShowLibraryFabCommand}" IsVisible="{Binding IsDirectFabConnected}" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Padding="10">
                <Grid ColumnDefinitions="4,*" ColumnSpacing="10">
                  <Border Width="4" CornerRadius="2" Background="#4D9BE8" IsVisible="{Binding IsLibraryFabSelected}" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="Fab" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="My Library" FontSize="9" Foreground="#718398" Margin="0,3,0,0" />
                  </StackPanel>
                </Grid>
              </Button>
              <Button Classes="ghost" Command="{Binding ShowLibraryUnityCommand}" IsVisible="{Binding IsUnityLibrarySourceAvailable}" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Padding="10">
                <Grid ColumnDefinitions="4,*" ColumnSpacing="10">
                  <Border Width="4" CornerRadius="2" Background="#4D9BE8" IsVisible="{Binding IsLibraryUnitySelected}" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="Unity Store" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="Asset Store" FontSize="9" Foreground="#718398" Margin="0,3,0,0" />
                  </StackPanel>
                </Grid>
              </Button>
              <Button Classes="ghost" Command="{Binding ShowLibraryQuixelCommand}" IsVisible="{Binding IsQuixelLibrarySourceAvailable}" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Padding="10">
                <Grid ColumnDefinitions="4,*" ColumnSpacing="10">
                  <Border Width="4" CornerRadius="2" Background="#4D9BE8" IsVisible="{Binding IsLibraryQuixelSelected}" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="Megascans" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="Compte Epic" FontSize="9" Foreground="#718398" Margin="0,3,0,0" />
                  </StackPanel>
                </Grid>
              </Button>
              <Border Background="#0B121A" CornerRadius="7" Padding="10" Margin="0,8,0,0">
                <TextBlock Text="Les connexions et dossiers par défaut se configurent uniquement dans Paramètres." FontSize="9" Foreground="#718398" TextWrapping="Wrap" />
              </Border>
            </StackPanel>
          </Border>

          <Grid Grid.Column="1">
            <Grid>
              <Grid IsVisible="{Binding IsLibraryRemoteSelected}">
              <Border Classes="card" IsVisible="{Binding !IsSelectedRemoteConnectionReady}">
                <StackPanel>
                  <TextBlock Text="{Binding LibraryRemoteHeading}" FontSize="12" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding LibraryRemoteStatusSummary}" FontSize="10" Foreground="#8294A8" Margin="0,5,0,0" TextWrapping="Wrap" />
                  <TextBlock Text="Ouvrez Paramètres → Connexions pour connecter cette source." FontSize="10" Foreground="#D9A55C" Margin="0,5,0,0" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <Grid IsVisible="{Binding IsSelectedRemoteConnectionReady}">
                <Grid IsVisible="{Binding IsRemoteFabCatalogVisible}" RowDefinitions="Auto,Auto,*" RowSpacing="14">
                  <Border Classes="card">
                    <StackPanel Spacing="10">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel>
                          <TextBlock Text="{Binding LibraryRemoteHeading}" FontSize="10" FontWeight="Bold" Foreground="#70A8FA" />
                          <TextBlock Text="{Binding LibraryRemoteAccount}" FontSize="10" Foreground="#65CCA9" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="accent refresh-running" Command="{Binding RefreshDirectFabLibraryCommand}" IsVisible="{Binding IsLibraryFabSelected}" IsEnabled="{Binding !IsFabLibraryRefreshing}">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Width="15" Height="15" Stretch="Uniform" Data="M 7,1 A 6,6 0 1 1 1,7" Stroke="#EAF4FF" StrokeThickness="2" StrokeLineCap="Round" IsVisible="{Binding IsFabLibraryRefreshing}" RenderTransformOrigin="50%,50%">
                              <Path.RenderTransform>
                                <RotateTransform Angle="{Binding FabRefreshSpinnerAngle}" />
                              </Path.RenderTransform>
                            </Path>
                            <TextBlock Text="{Binding FabRefreshButtonLabel}" FontWeight="SemiBold" VerticalAlignment="Center" />
                          </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Classes="accent refresh-running" Command="{Binding RefreshQuixelLibraryCommand}" IsVisible="{Binding IsLibraryQuixelSelected}" IsEnabled="{Binding !IsQuixelLibraryRefreshing}">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Width="15" Height="15" Stretch="Uniform" Data="M 7,1 A 6,6 0 1 1 1,7" Stroke="#EAF4FF" StrokeThickness="2" StrokeLineCap="Round" IsVisible="{Binding IsQuixelLibraryRefreshing}" RenderTransformOrigin="50%,50%">
                              <Path.RenderTransform>
                                <RotateTransform Angle="{Binding QuixelRefreshSpinnerAngle}" />
                              </Path.RenderTransform>
                            </Path>
                            <TextBlock Text="{Binding QuixelRefreshButtonLabel}" FontWeight="SemiBold" VerticalAlignment="Center" />
                          </StackPanel>
                        </Button>
                      </Grid>
                      <Grid ColumnDefinitions="*,190,Auto,Auto" ColumnSpacing="8">
                        <TextBox Classes="path" Text="{Binding LibrarySearchQuery}" PlaceholderText="Rechercher par nom, description, catégorie ou version moteur…" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding LibrarySortOptions}" SelectedItem="{Binding SelectedLibrarySort}" PlaceholderText="Trier par" />
                        <Button Grid.Column="2" Classes="ghost" Content="☷ Filtres avancés" Command="{Binding ToggleAdvancedLibraryFilterCommand}" />
                        <Border Grid.Column="3" IsVisible="{Binding HasActiveLibraryFilters}" Background="#17334B" BorderBrush="#3B7FB5" BorderThickness="1" CornerRadius="7" Padding="10,6">
                          <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding ActiveLibraryFilterSummary}" FontSize="10" VerticalAlignment="Center" /><Button Classes="history" Width="22" Height="22" FontSize="13" Content="✕" Command="{Binding ClearAdvancedLibraryFiltersCommand}" ToolTip.Tip="Réinitialiser les filtres" /></StackPanel>
                        </Border>
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="7">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <TextBlock Text="{Binding LibraryResultsSummary}" FontSize="10" Foreground="#8294A8" VerticalAlignment="Center" Margin="0,0,14,0" />
                          <CheckBox Content="Téléchargés" IsChecked="{Binding ShowDownloadedLibraryAssets}" FontSize="10" Margin="0,0,10,0" ToolTip.Tip="Au moins une version est présente dans une bibliothèque locale." />
                          <CheckBox Content="Non téléchargés" IsChecked="{Binding ShowUndownloadedLibraryAssets}" FontSize="10" Margin="0,0,10,0" ToolTip.Tip="Aucune version locale détectée. Cochez les deux cases pour tout afficher." />
                        </WrapPanel>
                        <CheckBox Grid.Column="1" Content="Afficher les masqués" IsChecked="{Binding ShowHiddenFabAssets}" FontSize="10" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Classes="ghost view-mode" Content="Grand" Command="{Binding ShowLargeLibraryCardsCommand}" IsVisible="{Binding IsLibraryCompactCards}" />
                        <Button Grid.Column="2" Classes="ghost view-mode active" Content="Grand" Command="{Binding ShowLargeLibraryCardsCommand}" IsVisible="{Binding IsLibraryLargeCards}" />
                        <Button Grid.Column="3" Classes="ghost view-mode" Content="Petit" Command="{Binding ShowCompactLibraryCardsCommand}" IsVisible="{Binding IsLibraryLargeCards}" />
                        <Button Grid.Column="3" Classes="ghost view-mode active" Content="Petit" Command="{Binding ShowCompactLibraryCardsCommand}" IsVisible="{Binding IsLibraryCompactCards}" />
                        <Button Grid.Column="4" Classes="ghost view-mode" Content="Pages" Command="{Binding ShowPagedLibraryCommand}" IsVisible="{Binding IsLibraryInfiniteMode}" />
                        <Button Grid.Column="4" Classes="ghost view-mode" Content="Infini" Command="{Binding ShowInfiniteLibraryCommand}" IsVisible="{Binding IsLibraryPagedMode}" />
                        <Button Grid.Column="5" Classes="ghost" Content="←" Command="{Binding PreviousLibraryPageCommand}" IsEnabled="{Binding CanShowPreviousLibraryPage}" IsVisible="{Binding IsLibraryPagedMode}" />
                        <TextBlock Grid.Column="6" Text="{Binding LibraryPageSummary}" FontSize="10" Foreground="#A8C9F2" VerticalAlignment="Center" IsVisible="{Binding IsLibraryPagedMode}" />
                        <Button Grid.Column="7" Classes="ghost" Content="→" Command="{Binding NextLibraryPageCommand}" IsEnabled="{Binding CanShowNextLibraryPage}" IsVisible="{Binding IsLibraryPagedMode}" />
                      </Grid>
                    </StackPanel>
                  </Border>

                  <TextBlock Grid.Row="1" IsVisible="{Binding HasNoRemoteFabAssets}" Text="Aucun résultat dans cette catégorie ou pour cette recherche." FontSize="11" Foreground="#718398" HorizontalAlignment="Center" Margin="0,30" />
                  <ListBox Grid.Row="2" ItemsSource="{Binding PagedRemoteFabRows}" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" AttachedToVisualTree="AttachRemoteFabCatalog" DetachedFromVisualTree="DetachRemoteFabCatalog">
                    <ListBox.Styles>
                      <Style Selector="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                      </Style>
                    </ListBox.Styles>
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <VirtualizingStackPanel CacheLength="0.5" />
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:RemoteFabAssetRowViewModel">
                        <ItemsControl ItemsSource="{Binding Cards}" AttachedToVisualTree="RealizeRemoteFabRow" DetachedFromVisualTree="RecycleRemoteFabRow" DataContextChanged="RealizeRemoteFabRowDataContext">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RemoteFabAssetCardViewModel">
                        <Border AttachedToVisualTree="LoadRemoteFabThumbnail" Width="{Binding CardWidth}" Height="{Binding CardHeight}" Margin="0,0,12,12" Background="#0D141C" BorderBrush="#202C39" BorderThickness="1" CornerRadius="9" Padding="8">
                          <Grid RowDefinitions="*,Auto" RowSpacing="7">
                            <Button Command="{Binding OpenDetailsCommand}" Padding="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" ToolTip.Tip="Ouvrir la fiche produit">
                              <Grid RowDefinitions="Auto,Auto,Auto,*">
                                <Border Height="{Binding ImageHeight}" Background="#091018" CornerRadius="7" ClipToBounds="True">
                                  <Grid>
                                    <TextBlock Text="FAB" FontSize="26" FontWeight="Bold" Foreground="#29415A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Text="Chargement…" IsVisible="{Binding IsThumbnailLoading}" FontSize="9" Foreground="#718398" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12" />
                                    <Image Source="{Binding Thumbnail}" IsVisible="{Binding HasThumbnail}" Stretch="UniformToFill" />
                                    <Border Background="#101B26E8" CornerRadius="7" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7" ToolTip.Tip="Présence dans le stockage local"><TextBlock Text="{Binding LocalStatusLabel}" FontSize="8" FontWeight="Bold" Foreground="{Binding LocalStatusForeground}" /></Border>
                                    <Border IsVisible="{Binding IsHidden}" Background="#B36C2E3A" CornerRadius="5" Padding="7,3" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="7"><TextBlock Text="MASQUÉ" FontSize="8" FontWeight="Bold" /></Border>
                                  </Grid>
                                </Border>
                                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="2,8,2,0">
                                  <TextBlock Text="{Binding Organization.DisplayName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                  <Border Grid.Column="1" IsVisible="{Binding HasCollections}" Background="#17334B" CornerRadius="9" Padding="6,2" ToolTip.Tip="{Binding CollectionSummary}"><TextBlock Text="{Binding CollectionCountLabel}" FontSize="8" FontWeight="Bold" Foreground="#8DC7F5" /></Border>
                                </Grid>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" Margin="2,6,2,0">
                                  <Border Background="#17283B" CornerRadius="4" Padding="6,2"><TextBlock Text="{Binding CategoryLabel}" FontSize="8" FontWeight="Bold" Foreground="#70A8FA" TextTrimming="CharacterEllipsis" MaxWidth="110" /></Border>
                                  <TextBlock Text="{Binding AcquisitionLabel}" FontSize="8" Foreground="#8395A8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Row="3" Margin="2,7,2,0" Spacing="4">
                                  <ItemsControl ItemsSource="{Binding EngineVersionBadges}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:FabEngineVersionBadgeViewModel"><TextBlock Text="{Binding DisplayVersion}" Foreground="{Binding Foreground}" FontSize="8" Margin="0,0,6,2" ToolTip.Tip="{Binding ToolTip}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                  <TextBlock Text="{Binding CollectionSummary}" FontSize="9" Foreground="#A8C9F2" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                              </Grid>
                            </Button>
                            <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="6">
                              <Button Classes="ghost asset-action" Command="{Binding OpenListingCommand}" IsEnabled="{Binding HasListingUri}" ToolTip.Tip="Ouvrir la page web"><TextBlock Text="🌐" FontSize="14" /></Button>
                              <Button Grid.Column="1" Classes="ghost asset-action" Command="{Binding DownloadCommand}" IsEnabled="{Binding CanDownload}" ToolTip.Tip="Choisir les versions à télécharger"><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="M 12,3 L 12,15 M 7,10 L 12,15 L 17,10 M 4,18 L 4,21 L 20,21 L 20,18" Stroke="#CFD9E5" StrokeThickness="2" /></Canvas></Viewbox></Button>
                              <Button Grid.Column="2" Classes="ghost asset-action" Command="{Binding OpenInstallCommand}" IsEnabled="{Binding CanDownload}" ToolTip.Tip="Installer dans un projet ou moteur"><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="M 4,4 L 20,4 L 20,20 L 4,20 Z M 8,9 L 12,13 L 16,9 M 12,7 L 12,16" Stroke="#CFD9E5" StrokeThickness="2" /></Canvas></Viewbox></Button>
                              <Button Grid.Column="4" Classes="ghost asset-action" Content="＋" Command="{Binding OpenCollectionsCommand}" ToolTip.Tip="Ajouter à des collections" />
                            </Grid>
                          </Grid>
                        </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>

                <ScrollViewer IsVisible="{Binding IsRemoteFabProductVisible}" VerticalScrollBarVisibility="Auto">
                  <StackPanel Spacing="14">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Button Classes="ghost" Content="← Retour à la Bibliothèque" Command="{Binding CloseRemoteFabProductCommand}" />
                    <TextBlock Grid.Column="1" Text="{Binding LibraryProductHeading}" FontSize="10" FontWeight="Bold" Foreground="#65788D" VerticalAlignment="Center" />
                  </Grid>
                  <Border Classes="card" Padding="22">
                    <Grid ColumnDefinitions="300,*,Auto" ColumnSpacing="24">
                      <Button Command="{Binding OpenFabImagePreviewCommand}" Padding="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" ToolTip.Tip="Afficher l’image en grand">
                        <Border Height="185" Background="#091018" CornerRadius="10" ClipToBounds="True" VerticalAlignment="Top">
                          <Grid>
                            <TextBlock Text="FAB" FontSize="26" FontWeight="Bold" Foreground="#29415A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding SelectedRemoteFabAssetCard.PreviewImage}" IsVisible="{Binding SelectedRemoteFabAssetCard.HasPreviewImage}" Stretch="UniformToFill" />
                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" Background="#C20B121A" CornerRadius="7" Padding="8,4"><TextBlock Text="⛶ Agrandir" FontSize="9" FontWeight="SemiBold" /></Border>
                          </Grid>
                        </Border>
                      </Button>
                      <StackPanel Grid.Column="1" Spacing="9">
                        <TextBlock Text="{Binding SelectedRemoteFabAssetCard.Organization.DisplayName}" FontSize="27" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SelectedRemoteFabAssetCard.Description}" FontSize="12" Foreground="#B7C4D1" TextWrapping="Wrap" MaxHeight="92" />
                        <TextBlock Text="{Binding SelectedRemoteFabAssetCard.ArtifactSummary}" FontSize="11" Foreground="#65CCA9" />
                        <TextBlock Text="{Binding SelectedRemoteFabAssetCard.Categories, StringFormat='Catégories · {0}'}" FontSize="10" Foreground="#8294A8" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SelectedRemoteFabAssetCard.Platforms, StringFormat='Plateformes · {0}'}" FontSize="10" Foreground="#8294A8" TextWrapping="Wrap" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Right">
                          <Button Classes="ghost asset-action" Command="{Binding OpenSelectedRemoteFabListingCommand}" IsEnabled="{Binding HasSelectedRemoteFabListing}" ToolTip.Tip="Ouvrir la page web"><TextBlock Text="🌐" FontSize="14" /></Button>
                          <Button Classes="ghost asset-action" Command="{Binding OpenFabDownloadOptionsCommand}" IsEnabled="{Binding SelectedRemoteFabAssetCard.CanDownload}" ToolTip.Tip="Choisir les versions à télécharger"><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="M 12,3 L 12,15 M 7,10 L 12,15 L 17,10 M 4,18 L 4,21 L 20,21 L 20,18" Stroke="#CFD9E5" StrokeThickness="2" /></Canvas></Viewbox></Button>
                          <Button Classes="accent asset-action" Command="{Binding OpenFabInstallOptionsCommand}" IsEnabled="{Binding SelectedRemoteFabAssetCard.CanDownload}" ToolTip.Tip="Installer dans un ou plusieurs projets"><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="M 4,4 L 20,4 L 20,20 L 4,20 Z M 8,9 L 12,13 L 16,9 M 12,7 L 12,16" Stroke="#FFFFFF" StrokeThickness="2" /></Canvas></Viewbox></Button>
                          <Button Classes="ghost asset-action" Content="＋" Command="{Binding SelectedRemoteFabAssetCard.OpenCollectionsCommand}" ToolTip.Tip="Ajouter à des collections" />
                        </StackPanel>
                        <Button Classes="ghost" Content="{Binding SelectedFabAssetVisibilityLabel}" Command="{Binding HideSelectedFabAssetCommand}" IsVisible="{Binding !SelectedRemoteFabAssetCard.IsHidden}" />
                        <Button Classes="danger" Content="{Binding SelectedFabAssetVisibilityLabel}" Command="{Binding HideSelectedFabAssetCommand}" IsVisible="{Binding SelectedRemoteFabAssetCard.IsHidden}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border Classes="card" IsVisible="{Binding HasSelectedFabVersionDownloads}">
                    <StackPanel Spacing="9">
                      <TextBlock Text="TÉLÉCHARGEMENTS EN ATTENTE OU EN COURS" FontSize="10" FontWeight="Bold" Foreground="#70A8FA" />
                      <TextBlock Text="Chaque variante possède sa propre progression et peut être annulée indépendamment." FontSize="9" Foreground="#8294A8" />
                      <ItemsControl ItemsSource="{Binding SelectedFabVersionDownloads}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:FabVersionDownloadViewModel">
                            <Border Background="#0D141C" BorderBrush="#26394C" BorderThickness="1" CornerRadius="7" Padding="11" Margin="0,0,0,7">
                              <Grid ColumnDefinitions="1.2*,2*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="7">
                                <StackPanel>
                                  <TextBlock Text="{Binding Version}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                  <TextBlock Text="{Binding ArtifactId}" FontSize="8" Foreground="#718398" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                  <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding Message}" FontSize="9" Foreground="#A8C9F2" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="9" FontWeight="SemiBold" Foreground="#65CCA9" Margin="10,0,0,0" />
                                  </Grid>
                                  <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Height="7" Margin="0,6,0,0" />
                                </StackPanel>
                                <Button Grid.Column="2" Classes="danger" Content="Annuler" Command="{Binding CancelCommand}" IsVisible="{Binding CanCancel}" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                  <Border Classes="card">
                    <StackPanel Spacing="9">
                      <Grid ColumnDefinitions="*,224" ColumnSpacing="10">
                        <TextBlock Text="VERSIONS DÉJÀ TÉLÉCHARGÉES" FontSize="10" FontWeight="Bold" Foreground="#65788D" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="danger" Content="Supprimer toutes" Command="{Binding RequestDeleteAllFabDownloadsCommand}" IsVisible="{Binding HasSelectedFabStoredDownloads}" HorizontalAlignment="Stretch" />
                      </Grid>
                      <Border IsVisible="{Binding IsDeleteAllFabDownloadsConfirmationVisible}" Background="#321A1D" CornerRadius="6" Padding="9">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                          <TextBlock Text="Supprimer définitivement toutes les versions téléchargées de ce produit ?" TextWrapping="Wrap" VerticalAlignment="Center" />
                          <Button Grid.Column="1" Classes="danger" Content="Confirmer" Command="{Binding ConfirmDeleteAllFabDownloadsCommand}" />
                          <Button Grid.Column="2" Classes="ghost" Content="Annuler" Command="{Binding CancelDeleteAllFabDownloadsCommand}" />
                        </Grid>
                      </Border>
                      <TextBlock IsVisible="{Binding !HasSelectedFabStoredDownloads}" Text="Aucune version de ce produit n’est encore présente dans le stockage configuré." FontSize="10" Foreground="#718398" />
                      <ItemsControl ItemsSource="{Binding SelectedFabStoredDownloads}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:FabStoredDownloadViewModel">
                            <Border Background="#0D141C" BorderBrush="#202C39" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,6">
                              <Grid ColumnDefinitions="1.2*,*,108,108" ColumnSpacing="8">
                                <StackPanel><TextBlock Text="{Binding Version}" FontWeight="SemiBold" /><TextBlock Text="{Binding PackageSummary}" FontSize="9" Foreground="#65CCA9" /><TextBlock Text="{Binding ArtifactId}" FontSize="8" Foreground="#718398" TextTrimming="CharacterEllipsis" /></StackPanel>
                                <StackPanel Grid.Column="1" Spacing="1"><TextBlock Text="{Binding RawSizeLabel}" FontSize="10" /><TextBlock Text="{Binding StoredSizeLabel}" FontSize="10" Foreground="#65CCA9" /><TextBlock Text="{Binding DownloadedAt}" FontSize="8" Foreground="#718398" /></StackPanel>
                                <Button Grid.Column="2" Classes="ghost" Content="Dossier" Command="{Binding OpenFolderCommand}" ToolTip.Tip="{Binding Path}" HorizontalAlignment="Stretch" />
                                <Button Grid.Column="3" Classes="danger" Content="Supprimer" Command="{Binding RequestDeleteCommand}" HorizontalAlignment="Stretch" />
                                <Border Grid.ColumnSpan="4" IsVisible="{Binding IsDeleteConfirmationVisible}" Background="#321A1D" CornerRadius="5" Padding="7" VerticalAlignment="Center">
                                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <TextBlock Text="Supprimer cette version et tous ses fichiers ?" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Classes="danger" Content="Confirmer" Command="{Binding ConfirmDeleteCommand}" />
                                    <Button Grid.Column="2" Classes="ghost" Content="Annuler" Command="{Binding CancelDeleteCommand}" />
                                  </Grid>
                                </Border>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                  </StackPanel>
                </ScrollViewer>
              </Grid>
            </Grid>

            <ScrollViewer IsVisible="{Binding IsQuixelBridgeLocalPanelVisible}" VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="14">
              <Border Classes="card" BorderBrush="#3C6D64">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                  <StackPanel Spacing="7">
                    <TextBlock Text="QUIXEL · BIBLIOTHÈQUE BRIDGE" FontSize="10" FontWeight="Bold" Foreground="#65CCA9" />
                    <TextBlock Text="{Binding QuixelLibraryStatus}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="La connexion Epic/Megascans n’est pas active. Les anciens téléchargements Bridge locaux restent accessibles ci-dessous." FontSize="10" Foreground="#8294A8" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="ghost" Content="Configurer Epic/Fab" Command="{Binding ShowFabConnectionSettingsCommand}" />
                    <Button Classes="accent" Content="Analyser la bibliothèque locale" Command="{Binding RefreshQuixelLocalLibraryCommand}" />
                  </StackPanel>
                </Grid>
              </Border>
              <TextBlock IsVisible="{Binding !HasQuixelLocalAssets}" Text="Aucun téléchargement Bridge local détecté. Le chemin se configure uniquement dans Paramètres → Bibliothèque." FontSize="11" Foreground="#718398" HorizontalAlignment="Center" Margin="0,24" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding QuixelLocalAssets}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:QuixelLocalAssetCardViewModel">
                    <Border Width="300" Height="136" Background="#0D141C" BorderBrush="#202C39" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,0,12,12">
                      <Grid RowDefinitions="*,Auto">
                        <StackPanel Spacing="6"><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding Kind}" FontSize="9" Foreground="#65CCA9" /><TextBlock Text="{Binding AssetId}" FontFamily="Consolas" FontSize="8" Foreground="#718398" TextTrimming="CharacterEllipsis" /></StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="7">
                          <Button Classes="accent" Content="Utiliser" Command="{Binding UseCommand}" />
                          <Button Classes="ghost" Content="Ouvrir le dossier" Command="{Binding OpenFolderCommand}" ToolTip.Tip="{Binding Path}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              </StackPanel>
            </ScrollViewer>

            <ScrollViewer IsVisible="{Binding IsLibraryUnitySelected}" VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="14">
              <Border Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Text="UNITY ASSET STORE" FontSize="10" FontWeight="Bold" Foreground="#65788D" />
                  <TextBlock Text="La source Unity est isolée de Fab. Le connecteur authentifié Unity sera ajouté ici sans mélanger ses réglages avec le catalogue." FontSize="11" Foreground="#A4B3C2" TextWrapping="Wrap" />
                  <Button Classes="accent" Content="Ouvrir Unity Asset Store" Command="{Binding OpenUnityAssetStoreCommand}" HorizontalAlignment="Left" />
                </StackPanel>
              </Border>
              </StackPanel>
            </ScrollViewer>

            </Grid>
          </Grid>
          <Grid Grid.ColumnSpan="2" IsVisible="{Binding IsAdvancedLibraryFilterVisible}" Panel.ZIndex="500">
            <Border Background="#CC05080C" />
            <Border Width="980" MaxHeight="620" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#111820" BorderBrush="#31506D" BorderThickness="1" CornerRadius="12" Padding="22">
              <Grid RowDefinitions="Auto,*,Auto" RowSpacing="15">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="Filtres avancés" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="Les facettes se combinent et actualisent immédiatement le catalogue." FontSize="10" Foreground="#8294A8" Margin="0,5,0,0" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="history" Content="✕" Command="{Binding ToggleAdvancedLibraryFilterCommand}" />
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="12" IsVisible="{Binding IsLibraryCompatibilityFilterVisible}">
                  <Border Classes="card" Margin="0"><StackPanel Spacing="9"><TextBlock Text="COMPATIBILITÉ" FontSize="9" FontWeight="Bold" Foreground="#70A8FA" /><TextBox Classes="path" Text="{Binding LibraryEngineFacetSearchQuery, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Rechercher un nom…" FontSize="10" MinHeight="32" Padding="7" ToolTip.Tip="Recherche contains, sans distinction de casse." /><CheckBox ToolTip.Tip="Sélectionner ou désélectionner les choix affichés ; les autres sélections sont conservées." Content="Tout sélectionner" IsChecked="{Binding AreAllLibraryEngineFacetsSelected}" FontSize="9" /><ListBox Height="309" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding VisibleLibraryEngineFacets}"><ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="MinHeight" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListBox.Styles><ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel CacheLength="0.5" /></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate x:DataType="vm:LibraryFacetOptionViewModel"><CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Label}" FontSize="10" Padding="4" Height="32" /></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border>
                  <Border Grid.Column="1" Classes="card" Margin="0"><StackPanel Spacing="9"><TextBlock Text="TYPE D’ASSET" FontSize="9" FontWeight="Bold" Foreground="#70A8FA" /><TextBox Classes="path" Text="{Binding LibraryAssetTypeFacetSearchQuery, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Rechercher un nom…" FontSize="10" MinHeight="32" Padding="7" ToolTip.Tip="Recherche contains, sans distinction de casse." /><CheckBox ToolTip.Tip="Sélectionner ou désélectionner les choix affichés ; les autres sélections sont conservées." Content="Tout sélectionner" IsChecked="{Binding AreAllLibraryAssetTypeFacetsSelected}" FontSize="9" /><ListBox Height="309" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding VisibleLibraryAssetTypeFacets}"><ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="MinHeight" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListBox.Styles><ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel CacheLength="0.5" /></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate x:DataType="vm:LibraryFacetOptionViewModel"><CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Label}" FontSize="10" Padding="4" Height="32" /></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border>
                  <Border Grid.Column="2" Classes="card" Margin="0"><StackPanel Spacing="9"><TextBlock Text="CATÉGORIE" FontSize="9" FontWeight="Bold" Foreground="#70A8FA" /><TextBox Classes="path" Text="{Binding LibraryCategoryFacetSearchQuery, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Rechercher un nom…" FontSize="10" MinHeight="32" Padding="7" ToolTip.Tip="Recherche contains, sans distinction de casse." /><CheckBox ToolTip.Tip="Sélectionner ou désélectionner les choix affichés ; les autres sélections sont conservées." Content="Tout sélectionner" IsChecked="{Binding AreAllLibraryCategoryFacetsSelected}" FontSize="9" /><ListBox Height="309" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding VisibleLibraryCategoryFacets}"><ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="MinHeight" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListBox.Styles><ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel CacheLength="0.5" /></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate x:DataType="vm:LibraryFacetOptionViewModel"><CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Label}" FontSize="10" Padding="4" Height="32" /></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border>
                  <Border Grid.Column="3" Classes="card" Margin="0"><StackPanel Spacing="9"><TextBlock Text="COLLECTION" FontSize="9" FontWeight="Bold" Foreground="#70A8FA" /><TextBox Classes="path" Text="{Binding LibraryCollectionFacetSearchQuery, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Rechercher un nom…" FontSize="10" MinHeight="32" Padding="7" ToolTip.Tip="Recherche contains, sans distinction de casse." /><CheckBox ToolTip.Tip="Sélectionner ou désélectionner les choix affichés ; les autres sélections sont conservées." Content="Tout sélectionner" IsChecked="{Binding AreAllLibraryCollectionFacetsSelected}" FontSize="9" /><ListBox Height="309" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding VisibleLibraryCollectionFacets}"><ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="MinHeight" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListBox.Styles><ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel CacheLength="0.5" /></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate x:DataType="vm:LibraryFacetOptionViewModel"><CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Label}" FontSize="10" Padding="4" Height="32" /></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border>
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="12" IsVisible="{Binding IsLibraryQuixelSelected}">
                  <Border Classes="card" Margin="0"><StackPanel Spacing="9"><TextBlock Text="TYPE D’ASSET" FontSize="9" FontWeight="Bold" Foreground="#70A8FA" /><TextBox Classes="path" Text="{Binding LibraryAssetTypeFacetSearchQuery, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Rechercher un nom…" FontSize="10" MinHeight="32" Padding="7" ToolTip.Tip="Recherche contains, sans distinction de casse." /><CheckBox ToolTip.Tip="Sélectionner ou désélectionner les choix affichés ; les autres sélections sont conservées." Content="Tout sélectionner" IsChecked="{Binding AreAllLibraryAssetTypeFacetsSelected}" FontSize="9" /><ListBox Height="309" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding VisibleLibraryAssetTypeFacets}"><ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="MinHeight" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListBox.Styles><ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel CacheLength="0.5" /></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate x:DataType="vm:LibraryFacetOptionViewModel"><CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Label}" FontSize="10" Padding="4" Height="32" /></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border>
                  <Border Grid.Column="1" Classes="card" Margin="0"><StackPanel Spacing="9"><TextBlock Text="CATÉGORIE" FontSize="9" FontWeight="Bold" Foreground="#70A8FA" /><TextBox Classes="path" Text="{Binding LibraryCategoryFacetSearchQuery, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Rechercher un nom…" FontSize="10" MinHeight="32" Padding="7" ToolTip.Tip="Recherche contains, sans distinction de casse." /><CheckBox ToolTip.Tip="Sélectionner ou désélectionner les choix affichés ; les autres sélections sont conservées." Content="Tout sélectionner" IsChecked="{Binding AreAllLibraryCategoryFacetsSelected}" FontSize="9" /><ListBox Height="309" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding VisibleLibraryCategoryFacets}"><ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="MinHeight" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListBox.Styles><ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel CacheLength="0.5" /></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate x:DataType="vm:LibraryFacetOptionViewModel"><CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Label}" FontSize="10" Padding="4" Height="32" /></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border>
                  <Border Grid.Column="2" Classes="card" Margin="0"><StackPanel Spacing="9"><TextBlock Text="COLLECTION" FontSize="9" FontWeight="Bold" Foreground="#70A8FA" /><TextBox Classes="path" Text="{Binding LibraryCollectionFacetSearchQuery, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Rechercher un nom…" FontSize="10" MinHeight="32" Padding="7" ToolTip.Tip="Recherche contains, sans distinction de casse." /><CheckBox ToolTip.Tip="Sélectionner ou désélectionner les choix affichés ; les autres sélections sont conservées." Content="Tout sélectionner" IsChecked="{Binding AreAllLibraryCollectionFacetsSelected}" FontSize="9" /><ListBox Height="309" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding VisibleLibraryCollectionFacets}"><ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="MinHeight" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListBox.Styles><ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel CacheLength="0.5" /></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate x:DataType="vm:LibraryFacetOptionViewModel"><CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Label}" FontSize="10" Padding="4" Height="32" /></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border>
                </Grid>
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                  <TextBlock Text="{Binding LibraryResultsSummary}" FontSize="11" Foreground="#A8C9F2" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="ghost" Content="Réinitialiser" Command="{Binding ClearAdvancedLibraryFiltersCommand}" />
                  <Button Grid.Column="2" Classes="accent" Content="Voir les résultats" Command="{Binding ToggleAdvancedLibraryFilterCommand}" />
                </Grid>
              </Grid>
            </Border>
          </Grid>
          <Grid Grid.ColumnSpan="2" IsVisible="{Binding IsFabCollectionEditorVisible}" Panel.ZIndex="520">
            <Border Background="#CC05080C" />
            <Border Width="560" MaxHeight="620" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#111820" BorderBrush="#31506D" BorderThickness="1" CornerRadius="12" Padding="22">
              <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
                <Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="Collections personnelles" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Un asset peut appartenir à plusieurs collections." FontSize="10" Foreground="#8294A8" Margin="0,4,0,0" /></StackPanel><Button Grid.Column="1" Classes="history" Content="✕" Command="{Binding CloseFabCollectionEditorCommand}" /></Grid>
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox Classes="path" Text="{Binding FabCollectionSearchQuery}" PlaceholderText="Rechercher une collection…" /><Grid Grid.Column="1" ColumnDefinitions="180,Auto" ColumnSpacing="6"><TextBox Classes="path" Text="{Binding NewFabCollectionName}" PlaceholderText="Nouvelle collection" /><Button Grid.Column="1" Classes="ghost" Content="＋" Command="{Binding AddFabCollectionCommand}" /></Grid></Grid>
                <ScrollViewer Grid.Row="2" MaxHeight="380"><ItemsControl ItemsSource="{Binding FabCollectionOptions}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:FabCollectionOptionViewModel"><CheckBox IsVisible="{Binding IsVisible}" IsChecked="{Binding IsSelected}" Content="{Binding Name}" Padding="7" Margin="0,0,0,3" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><TextBlock Text="Cochez toutes les collections souhaitées." FontSize="9" Foreground="#718398" VerticalAlignment="Center" /><Button Grid.Column="1" Classes="ghost" Content="Annuler" Command="{Binding CloseFabCollectionEditorCommand}" /><Button Grid.Column="2" Classes="accent" Content="Enregistrer" Command="{Binding SaveFabCollectionsCommand}" /></Grid>
              </Grid>
            </Border>
          </Grid>
        </Grid>

        <ScrollViewer IsVisible="{Binding IsEpicVisible}" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="14">
            <Border Background="#132335" BorderBrush="#285682" BorderThickness="1" CornerRadius="10" Padding="18">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                <StackPanel>
                  <TextBlock Text="CONNEXION OFFICIELLE · NAVIGATEUR EXTERNE" FontSize="10" FontWeight="Bold" Foreground="#70A8FA" />
                  <TextBlock Text="CyEngineHub ouvre Epic et Fab dans votre navigateur. La session y reste isolée : aucun cookie, mot de passe ou token EGL n’est lu ou enregistré." FontSize="12" Foreground="#BCD0E6" Margin="0,7,0,0" TextWrapping="Wrap" />
                  <TextBlock Text="Une page ouverte ne signifie donc pas que CyEngineHub peut vérifier votre identité ou lire votre bibliothèque Fab distante." FontSize="10" Foreground="#8098B1" Margin="0,5,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Classes="accent" Content="Actualiser le catalogue local" Command="{Binding RefreshEpicCommand}" VerticalAlignment="Center" />
              </Grid>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
              <Border Classes="card">
                <StackPanel Spacing="9">
                  <TextBlock Text="COMPTE EPIC" FontSize="10" FontWeight="Bold" Foreground="#65788D" />
                  <TextBlock Text="Connexion dans le navigateur officiel" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding EpicAuthenticationSummary}" FontSize="10" Foreground="#8294A8" TextWrapping="Wrap" />
                  <WrapPanel Margin="0,5,0,0">
                    <Button Classes="accent" Content="Se connecter à Epic" Command="{Binding OpenEpicSignInCommand}" Margin="0,0,8,6" />
                    <Button Classes="ghost" Content="Mon compte" Command="{Binding OpenEpicAccountCommand}" Margin="0,0,8,6" />
                    <Button Classes="ghost" Content="Portail développeur" Command="{Binding OpenEpicDeveloperPortalCommand}" Margin="0,0,0,6" />
                  </WrapPanel>
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="card">
                <StackPanel Spacing="9">
                  <TextBlock Text="FAB" FontSize="10" FontWeight="Bold" Foreground="#65788D" />
                  <TextBlock Text="Bibliothèque officielle" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding FabStatusSummary}" FontSize="10" Foreground="#8294A8" TextWrapping="Wrap" />
                  <WrapPanel Margin="0,5,0,0">
                    <Button Classes="accent" Content="Ouvrir My Library" Command="{Binding OpenFabLibraryCommand}" Margin="0,0,8,6" />
                    <Button Classes="ghost" Content="Explorer Fab" Command="{Binding OpenFabHomeCommand}" Margin="0,0,0,6" />
                  </WrapPanel>
                </StackPanel>
              </Border>
            </Grid>

            <Border Classes="card">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel>
                  <TextBlock Text="EPIC GAMES LAUNCHER · OPTIONNEL" FontSize="10" FontWeight="Bold" Foreground="#65788D" />
                  <TextBlock Text="{Binding EpicLauncherStatus}" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0" />
                  <TextBlock Text="{Binding EpicLauncherPath}" FontSize="10" Foreground="#718398" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="1" Classes="ghost" Content="Lancer Epic Games Launcher" Command="{Binding LaunchEpicLauncherCommand}" IsEnabled="{Binding CanLaunchEpicLauncher}" VerticalAlignment="Center" />
              </Grid>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Text="TÉLÉCHARGER UN MOTEUR UNREAL" FontSize="10" FontWeight="Bold" Foreground="#65788D" />
                <Grid ColumnDefinitions="0.85*,1.5*" ColumnSpacing="18">
                  <Border Background="#0D141C" BorderBrush="#202C39" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel Spacing="8">
                      <TextBlock Text="Build binaire officiel" FontSize="15" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding EngineBinaryDownloadSummary}" FontSize="10" Foreground="#8294A8" TextWrapping="Wrap" />
                      <TextBlock Text="Le téléchargement direct n’est pas exposé par une API publique de launcher tierce : CyEngineHub passe donc par EGL pour cette variante." FontSize="10" Foreground="#687B90" TextWrapping="Wrap" />
                      <WrapPanel Margin="0,4,0,0">
                        <Button Classes="accent" Content="Lancer EGL" Command="{Binding LaunchEpicLauncherCommand}" IsEnabled="{Binding CanLaunchEpicLauncher}" Margin="0,0,8,6" />
                        <Button Classes="ghost" Content="Guide officiel" Command="{Binding OpenEngineInstallationGuideCommand}" Margin="0,0,0,6" />
                      </WrapPanel>
                    </StackPanel>
                  </Border>

                  <Border Grid.Column="1" Background="#0D141C" BorderBrush="#202C39" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel Spacing="8">
                      <TextBlock Text="Moteur source GitHub" FontSize="15" FontWeight="SemiBold" />
                      <TextBlock Text="Accès Epic↔GitHub requis. Le clone est mis en file et annulable; Setup.bat reste une action séparée dans la page Moteurs." FontSize="10" Foreground="#8294A8" TextWrapping="Wrap" />
                      <TextBox Classes="path" Text="{Binding SourceEngineRepository}" PlaceholderText="https://github.com/EpicGames/UnrealEngine.git" />
                      <Grid ColumnDefinitions="0.7*,1.8*" ColumnSpacing="8">
                        <TextBox Classes="path" Text="{Binding SourceEngineBranch}" PlaceholderText="release ou ue5-main" />
                        <TextBox Grid.Column="1" Classes="path" Text="{Binding SourceEngineTargetDirectory}" PlaceholderText="J:\UnrealEngine\UE_Source" />
                      </Grid>
                      <CheckBox Content="Clone léger — profondeur 1" IsChecked="{Binding SourceEngineShallowClone}" />
                      <TextBlock Text="{Binding SourceEngineDownloadStatus}" FontSize="10" Foreground="#8294A8" TextWrapping="Wrap" />
                      <WrapPanel>
                        <Button Classes="accent" Content="Préparer le clone" Command="{Binding PrepareSourceEngineDownloadCommand}" Margin="0,0,8,6" />
                        <Button Classes="ghost" Content="Accès GitHub" Command="{Binding OpenUnrealSourceAccessGuideCommand}" Margin="0,0,8,6" />
                        <Button Classes="ghost" Content="Voir le dépôt" Command="{Binding OpenUnrealSourceRepositoryCommand}" Margin="0,0,0,6" />
                      </WrapPanel>
                    </StackPanel>
                  </Border>
                </Grid>

                <Border IsVisible="{Binding HasPendingSourceEngineDownload}" Background="#2B2414" BorderBrush="#68572B" BorderThickness="1" CornerRadius="8" Padding="13">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                    <StackPanel>
                      <TextBlock Text="CLONE VOLUMINEUX — CONFIRMATION REQUISE" FontSize="10" FontWeight="Bold" Foreground="#E0B75A" />
                      <TextBlock Text="{Binding PendingSourceEngineDownloadSummary}" FontSize="10" Foreground="#D8C79C" Margin="0,5,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                      <Button Classes="accent" Content="Confirmer le clone" Command="{Binding ConfirmSourceEngineDownloadCommand}" />
                      <Button Classes="ghost" Content="Annuler" Command="{Binding CancelSourceEngineDownloadCommand}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="11">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                  <StackPanel>
                    <TextBlock Text="BIBLIOTHÈQUE FAB LOCALE" FontSize="10" FontWeight="Bold" Foreground="#65788D" />
                    <TextBlock Text="Packs Unreal, Unity, Godot ou CryEngine déjà acquis et extraits dans des dossiers que vous choisissez. La sélection route automatiquement vers le bon importeur. CyEngineHub ne lit ni les entitlements distants ni les chunks bruts du Vault Cache." FontSize="10" Foreground="#8294A8" Margin="0,5,0,0" TextWrapping="Wrap" />
                  </StackPanel>
                  <Border Grid.Column="1" Background="#17283B" CornerRadius="5" Padding="9,4" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FabLocalContentPackCount, StringFormat='{}{0} PACK(S)'}" FontSize="9" FontWeight="Bold" Foreground="#70A8FA" />
                  </Border>
                </Grid>
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                  <TextBox Classes="path" Text="{Binding ManualFabLibraryRoot}" PlaceholderText="D:\FabDownloads\PacksExtraits, dossier Content, Assets, projet.godot ou .cryproject" />
                  <Button Grid.Column="1" Classes="ghost" Content="Ajouter et analyser" Command="{Binding AddFabLocalLibraryRootCommand}" />
                  <Button Grid.Column="2" Classes="accent" Content="Actualiser la bibliothèque" Command="{Binding RefreshFabLocalLibraryCommand}" />
                </Grid>
                <TextBlock Text="{Binding FabLocalLibraryStatus}" FontSize="10" Foreground="#8294A8" TextWrapping="Wrap" />
                <TextBlock IsVisible="{Binding HasNoFabLocalContentPacks}" Text="Aucun pack Unreal, Unity, Godot ou CryEngine extrait dans le catalogue local." FontSize="10" Foreground="#718398" />
                <ListBox ItemsSource="{Binding FabLocalContentPacks}" MaxHeight="560" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                  <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                      <Setter Property="Padding" Value="0" />
                      <Setter Property="Background" Value="Transparent" />
                    </Style>
                  </ListBox.Styles>
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><VirtualizingStackPanel CacheLength="0.5" /></ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:FabLocalContentPackCardViewModel">
                      <Border Background="#0D141C" BorderBrush="#202C39" BorderThickness="1" CornerRadius="7" Padding="11" Margin="0,0,0,7">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                          <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" />
                              <Border Background="#17283B" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="{Binding Engine}" FontSize="8" FontWeight="Bold" Foreground="#70A8FA" />
                              </Border>
                              <Border Background="#17251F" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="{Binding Health}" FontSize="8" FontWeight="Bold" Foreground="#65CCA9" />
                              </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Inventory}" FontSize="9" Foreground="#A6B4C3" Margin="0,5,0,0" />
                            <TextBlock Text="{Binding Path}" FontSize="9" Foreground="#64768A" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding CollectionsLabel}" FontSize="9" Foreground="#65CFA1" Margin="0,3,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding IssueSummary}" IsVisible="{Binding HasIssues}" FontSize="9" Foreground="#D9A55C" Margin="0,3,0,0" TextWrapping="Wrap" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <Button Classes="accent" Content="Utiliser pour l’import" Command="{Binding UseForImportCommand}" />
                            <Button Classes="ghost" Content="Collections" Command="{Binding EditCollectionsCommand}" />
                            <Button Classes="ghost" Content="Dossier" Command="{Binding OpenFolderCommand}" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="11">
                <TextBlock Text="AJOUTER DU CONTENU FAB À UN PROJET" FontSize="10" FontWeight="Bold" Foreground="#65788D" />
                <TextBlock Text="Parcours recommandé : lancez le projet cible puis utilisez la fenêtre Fab intégrée. Pour un pack Unreal déjà téléchargé et extrait, CyEngineHub peut copier son Content avec staging, backup et confirmation." FontSize="11" Foreground="#A4B3C2" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="1.2*,Auto,Auto" ColumnSpacing="8">
                  <ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedFabProject}" PlaceholderText="Projet Unreal cible">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:ProjectCardViewModel">
                        <TextBlock Text="{Binding SelectionLabel}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button Grid.Column="1" Classes="accent" Content="Lancer le projet pour Fab" Command="{Binding LaunchFabProjectCommand}" />
                  <Button Grid.Column="2" Classes="ghost" Content="Guide d’export officiel" Command="{Binding OpenFabExportGuideCommand}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox Classes="path" Text="{Binding ManualFabContentSource}" PlaceholderText="Dossier Content, projet Fab extrait ou fichier .uproject source" />
                  <Button Grid.Column="1" Classes="accent" Content="Analyser l’import local" Command="{Binding PrepareFabImportCommand}" />
                </Grid>
                <TextBlock Text="{Binding FabProjectImportStatus}" FontSize="10" Foreground="#8294A8" TextWrapping="Wrap" />

                <Border IsVisible="{Binding HasPendingFabImport}" Background="#2B2414" BorderBrush="#68572B" BorderThickness="1" CornerRadius="8" Padding="13">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                    <StackPanel>
                      <TextBlock Text="COPIE DANS CONTENT — CONFIRMATION REQUISE" FontSize="10" FontWeight="Bold" Foreground="#E0B75A" />
                      <TextBlock Text="{Binding PendingFabImportSummary}" FontSize="10" Foreground="#D8C79C" Margin="0,5,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                      <Button Classes="accent" Content="Confirmer l’import" Command="{Binding ConfirmFabImportCommand}" />
                      <Button Classes="ghost" Content="Annuler" Command="{Binding CancelFabImportCommand}" />
                    </StackPanel>
                  </Grid>
                </Border>

                <Border IsVisible="{Binding HasPendingFabRollback}" Background="#321C20" BorderBrush="#74404A" BorderThickness="1" CornerRadius="8" Padding="13">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                    <StackPanel>
                      <TextBlock Text="RESTAURATION DE CONTENT — CONFIRMATION REQUISE" FontSize="10" FontWeight="Bold" Foreground="#F18A9B" />
                      <TextBlock Text="{Binding PendingFabRollbackSummary}" FontSize="10" Foreground="#E2B8BF" Margin="0,5,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                      <Button Classes="danger" Content="Confirmer l’annulation" Command="{Binding ConfirmFabRollbackCommand}" />
                      <Button Classes="ghost" Content="Conserver l’import" Command="{Binding CancelFabRollbackCommand}" />
                    </StackPanel>
                  </Grid>
                </Border>

                <Grid ColumnDefinitions="*,Auto" Margin="0,5,0,0">
                  <TextBlock Text="HISTORIQUE DES IMPORTS" FontSize="10" FontWeight="Bold" Foreground="#65788D" />
                  <TextBlock Grid.Column="1" Text="Reçus stockés dans Saved/CyEngineHubFabImports" FontSize="9" Foreground="#64768A" />
                </Grid>
                <TextBlock IsVisible="{Binding HasNoFabImportHistory}" Text="Aucun import CyEngineHub enregistré pour les projets découverts." FontSize="10" Foreground="#718398" />
                <ItemsControl ItemsSource="{Binding FabImportHistory}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FabImportHistoryCardViewModel">
                      <Border Background="#101923" BorderBrush="#203145" BorderThickness="1" CornerRadius="7" Padding="11" Margin="0,0,0,7">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                          <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="{Binding SourceName}" FontSize="11" FontWeight="SemiBold" />
                              <TextBlock Text="→" FontSize="10" Foreground="#60758B" />
                              <TextBlock Text="{Binding ProjectName}" FontSize="11" Foreground="#A8C9F2" />
                              <Border Background="#17283B" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="{Binding State}" FontSize="8" FontWeight="Bold" Foreground="#70A8FA" />
                              </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Summary}" FontSize="9" Foreground="#8194A8" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding ImportedAt, StringFormat='Importé le {0}'}" FontSize="9" Foreground="#64768A" Margin="0,2,0,0" />
                          </StackPanel>
                          <Button Grid.Column="1" IsVisible="{Binding CanRollback}" Classes="ghost" Content="Analyser l’annulation" Command="{Binding PrepareRollbackCommand}" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="11">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                  <StackPanel>
                    <TextBlock Text="IMPORT FAB LOCAL VERS UNITY" FontSize="10" FontWeight="Bold" Foreground="#65788D" />
                    <TextBlock Text="Importe un pack Fab/Unity déjà extrait dans Assets/CyEngineHubImports. Les GUID .meta sont conservés; scripts, shaders, plugins natifs et exécutables font refuser le pack." FontSize="10" Foreground="#A4B3C2" Margin="0,5,0,0" TextWrapping="Wrap" />
                  </StackPanel>
                  <Border Grid.Column="1" Background="#17283B" CornerRadius="5" Padding="9,4" VerticalAlignment="Center">
                    <TextBlock Text="UNITY · TRANSACTIONNEL" FontSize="9" FontWeight="Bold" Foreground="#70A8FA" />
                  </Border>
                </Grid>

                <Grid ColumnDefinitions="1.2*,Auto" ColumnSpacing="8">
                  <ComboBox ItemsSource="{Binding UnityFabProjects}" SelectedItem="{Binding SelectedUnityFabProject}" PlaceholderText="Projet Unity cible">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:LocalEngineProjectCardViewModel">
                        <TextBlock Text="{Binding Name}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button Grid.Column="1" Classes="ghost" Content="Lancer le projet Unity" Command="{Binding LaunchUnityFabProjectCommand}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox Classes="path" Text="{Binding ManualUnityFabContentSource}" PlaceholderText="Dossier du pack extrait ou dossier Assets source" />
                  <Button Grid.Column="1" Classes="accent" Content="Analyser l’import Unity" Command="{Binding PrepareUnityFabImportCommand}" />
                </Grid>
                <TextBlock Text="{Binding UnityFabImportStatus}" FontSize="10" Foreground="#8294A8" TextWrapping="Wrap" />

                <Border IsVisible="{Binding HasPendingUnityFabImport}" Background="#2B2414" BorderBrush="#68572B" BorderThickness="1" CornerRadius="8" Padding="13">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                    <StackPanel>
                      <TextBlock Text="COPIE DANS ASSETS — CONFIRMATION REQUISE" FontSize="10" FontWeight="Bold" Foreground="#E0B75A" />
                      <TextBlock Text="{Binding PendingUnityFabImportSummary}" FontSize="10" Foreground="#D8C79C" Margin="0,5,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                      <Button Classes="accent" Content="Confirmer l’import" Command="{Binding ConfirmUnityFabImportCommand}" />
                      <Button Classes="ghost" Content="Annuler" Command="{Binding CancelUnityFabImportCommand}" />
                    </StackPanel>
                  </Grid>
                </Border>

                <Border IsVisible="{Binding HasPendingUnityFabRollback}" Background="#321C20" BorderBrush="#74404A" BorderThickness="1" CornerRadius="8" Padding="13">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                    <StackPanel>
                      <TextBlock Text="RESTAURATION UNITY — CONFIRMATION REQUISE" FontSize="10" FontWeight="Bold" Foreground="#F18A9B" />
                      <TextBlock Text="{Binding PendingUnityFabRollbackSummary}" FontSize="10" Foreground="#E2B8BF" Margin="0,5,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                      <Button Classes="danger" Content="Confirmer l’annulation" Command="{Binding ConfirmUnityFabRollbackCommand}" />
                      <Button Classes="ghost" Content="Conserver l’import" Command="{Binding CancelUnityFabRollbackCommand}" />
                    </StackPanel>
                  </Grid>
                </Border>

                <Grid ColumnDefinitions="*,Auto" Margin="0,5,0,0">
                  <TextBlock Text="HISTORIQUE UNITY" FontSize="10" FontWeight="Bold" Foreground="#65788D" />
                  <TextBlock Grid.Column="1" Text="Reçus dans .cyenginehub/FabImports/Unity" FontSize="9" Foreground="#64768A" />
                </Grid>
                <TextBlock IsVisible="{Binding HasNoUnityFabImportHistory}" Text="Aucun import Unity enregistré pour les projets découverts." FontSize="10" Foreground="#718398" />
                <ItemsControl ItemsSource="{Binding UnityFabImportHistory}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:UnityFabImportHistoryCardViewModel">
                      <Border Background="#101923" BorderBrush="#203145" BorderThickness="1" CornerRadius="7" Padding="11" Margin="0,0,0,7">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                          <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="{Binding SourceName}" FontSize="11" FontWeight="SemiBold" />
                              <TextBlock Text="→" FontSize="10" Foreground="#60758B" />
                              <TextBlock Text="{Binding ProjectName}" FontSize="11" Foreground="#A8C9F2" />
                              <Border Background="#17283B" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="{Binding State}" FontSize="8" FontWeight="Bold" Foreground="#70A8FA" />
                              </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Summary}" FontSize="9" Foreground="#8194A8" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding ImportedAt, StringFormat='Importé le {0}'}" FontSize="9" Foreground="#64768A" Margin="0,2,0,0" />
                          </StackPanel>
                          <Button Grid.Column="1" IsVisible="{Binding CanRollback}" Classes="ghost" Content="Analyser l’annulation" Command="{Binding PrepareRollbackCommand}" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="11">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                  <StackPanel>
                    <TextBlock Text="IMPORT FAB LOCAL VERS GODOT" FontSize="10" FontWeight="Bold" Foreground="#65788D" />
                    <TextBlock Text="Importe les données portables d’un pack déjà extrait dans CyEngineHubImports. Les scripts, shaders, extensions natives et exécutables sont refusés; les scènes et ressources Godot natives restent ignorées dans ce premier profil sûr." FontSize="10" Foreground="#A4B3C2" Margin="0,5,0,0" TextWrapping="Wrap" />
                  </StackPanel>
                  <Border Grid.Column="1" Background="#17283B" CornerRadius="5" Padding="9,4" VerticalAlignment="Center">
                    <TextBlock Text="GODOT · TRANSACTIONNEL" FontSize="9" FontWeight="Bold" Foreground="#70A8FA" />
                  </Border>
                </Grid>

                <Grid ColumnDefinitions="1.2*,Auto" ColumnSpacing="8">
                  <ComboBox ItemsSource="{Binding GodotFabProjects}" SelectedItem="{Binding SelectedGodotFabProject}" PlaceholderText="Projet Godot cible">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:LocalEngineProjectCardViewModel">
                        <TextBlock Text="{Binding Name}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button Grid.Column="1" Classes="ghost" Content="Lancer le projet Godot" Command="{Binding LaunchGodotFabProjectCommand}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox Classes="path" Text="{Binding ManualGodotFabContentSource}" PlaceholderText="Dossier du pack extrait ou projet Godot source" />
                  <Button Grid.Column="1" Classes="accent" Content="Analyser l’import Godot" Command="{Binding PrepareGodotFabImportCommand}" />
                </Grid>
                <TextBlock Text="{Binding GodotFabImportStatus}" FontSize="10" Foreground="#8294A8" TextWrapping="Wrap" />

                <Border IsVisible="{Binding HasPendingGodotFabImport}" Background="#2B2414" BorderBrush="#68572B" BorderThickness="1" CornerRadius="8" Padding="13">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                    <StackPanel>
                      <TextBlock Text="COPIE DANS CYENGINEHUBIMPORTS — CONFIRMATION REQUISE" FontSize="10" FontWeight="Bold" Foreground="#E0B75A" />
                      <TextBlock Text="{Binding PendingGodotFabImportSummary}" FontSize="10" Foreground="#D8C79C" Margin="0,5,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                      <Button Classes="accent" Content="Confirmer l’import" Command="{Binding ConfirmGodotFabImportCommand}" />
                      <Button Classes="ghost" Content="Annuler" Command="{Binding CancelGodotFabImportCommand}" />
                    </StackPanel>
                  </Grid>
                </Border>

                <Border IsVisible="{Binding HasPendingGodotFabRollback}" Background="#321C20" BorderBrush="#74404A" BorderThickness="1" CornerRadius="8" Padding="13">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                    <StackPanel>
                      <TextBlock Text="RESTAURATION GODOT — CONFIRMATION REQUISE" FontSize="10" FontWeight="Bold" Foreground="#F18A9B" />
                      <TextBlock Text="{Binding PendingGodotFabRollbackSummary}" FontSize="10" Foreground="#E2B8BF" Margin="0,5,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                      <Button Classes="danger" Content="Confirmer l’annulation" Command="{Binding ConfirmGodotFabRollbackCommand}" />
                      <Button Classes="ghost" Content="Conserver l’import" Command="{Binding CancelGodotFabRollbackCommand}" />
                    </StackPanel>
                  </Grid>
                </Border>

                <Grid ColumnDefinitions="*,Auto" Margin="0,5,0,0">
                  <TextBlock Text="HISTORIQUE GODOT" FontSize="10" FontWeight="Bold" Foreground="#65788D" />
                  <TextBlock Grid.Column="1" Text="Reçus dans .cyenginehub/FabImports/Godot" FontSize="9" Foreground="#64768A" />
                </Grid>
                <TextBlock IsVisible="{Binding HasNoGodotFabImportHistory}" Text="Aucun import Godot enregistré pour les projets découverts." FontSize="10" Foreground="#718398" />
                <ItemsControl ItemsSource="{Binding GodotFabImportHistory}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GodotFabImportHistoryCardViewModel">
                      <Border Background="#101923" BorderBrush="#203145" BorderThickness="1" CornerRadius="7" Padding="11" Margin="0,0,0,7">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                          <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="{Binding SourceName}" FontSize="11" FontWeight="SemiBold" />
                              <TextBlock Text="→" FontSize="10" Foreground="#60758B" />
                              <TextBlock Text="{Binding ProjectName}" FontSize="11" Foreground="#A8C9F2" />
                              <Border Background="#17283B" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="{Binding State}" FontSize="8" FontWeight="Bold" Foreground="#70A8FA" />
                              </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Summary}" FontSize="9" Foreground="#8194A8" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding ImportedAt, StringFormat='Importé le {0}'}" FontSize="9" Foreground="#64768A" Margin="0,2,0,0" />
                          </StackPanel>
                          <Button Grid.Column="1" IsVisible="{Binding CanRollback}" Classes="ghost" Content="Analyser l’annulation" Command="{Binding PrepareRollbackCommand}" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="11">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                  <StackPanel>
                    <TextBlock Text="IMPORT FAB LOCAL VERS CRYENGINE" FontSize="10" FontWeight="Bold" Foreground="#65788D" />
                    <TextBlock Text="Importe les données portables d’un pack déjà extrait dans CyEngineHubImports. Les scripts, shaders, extensions natives et exécutables sont refusés; les scènes et ressources CryEngine natives restent ignorées dans ce premier profil sûr." FontSize="10" Foreground="#A4B3C2" Margin="0,5,0,0" TextWrapping="Wrap" />
                  </StackPanel>
                  <Border Grid.Column="1" Background="#17283B" CornerRadius="5" Padding="9,4" VerticalAlignment="Center">
                    <TextBlock Text="CRYENGINE · TRANSACTIONNEL" FontSize="9" FontWeight="Bold" Foreground="#70A8FA" />
                  </Border>
                </Grid>

                <Grid ColumnDefinitions="1.2*,Auto" ColumnSpacing="8">
                  <ComboBox ItemsSource="{Binding CryEngineFabProjects}" SelectedItem="{Binding SelectedCryEngineFabProject}" PlaceholderText="Projet CryEngine cible">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:LocalEngineProjectCardViewModel">
                        <TextBlock Text="{Binding Name}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button Grid.Column="1" Classes="ghost" Content="Lancer le projet CryEngine" Command="{Binding LaunchCryEngineFabProjectCommand}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox Classes="path" Text="{Binding ManualCryEngineFabContentSource}" PlaceholderText="Dossier du pack extrait ou projet CryEngine source" />
                  <Button Grid.Column="1" Classes="accent" Content="Analyser l’import CryEngine" Command="{Binding PrepareCryEngineFabImportCommand}" />
                </Grid>
                <TextBlock Text="{Binding CryEngineFabImportStatus}" FontSize="10" Foreground="#8294A8" TextWrapping="Wrap" />

                <Border IsVisible="{Binding HasPendingCryEngineFabImport}" Background="#2B2414" BorderBrush="#68572B" BorderThickness="1" CornerRadius="8" Padding="13">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                    <StackPanel>
                      <TextBlock Text="COPIE DANS CYENGINEHUBIMPORTS — CONFIRMATION REQUISE" FontSize="10" FontWeight="Bold" Foreground="#E0B75A" />
                      <TextBlock Text="{Binding PendingCryEngineFabImportSummary}" FontSize="10" Foreground="#D8C79C" Margin="0,5,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                      <Button Classes="accent" Content="Confirmer l’import" Command="{Binding ConfirmCryEngineFabImportCommand}" />
                      <Button Classes="ghost" Content="Annuler" Command="{Binding CancelCryEngineFabImportCommand}" />
                    </StackPanel>
                  </Grid>
                </Border>

                <Border IsVisible="{Binding HasPendingCryEngineFabRollback}" Background="#321C20" BorderBrush="#74404A" BorderThickness="1" CornerRadius="8" Padding="13">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                    <StackPanel>
                      <TextBlock Text="RESTAURATION CRYENGINE — CONFIRMATION REQUISE" FontSize="10" FontWeight="Bold" Foreground="#F18A9B" />
                      <TextBlock Text="{Binding PendingCryEngineFabRollbackSummary}" FontSize="10" Foreground="#E2B8BF" Margin="0,5,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                      <Button Classes="danger" Content="Confirmer l’annulation" Command="{Binding ConfirmCryEngineFabRollbackCommand}" />
                      <Button Classes="ghost" Content="Conserver l’import" Command="{Binding CancelCryEngineFabRollbackCommand}" />
                    </StackPanel>
                  </Grid>
                </Border>

                <Grid ColumnDefinitions="*,Auto" Margin="0,5,0,0">
                  <TextBlock Text="HISTORIQUE CRYENGINE" FontSize="10" FontWeight="Bold" Foreground="#65788D" />
                  <TextBlock Grid.Column="1" Text="Reçus dans .cyenginehub/FabImports/CryEngine" FontSize="9" Foreground="#64768A" />
                </Grid>
                <TextBlock IsVisible="{Binding HasNoCryEngineFabImportHistory}" Text="Aucun import CryEngine enregistré pour les projets découverts." FontSize="10" Foreground="#718398" />
                <ItemsControl ItemsSource="{Binding CryEngineFabImportHistory}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CryEngineFabImportHistoryCardViewModel">
                      <Border Background="#101923" BorderBrush="#203145" BorderThickness="1" CornerRadius="7" Padding="11" Margin="0,0,0,7">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                          <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="{Binding SourceName}" FontSize="11" FontWeight="SemiBold" />
                              <TextBlock Text="→" FontSize="10" Foreground="#60758B" />
                              <TextBlock Text="{Binding ProjectName}" FontSize="11" Foreground="#A8C9F2" />
                              <Border Background="#17283B" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="{Binding State}" FontSize="8" FontWeight="Bold" Foreground="#70A8FA" />
                              </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Summary}" FontSize="9" Foreground="#8194A8" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding ImportedAt, StringFormat='Importé le {0}'}" FontSize="9" Foreground="#64768A" Margin="0,2,0,0" />
                          </StackPanel>
                          <Button Grid.Column="1" IsVisible="{Binding CanRollback}" Classes="ghost" Content="Analyser l’annulation" Command="{Binding PrepareRollbackCommand}" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
              <Border Classes="metric">
                <StackPanel>
                  <TextBlock Text="CATALOGUE LOCAL" FontSize="9" FontWeight="Bold" Foreground="#5F7287" />
                  <TextBlock Text="{Binding EpicArtifactCount}" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0" />
                  <TextBlock Text="élément(s) Epic" FontSize="10" Foreground="#718398" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="metric">
                <StackPanel>
                  <TextBlock Text="VAULT CACHE" FontSize="9" FontWeight="Bold" Foreground="#5F7287" />
                  <TextBlock Text="{Binding EpicVaultItemCount}" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0" />
                  <TextBlock Text="dossier(s) locaux" FontSize="10" Foreground="#718398" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Classes="metric">
                <StackPanel>
                  <TextBlock Text="FAB PLUGINS" FontSize="9" FontWeight="Bold" Foreground="#5F7287" />
                  <TextBlock Text="{Binding FabPluginPackageCount}" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0" />
                  <TextBlock Text="package(s) locaux" FontSize="10" Foreground="#718398" />
                </StackPanel>
              </Border>
            </Grid>

            <Border Classes="card">
              <StackPanel>
                <TextBlock Text="CAPACITÉS ET LIMITES" FontSize="10" FontWeight="Bold" Foreground="#65788D" Margin="0,0,0,9" />
                <ItemsControl ItemsSource="{Binding EpicCapabilities}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:EpicCapabilityCardViewModel">
                      <Grid ColumnDefinitions="170,130,*" ColumnSpacing="14" Margin="0,6">
                        <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" />
                        <Border Grid.Column="1" Background="#17283B" CornerRadius="5" Padding="7,3" HorizontalAlignment="Left">
                          <TextBlock Text="{Binding State}" FontSize="9" FontWeight="Bold" Foreground="#70A8FA" />
                        </Border>
                        <TextBlock Grid.Column="2" Text="{Binding Description}" FontSize="10" Foreground="#8294A8" TextWrapping="Wrap" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <TextBlock Text="INSTALLATIONS ET INTÉGRATIONS LOCALES" FontSize="10" FontWeight="Bold" Foreground="#65788D" Margin="4,4,0,0" />
            <TextBlock Text="{Binding EpicStatusSummary}" FontSize="11" Foreground="#8294A8" Margin="4,0,0,0" TextWrapping="Wrap" />
            <TextBlock IsVisible="{Binding HasNoEpicArtifacts}" Text="Aucun inventaire en cache. Lancez l’actualisation locale pour lire les manifests Epic non secrets." Foreground="#718398" Margin="4,0,0,6" />
            <ItemsControl ItemsSource="{Binding EpicArtifacts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:EpicArtifactCardViewModel">
                  <Border Classes="card">
                    <Grid ColumnDefinitions="1.3*,0.6*,0.7*,1.7*,0.8*,Auto" ColumnSpacing="16">
                      <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                          <Border Background="#17283B" CornerRadius="5" Padding="7,3">
                            <TextBlock Text="{Binding Kind}" FontSize="9" FontWeight="Bold" Foreground="#70A8FA" />
                          </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding AppName}" FontSize="9" Foreground="#718398" Margin="0,4,0,0" />
                      </StackPanel>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="VERSION" FontSize="9" FontWeight="Bold" Foreground="#5F7287" />
                        <TextBlock Text="{Binding Version}" FontSize="11" Margin="0,3,0,0" />
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Text="ÉTAT" FontSize="9" FontWeight="Bold" Foreground="#5F7287" />
                        <TextBlock Text="{Binding Installation}" FontSize="10" Margin="0,3,0,0" Foreground="#55C7A6" />
                      </StackPanel>
                      <StackPanel Grid.Column="3">
                        <TextBlock Text="EMPLACEMENT" FontSize="9" FontWeight="Bold" Foreground="#5F7287" />
                        <TextBlock Text="{Binding Path}" FontSize="9" Foreground="#8395A8" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <StackPanel Grid.Column="4">
                        <TextBlock Text="SOURCE" FontSize="9" FontWeight="Bold" Foreground="#5F7287" />
                        <TextBlock Text="{Binding Source}" FontSize="9" Foreground="#8395A8" Margin="0,3,0,0" TextWrapping="Wrap" />
                      </StackPanel>
                      <Button Grid.Column="5" Classes="ghost" Content="Dossier" Command="{Binding OpenFolderCommand}" IsEnabled="{Binding CanOpenFolder}" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer IsVisible="{Binding IsStorageVisible}" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="14">
            <Border Classes="card">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel>
                  <TextBlock Text="ANALYSE LOCALE BORNÉE" FontSize="10" FontWeight="Bold" Foreground="#65788D" />
                  <TextBlock Text="{Binding StorageStatusSummary}" FontSize="12" Foreground="#A4B3C2" Margin="0,6,0,0" TextWrapping="Wrap" />
                  <TextBlock Text="Aucun scan au démarrage. Les jonctions sont ignorées et les résultats incomplets ne sont jamais proposés au nettoyage." FontSize="10" Foreground="#687B90" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Classes="accent"
                    Content="Analyser le stockage"
                    Command="{Binding RefreshStorageCommand}"
                    VerticalAlignment="Center" />
              </Grid>
            </Border>

            <Border
                IsVisible="{Binding HasPendingStorageCleanup}"
                Background="#321A1D"
                BorderBrush="#6A3037"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel>
                  <TextBlock Text="SUPPRESSION PERMANENTE — CONFIRMATION REQUISE" FontSize="10" FontWeight="Bold" Foreground="#EE8D94" />
                  <TextBlock Text="{Binding PendingStorageCleanupSummary}" FontSize="11" Foreground="#E4B9BC" Margin="0,5,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Button Classes="accent" Content="Confirmer Safe Clean" Command="{Binding ConfirmStorageCleanupCommand}" />
                  <Button Classes="ghost" Content="Annuler" Command="{Binding CancelStorageCleanupCommand}" />
                </StackPanel>
              </Grid>
            </Border>

            <Grid ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="10">
              <Border Classes="metric">
                <StackPanel>
                  <TextBlock Text="MOTEURS" FontSize="9" FontWeight="Bold" Foreground="#5F7287" />
                  <TextBlock Text="{Binding StorageEngineSize}" FontSize="19" Margin="0,6,0,0" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="metric">
                <StackPanel>
                  <TextBlock Text="PROJETS" FontSize="9" FontWeight="Bold" Foreground="#5F7287" />
                  <TextBlock Text="{Binding StorageProjectSize}" FontSize="19" Margin="0,6,0,0" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Classes="metric">
                <StackPanel>
                  <TextBlock Text="DDC" FontSize="9" FontWeight="Bold" Foreground="#5F7287" />
                  <TextBlock Text="{Binding StorageDdcSize}" FontSize="19" Margin="0,6,0,0" />
                </StackPanel>
              </Border>
              <Border Grid.Column="3" Classes="metric">
                <StackPanel>
                  <TextBlock Text="VAULT" FontSize="9" FontWeight="Bold" Foreground="#5F7287" />
                  <TextBlock Text="{Binding StorageVaultSize}" FontSize="19" Margin="0,6,0,0" />
                </StackPanel>
              </Border>
              <Border Grid.Column="4" Classes="metric">
                <StackPanel>
                  <TextBlock Text="GIT LFS" FontSize="9" FontWeight="Bold" Foreground="#5F7287" />
                  <TextBlock Text="{Binding StorageLfsSize}" FontSize="19" Margin="0,6,0,0" />
                </StackPanel>
              </Border>
              <Border Grid.Column="5" Classes="metric">
                <StackPanel>
                  <TextBlock Text="RÉCUPÉRABLE" FontSize="9" FontWeight="Bold" Foreground="#5F7287" />
                  <TextBlock Text="{Binding StorageReclaimableSize}" FontSize="19" Foreground="#55C7A6" Margin="0,6,0,0" />
                </StackPanel>
              </Border>
            </Grid>

            <TextBlock Text="VOLUMES" FontSize="10" FontWeight="Bold" Foreground="#65788D" Margin="4,4,0,0" />
            <TextBlock IsVisible="{Binding HasNoStorageDrives}" Text="Aucun volume dans le snapshot en cache." Foreground="#718398" Margin="4,0,0,6" />
            <ItemsControl ItemsSource="{Binding StorageDrives}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:StorageDriveCardViewModel">
                  <Border Classes="card">
                    <Grid ColumnDefinitions="1.1*,2*,0.8*,0.8*,Auto" ColumnSpacing="16">
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Health}" FontSize="9" Foreground="#D9A55C" Margin="0,3,0,0" />
                      </StackPanel>
                      <ProgressBar Grid.Column="1" Value="{Binding UsedPercent}" Maximum="100" Height="5" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="2">
                        <TextBlock Text="LIBRE" FontSize="9" FontWeight="Bold" Foreground="#5F7287" />
                        <TextBlock Text="{Binding Free}" FontSize="11" Margin="0,3,0,0" />
                      </StackPanel>
                      <StackPanel Grid.Column="3">
                        <TextBlock Text="TOTAL" FontSize="9" FontWeight="Bold" Foreground="#5F7287" />
                        <TextBlock Text="{Binding Total}" FontSize="11" Margin="0,3,0,0" />
                      </StackPanel>
                      <TextBlock Grid.Column="4" Text="{Binding UsedPercent, StringFormat='{}{0:0.#}% utilisé'}" FontSize="10" Foreground="#8294A8" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="EMPLACEMENTS ANALYSÉS" FontSize="10" FontWeight="Bold" Foreground="#65788D" Margin="4,4,0,0" />
            <TextBlock
                IsVisible="{Binding HasNoStorageEntries}"
                Text="Aucun inventaire en cache. Lancez l’analyse manuelle pour mesurer les chemins connus."
                Foreground="#718398"
                Margin="4,0,0,6" />
            <ItemsControl ItemsSource="{Binding StorageEntries}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:StorageEntryCardViewModel">
                  <Border Classes="card">
                    <Grid ColumnDefinitions="1.4*,0.7*,1.1*,1.1*,2*,Auto" ColumnSpacing="16">
                      <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Owner}" FontSize="14" FontWeight="SemiBold" />
                          <Border Background="#17283B" CornerRadius="5" Padding="7,3">
                            <TextBlock Text="{Binding Category}" FontSize="9" FontWeight="Bold" Foreground="#70A8FA" />
                          </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Name}" FontSize="10" Foreground="#8EA0B3" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding Path}" FontSize="9" Foreground="#687B90" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="TAILLE" FontSize="9" FontWeight="Bold" Foreground="#5F7287" />
                        <TextBlock Text="{Binding Size}" FontSize="15" FontWeight="SemiBold" Margin="0,3,0,0" />
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Text="CONTENU" FontSize="9" FontWeight="Bold" Foreground="#5F7287" />
                        <TextBlock Text="{Binding Counts}" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap" />
                      </StackPanel>
                      <StackPanel Grid.Column="3">
                        <TextBlock Text="MODIFIÉ" FontSize="9" FontWeight="Bold" Foreground="#5F7287" />
                        <TextBlock Text="{Binding LastModified}" FontSize="10" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding Health}" FontSize="9" Foreground="#D9A55C" Margin="0,3,0,0" />
                      </StackPanel>
                      <StackPanel Grid.Column="4">
                        <TextBlock Text="DIAGNOSTIC" FontSize="9" FontWeight="Bold" Foreground="#5F7287" />
                        <TextBlock Text="{Binding Diagnostic}" FontSize="10" Foreground="#8395A8" Margin="0,3,0,0" TextWrapping="Wrap" />
                      </StackPanel>
                      <StackPanel Grid.Column="5" Width="155" Spacing="7" VerticalAlignment="Center">
                        <Button Classes="ghost" Content="Dossier" Command="{Binding OpenFolderCommand}" />
                        <Button Classes="accent" Content="Préparer Safe Clean" Command="{Binding PrepareCleanupCommand}" IsVisible="{Binding CanClean}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <Grid IsVisible="{Binding IsBuildsVisible}" RowDefinitions="Auto,Auto,*">
          <Border Classes="card" Margin="0,0,0,14">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Text="{Binding ActiveBuildTitle}" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="{Binding BuildSummary}" FontSize="11" Foreground="#8193A7" Margin="0,6,0,0" />
              </StackPanel>
              <Button Grid.Column="1" Classes="ghost" Content="Voir les tâches" Command="{Binding ShowTasksCommand}" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <Border Grid.Row="1" Classes="card" Margin="0,0,0,14" Padding="16">
            <Grid ColumnDefinitions="1.05*,1.35*" ColumnSpacing="18">
              <StackPanel Spacing="9">
                <TextBlock Text="PRESETS" FontSize="10" FontWeight="Bold" Foreground="#65788D" />
                <ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedPresetProject}" PlaceholderText="Projet cible">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProjectCardViewModel">
                      <TextBlock Text="{Binding SelectionLabel}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <ListBox Classes="catalog" ItemsSource="{Binding BuildPresets}" MaxHeight="220">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:BuildPresetCardViewModel">
                      <Border Background="#101721" CornerRadius="7" Padding="9" Margin="0,2">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                          <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                              <TextBlock Text="{Binding Kind}" FontSize="9" Foreground="#65A7F5" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding Summary}" FontSize="10" Foreground="#778A9F" Margin="0,4,0,0" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Classes="accent" Content="Exécuter" Command="{Binding RunCommand}" />
                            <Button Classes="ghost" Content="Modifier" Command="{Binding EditCommand}" />
                            <Button Classes="ghost" Content="Supprimer" Command="{Binding RequestDeleteCommand}" IsVisible="{Binding IsCustom}" />
                          </StackPanel>
                          <Border Grid.ColumnSpan="2" Background="#321A1D" CornerRadius="5" Padding="7" Margin="0,7,0,0" IsVisible="{Binding IsDeleteConfirmationVisible}" VerticalAlignment="Bottom">
                            <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Right">
                              <TextBlock Text="Supprimer ce preset ?" Foreground="#F0B4B7" VerticalAlignment="Center" />
                              <Button Classes="ghost" Content="Confirmer" Command="{Binding ConfirmDeleteCommand}" />
                              <Button Classes="ghost" Content="Annuler" Command="{Binding CancelDeleteCommand}" />
                            </StackPanel>
                          </Border>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>

              <StackPanel Grid.Column="1" Spacing="8">
                <Grid ColumnDefinitions="2*,1*,1*,1*" ColumnSpacing="8">
                  <TextBox Classes="path" Text="{Binding PresetName}" PlaceholderText="Nom du preset" />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding PresetKinds}" SelectedItem="{Binding PresetKind}" />
                  <TextBox Grid.Column="2" Classes="path" Text="{Binding PresetPlatform}" PlaceholderText="Plateforme" />
                  <TextBox Grid.Column="3" Classes="path" Text="{Binding PresetConfiguration}" PlaceholderText="Configuration" />
                </Grid>
                <Grid ColumnDefinitions="2*,1*,1*,1*" ColumnSpacing="8">
                  <TextBox Classes="path" Text="{Binding PresetTarget}" PlaceholderText="Target, ex. {Project}Editor" />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding PresetActions}" SelectedItem="{Binding PresetAction}" />
                  <TextBox Grid.Column="2" Classes="path" Text="{Binding PresetMaximumParallelActions}" PlaceholderText="Jobs max" />
                  <TextBox Grid.Column="3" Classes="path" Text="{Binding PresetCookFlavor}" PlaceholderText="Cook flavor" />
                </Grid>
                <WrapPanel>
                  <CheckBox Content="Attacher .uproject" IsChecked="{Binding PresetAttachProject}" Margin="0,0,12,5" />
                  <CheckBox Content="Cook" IsChecked="{Binding PresetCook}" Margin="0,0,12,5" />
                  <CheckBox Content="Stage" IsChecked="{Binding PresetStage}" Margin="0,0,12,5" />
                  <CheckBox Content="Package" IsChecked="{Binding PresetPackage}" Margin="0,0,12,5" />
                  <CheckBox Content="Archive" IsChecked="{Binding PresetArchive}" Margin="0,0,12,5" />
                  <CheckBox Content="Pak" IsChecked="{Binding PresetPak}" Margin="0,0,12,5" />
                  <CheckBox Content="IoStore" IsChecked="{Binding PresetIoStore}" Margin="0,0,12,5" />
                  <CheckBox Content="Compressé" IsChecked="{Binding PresetCompressed}" Margin="0,0,12,5" />
                  <CheckBox Content="Distribution" IsChecked="{Binding PresetDistribution}" Margin="0,0,12,5" />
                  <CheckBox Content="Prérequis" IsChecked="{Binding PresetIncludePrerequisites}" Margin="0,0,12,5" />
                </WrapPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                  <Button Classes="ghost" Content="Nouveau" Command="{Binding NewPresetCommand}" />
                  <Button Classes="accent" Content="Enregistrer le preset" Command="{Binding SavePresetCommand}" />
                </StackPanel>
              </StackPanel>
            </Grid>
          </Border>
          <Border Grid.Row="2" Background="#080B0F" BorderBrush="#202C39" BorderThickness="1" CornerRadius="10" Padding="10">
            <Grid>
              <TextBlock
                  IsVisible="{Binding HasNoBuildLogs}"
                  Text="Lancez un Build Editor, Generate Project Files ou Package depuis un moteur/projet."
                  Foreground="#627488"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center" />
              <ListBox Classes="catalog" ItemsSource="{Binding BuildLogs}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:BuildLogItemViewModel">
                    <Grid ColumnDefinitions="68,86,*" ColumnSpacing="10" Margin="5,2">
                      <TextBlock Text="{Binding Timestamp}" FontFamily="Consolas" FontSize="10" Foreground="#586B7F" />
                      <TextBlock Grid.Column="1" Text="{Binding Severity}" FontFamily="Consolas" FontSize="10" Foreground="#E0A84E" />
                      <SelectableTextBlock Grid.Column="2" Text="{Binding Text}" FontFamily="Consolas" FontSize="11" Foreground="#B8C5D2" TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>
        </Grid>

        <Grid IsVisible="{Binding IsTasksVisible}">
          <TextBlock
              IsVisible="{Binding HasNoTasks}"
              Text="Aucune tâche exécutée pendant cette session."
              Foreground="#718398"
              HorizontalAlignment="Center"
              VerticalAlignment="Center" />
          <ListBox Classes="catalog" ItemsSource="{Binding Tasks}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:TaskItemViewModel">
                <Border Classes="card">
                  <Grid ColumnDefinitions="*,140,100,Auto" ColumnSpacing="16">
                    <StackPanel>
                      <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Message}" FontSize="11" Foreground="#778A9F" Margin="0,5,0,0" />
                      <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="3" Margin="0,12,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Category}" FontSize="9" FontWeight="Bold" Foreground="#607286" />
                      <TextBlock Text="{Binding Status}" FontSize="12" Margin="0,5,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Duration}" FontSize="11" Foreground="#778A9F" VerticalAlignment="Center" />
                    <Button
                        Grid.Column="3"
                        Classes="ghost"
                        Content="Annuler"
                        Command="{Binding CancelCommand}"
                        IsVisible="{Binding CanCancel}"
                        VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>

        <Grid IsVisible="{Binding IsLogsVisible}">
          <Border Classes="card">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,9">
                <StackPanel>
                  <TextBlock Text="RAW LOG" FontSize="14" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding RawLogFilePath}" FontSize="9" Foreground="#718398" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="1" Classes="ghost" Content="Recharger" Command="{Binding RefreshRawLogCommand}" />
                <Button Grid.Column="2" Classes="ghost" Content="Ouvrir le dossier" Command="{Binding OpenRawLogFolderCommand}" />
              </Grid>
              <TextBox Grid.Row="1" Classes="path" Text="{Binding RawLogSearchQuery}" PlaceholderText="Rechercher dans le journal RAW…" />
              <ListBox x:Name="RawLogList" Grid.Row="2" ItemsSource="{Binding FilteredRawLogEntries}" Background="#080B0F" BorderBrush="#243448" BorderThickness="1" Padding="8" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate><VirtualizingStackPanel CacheLength="0.5" /></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0,1" />
                    <Setter Property="Background" Value="Transparent" />
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:RawLogEntryViewModel">
                    <SelectableTextBlock Text="{Binding Text}" Foreground="{Binding Foreground}" FontFamily="Consolas" FontSize="10" FontWeight="Normal" TextWrapping="NoWrap" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>
        </Grid>

        <Grid IsVisible="{Binding IsSettingsVisible}" RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="0,0,0,16">
            <Button Classes="ghost" Content="← Retour" Command="{Binding CloseSettingsCommand}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="PARAMÈTRES CYENGINEHUB" FontSize="10" FontWeight="Bold" Foreground="#65788D" />
              <TextBlock Text="Connexions, moteurs, marketplaces, bibliothèque, stockage et diagnostic" FontSize="11" Foreground="#8294A8" Margin="0,3,0,0" />
            </StackPanel>
          </Grid>
          <Grid Grid.Row="1" ColumnDefinitions="230,*" ColumnSpacing="16">
            <Border Classes="card" Padding="10">
              <ListBox Classes="settings-nav" ItemsSource="{Binding SettingsCategories}" SelectedItem="{Binding SelectedSettingsCategory}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:SettingsCategoryOptionViewModel">
                    <StackPanel>
                      <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Description}" FontSize="9" Foreground="#718398" Margin="0,3,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="14">
                <StackPanel IsVisible="{Binding IsSettingsConnectionsSelected}" Spacing="14">
                  <Border Background="#132335" BorderBrush="#285682" BorderThickness="1" CornerRadius="10" Padding="18">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                      <StackPanel>
                        <TextBlock Text="CONNEXIONS ET SÉCURITÉ" FontSize="10" FontWeight="Bold" Foreground="#70A8FA" />
                        <TextBlock Text="Chaque service dispose de sa propre page. Les indicateurs du bandeau ouvrent directement la connexion correspondante." FontSize="10" Foreground="#BCD0E6" Margin="0,6,0,0" TextWrapping="Wrap" />
                      </StackPanel>
                      <Button Grid.Column="1" Classes="ghost" Content="Epic" Command="{Binding ShowEpicConnectionSettingsCommand}" IsVisible="{Binding IsEpicConnectionEnabled}" />
                      <Button Grid.Column="2" Classes="ghost" Content="Fab" Command="{Binding ShowFabConnectionSettingsCommand}" IsVisible="{Binding IsFabConnectionEnabled}" />
                      <Button Grid.Column="3" Classes="ghost" Content="Git" Command="{Binding ShowGitConnectionSettingsCommand}" IsVisible="{Binding IsGitConnectionEnabled}" />
                      <Button Grid.Column="4" Classes="ghost" Content="Unity" Command="{Binding ShowUnityConnectionSettingsCommand}" IsVisible="{Binding IsUnityConnectionEnabled}" />
                      <Button Grid.Column="5" Classes="ghost" Content="Megascans" Command="{Binding ShowQuixelConnectionSettingsCommand}" IsVisible="{Binding IsQuixelConnectionEnabled}" />
                    </Grid>
                  </Border>

                  <Border Classes="card">
                    <StackPanel Spacing="9">
                      <TextBlock Text="CONNEXIONS DISPONIBLES" FontSize="10" FontWeight="Bold" Foreground="#65788D" />
                      <TextBlock Text="Désactiver une connexion masque son indicateur et ses sources de Bibliothèque sans supprimer les données locales." FontSize="10" Foreground="#8294A8" TextWrapping="Wrap" />
                      <ItemsControl ItemsSource="{Binding ConnectionModules}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ConnectionModuleCardViewModel"><Border Background="#0D141C" BorderBrush="#202C39" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,6"><Grid ColumnDefinitions="150,*,Auto" ColumnSpacing="12"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Status}" FontSize="8" Foreground="#70A8FA" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding Description}" FontSize="9" Foreground="#8294A8" TextWrapping="Wrap" VerticalAlignment="Center" /><Button Grid.Column="2" Classes="ghost" Content="{Binding ToggleLabel}" Command="{Binding ToggleEnabledCommand}" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel>
                  </Border>

                  <StackPanel IsVisible="{Binding IsEpicConnectionPageSelected}" Spacing="14">
                    <Border Classes="card">
                      <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                          <StackPanel>
                            <TextBlock Text="CONNEXION EPIC" FontSize="10" FontWeight="Bold" Foreground="#65788D" />
                            <TextBlock Text="{Binding EpicConnectionStatus}" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,0" />
                            <TextBlock Text="{Binding DirectFabStatusSummary}" FontSize="10" Foreground="#A8C9F2" Margin="0,6,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding DirectFabAccount}" FontSize="10" Foreground="#65CCA9" Margin="0,4,0,0" />
                          </StackPanel>
                          <Button Grid.Column="1" Classes="ghost" Content="Déconnecter" Command="{Binding DisconnectDirectFabCommand}" IsVisible="{Binding IsDirectFabConnected}" VerticalAlignment="Center" />
                        </Grid>
                        <Border IsVisible="{Binding !IsDirectFabConnected}" Background="#0D141C" BorderBrush="#202C39" BorderThickness="1" CornerRadius="8" Padding="14">
                          <StackPanel Spacing="10">
                            <TextBlock Text="AUTORISATION AUTOMATISÉE" FontSize="10" FontWeight="Bold" Foreground="#70A8FA" />
                            <TextBlock Text="Ouvrez la page Epic et connectez-vous. Quand la réponse JSON apparaît, faites Ctrl+A puis Ctrl+C : CyEngineHub détecte le code dans le presse-papiers, l’échange et termine la connexion sans collage ni second bouton." FontSize="10" Foreground="#A4B3C2" TextWrapping="Wrap" />
                            <Button Classes="accent" Content="Ouvrir l’autorisation Epic" Command="{Binding OpenDirectFabAuthorizationCommand}" HorizontalAlignment="Left" />
                            <TextBlock Text="Le navigateur système protège sa page : CyEngineHub ne peut pas lire son contenu sans votre copie. Le mot de passe n’est jamais accessible à l’application." FontSize="9" Foreground="#D9A55C" TextWrapping="Wrap" />
                            <Expander Header="Mode manuel de secours">
                              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,8,0,0">
                                <TextBox Classes="path" Text="{Binding FabAuthorizationCode}" PlaceholderText="authorizationCode ou réponse JSON Epic" />
                                <Button Grid.Column="1" Classes="ghost" Content="Connecter" Command="{Binding ConnectDirectFabCommand}" />
                              </Grid>
                            </Expander>
                          </StackPanel>
                        </Border>
                      </StackPanel>
                    </Border>
                    <Border Classes="card">
                      <StackPanel>
                        <TextBlock Text="STOCKAGE SÉCURISÉ" FontSize="10" FontWeight="Bold" Foreground="#65788D" />
                        <TextBlock Text="La session est découpée en segments sous la limite du Gestionnaire d’identification Windows, puis contrôlée par manifeste et empreinte d’intégrité. Aucun mot de passe Epic n’est stocké." FontSize="10" Foreground="#8294A8" Margin="0,6,0,0" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </StackPanel>

                  <StackPanel IsVisible="{Binding IsFabConnectionPageSelected}" Spacing="14">
                    <Border Classes="card">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                        <StackPanel>
                          <TextBlock Text="CONNEXION FAB" FontSize="10" FontWeight="Bold" Foreground="#65788D" />
                          <TextBlock Text="{Binding FabConnectionStatus}" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,0" />
                          <TextBlock Text="{Binding DirectFabStatusSummary}" FontSize="10" Foreground="#A8C9F2" Margin="0,6,0,0" TextWrapping="Wrap" />
                          <TextBlock Text="Fab réutilise l’autorisation Epic directe. Cette page ne contient que son état et les actions liées à My Library." FontSize="10" Foreground="#8294A8" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                          <Button Classes="accent" Content="Configurer le compte Epic" Command="{Binding ShowEpicConnectionSettingsCommand}" IsVisible="{Binding !IsDirectFabConnected}" />
                          <Button Classes="accent refresh-running" Command="{Binding RefreshDirectFabLibraryCommand}" IsVisible="{Binding IsDirectFabConnected}" IsEnabled="{Binding !IsFabLibraryRefreshing}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <Path Width="15" Height="15" Stretch="Uniform" Data="M 7,1 A 6,6 0 1 1 1,7" Stroke="#EAF4FF" StrokeThickness="2" StrokeLineCap="Round" IsVisible="{Binding IsFabLibraryRefreshing}" RenderTransformOrigin="50%,50%">
                                <Path.RenderTransform><RotateTransform Angle="{Binding FabRefreshSpinnerAngle}" /></Path.RenderTransform>
                              </Path>
                              <TextBlock Text="{Binding FabRefreshButtonLabel}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                          <Button Classes="ghost" Content="Ouvrir la Bibliothèque Fab" Command="{Binding ShowLibraryFabCommand}" IsVisible="{Binding IsDirectFabConnected}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </StackPanel>

                  <StackPanel IsVisible="{Binding IsGitConnectionPageSelected}" Spacing="14">
                    <Border Classes="card">
                      <StackPanel Spacing="9">
                        <TextBlock Text="CONNEXION GIT" FontSize="10" FontWeight="Bold" Foreground="#65788D" />
                        <TextBlock Text="{Binding GitConnectionStatus}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Les dépôts et remotes sont analysés localement. Les identifiants restent gérés par Git Credential Manager ou votre agent SSH." FontSize="10" Foreground="#8294A8" TextWrapping="Wrap" />
                        <Button Classes="accent" Content="Configurer les dépôts" Command="{Binding ShowGitCommand}" HorizontalAlignment="Left" />
                      </StackPanel>
                    </Border>
                  </StackPanel>

                  <StackPanel IsVisible="{Binding IsUnityConnectionPageSelected}" Spacing="14">
                    <Border Classes="card">
                      <StackPanel Spacing="9">
                        <TextBlock Text="CONNEXION UNITY ASSET STORE" FontSize="10" FontWeight="Bold" Foreground="#65788D" />
                        <TextBlock Text="{Binding UnityStoreConnectionStatus}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Le connecteur authentifié Unity sera isolé ici. Les réglages du compte restent dans Connexions et son catalogue aura sa propre source Bibliothèque." FontSize="10" Foreground="#8294A8" TextWrapping="Wrap" />
                        <Button Classes="accent" Content="Ouvrir Unity Asset Store" Command="{Binding OpenUnityAssetStoreCommand}" HorizontalAlignment="Left" />
                      </StackPanel>
                    </Border>
                  </StackPanel>

                  <StackPanel IsVisible="{Binding IsQuixelConnectionPageSelected}" Spacing="14">
                    <Border Classes="card">
                      <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                          <StackPanel Spacing="6">
                            <TextBlock Text="CONNEXION EPIC → QUIXEL / MEGASCANS" FontSize="10" FontWeight="Bold" Foreground="#65788D" />
                            <TextBlock Text="{Binding QuixelConnectionStatus}" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding QuixelStatusSummary}" FontSize="10" Foreground="#A8C9F2" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding QuixelAccount}" FontSize="10" Foreground="#65CCA9" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                            <Button Classes="ghost" Content="Déconnecter" Command="{Binding DisconnectQuixelCommand}" IsVisible="{Binding IsQuixelConnected}" />
                            <Button Classes="accent" Content="Ouvrir la bibliothèque" Command="{Binding ShowLibraryQuixelCommand}" IsVisible="{Binding IsQuixelConnected}" />
                          </StackPanel>
                        </Grid>

                        <Border IsVisible="{Binding !IsQuixelConnected}" Background="#0D141C" BorderBrush="#202C39" BorderThickness="1" CornerRadius="8" Padding="14">
                          <StackPanel Spacing="10">
                            <TextBlock Text="AUTORISATION OFFICIELLE UTILISÉE PAR BRIDGE" FontSize="10" FontWeight="Bold" Foreground="#70A8FA" />
                            <TextBlock Text="Cette connexion vise la bibliothèque Quixel historique, distincte de Fab. Cliquez sur Autoriser, connectez votre compte Epic, puis copiez la réponse affichée avec Ctrl+A / Ctrl+C. CyEngineHub détectera le code et terminera l’échange automatiquement." FontSize="10" Foreground="#A4B3C2" TextWrapping="Wrap" />
                            <WrapPanel>
                              <Button Classes="accent" Content="1 · Autoriser Epic/Quixel" Command="{Binding OpenQuixelAuthorizationCommand}" Margin="0,0,8,0" />
                              <Button Classes="ghost" Content="Essayer la session Epic déjà connectée" Command="{Binding ConnectQuixelFromEpicCommand}" IsVisible="{Binding IsDirectFabConnected}" />
                            </WrapPanel>
                            <TextBlock Text="Le raccourci peut être refusé par Epic selon l’état du compte. L’autorisation officielle ci-dessus reste la méthode principale. CyEngineHub ne lit ni mot de passe ni cookies du navigateur." FontSize="9" Foreground="#D9A55C" TextWrapping="Wrap" />
                            <Expander Header="Mode manuel de secours">
                              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,8,0,0">
                                <TextBox Classes="path" Text="{Binding QuixelAuthorizationCode}" PlaceholderText="Code, URL de retour ou réponse JSON Epic/Quixel" />
                                <Button Grid.Column="1" Classes="ghost" Content="Connecter" Command="{Binding ConnectQuixelCommand}" />
                              </Grid>
                            </Expander>
                          </StackPanel>
                        </Border>
                        <TextBlock Text="La session Quixel est stockée séparément dans le Gestionnaire d’identification Windows. Elle donne accès à /v1/assets/acquired puis résout les fiches du catalogue Megascans public." FontSize="9" Foreground="#718398" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </StackPanel>

                <StackPanel IsVisible="{Binding IsSettingsEnginesSelected}" Spacing="14">
                  <Border Classes="card">
                    <StackPanel Spacing="9">
                      <Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="MOTEURS DISPONIBLES" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="Activez les providers affichés dans Moteurs, Projets et Plugins." FontSize="10" Foreground="#8294A8" Margin="0,4,0,0" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding ActiveEngineModuleCount, StringFormat='{}{0} actif(s)'}" FontSize="10" Foreground="#65CCA9" VerticalAlignment="Center" /></Grid>
                      <ItemsControl ItemsSource="{Binding EngineModules}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:EngineModuleCardViewModel"><Border Background="#0D141C" BorderBrush="#202C39" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,0,7"><Grid ColumnDefinitions="170,*,Auto" ColumnSpacing="12"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Vendor}" FontSize="9" Foreground="#718398" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding Summary}" FontSize="9" Foreground="#A6B4C3" TextWrapping="Wrap" VerticalAlignment="Center" /><Button Grid.Column="2" Classes="ghost" Content="{Binding ToggleLabel}" Command="{Binding ToggleEnabledCommand}" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel>
                  </Border>
                  <Border Classes="card"><StackPanel Spacing="10"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><StackPanel><TextBlock Text="Ajouter un moteur" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="Sélectionnez un dossier racine ou l’exécutable de l’éditeur." Foreground="#7F91A5" FontSize="11" /></StackPanel><Button Grid.Column="1" Classes="ghost" Content="Restaurer les moteurs retirés" Command="{Binding RestoreHiddenEnginesCommand}" /></Grid><Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><TextBox Classes="path" Text="{Binding ManualEnginePath}" PlaceholderText="Chemin du moteur" /><Button Grid.Column="1" Classes="accent" Content="Ajouter" Command="{Binding AddEnginePathCommand}" /></Grid></StackPanel></Border>
                </StackPanel>

                <StackPanel IsVisible="{Binding IsSettingsProjectProfilesSelected}" Spacing="14">
                  <Border Background="#132335" BorderBrush="#285682" BorderThickness="1" CornerRadius="10" Padding="18">
                    <StackPanel Spacing="6">
                      <TextBlock Text="PROFILS DE PROJET UNREAL" FontSize="16" FontWeight="SemiBold" />
                      <TextBlock Text="Préparez vos profils avant de créer un projet : plugins, configuration INI et import depuis un projet existant." FontSize="11" Foreground="#BCD0E6" TextWrapping="Wrap" />
                      <TextBlock Text="Enregistrer un profil ne crée aucun projet et ne modifie pas les projets existants. Il sera disponible dans Nouveau projet → Projet &amp; profil." FontSize="10" Foreground="#65CCA9" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                  <Border Classes="card" Margin="0" Padding="16">
                    <StackPanel Spacing="10">
                      <TextBlock Text="MOTEUR DE RÉFÉRENCE POUR LES PLUGINS" FontSize="10" FontWeight="Bold" Foreground="#70A8FA" />
                      <ComboBox ItemsSource="{Binding ProjectCreationEngines}" SelectedItem="{Binding SelectedProjectCreationEngine}" PlaceholderText="Choisir une version Unreal installée" HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ProjectCreationEngineOptionViewModel">
                          <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Path}" FontSize="9" Foreground="#718398" TextTrimming="CharacterEllipsis" /></StackPanel>
                        </DataTemplate></ComboBox.ItemTemplate>
                      </ComboBox>
                      <TextBlock Text="{Binding ManagedProjectProfileEngineSummary}" Foreground="#8294A8" FontSize="10" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                  <Border Classes="card" Margin="0" Padding="16">
                    <StackPanel Spacing="12">
                      <WrapPanel>
                        <Button Classes="accent" Content="Nouveau profil" Command="{Binding NewProjectProfileCommand}" Margin="0,0,8,6" />
                        <Button Classes="ghost" Content="{Binding ManagedProjectProfileEditLabel}" Command="{Binding EditManagedProjectProfileCommand}" IsEnabled="{Binding HasManagedProjectProfile}" Margin="0,0,8,6" />
                        <Button Classes="ghost" Content="Dupliquer" Command="{Binding DuplicateManagedProjectProfileCommand}" IsEnabled="{Binding HasManagedProjectProfile}" Margin="0,0,0,6" />
                      </WrapPanel>
                      <ListBox ItemsSource="{Binding ProjectCreationConfigurations}" SelectedItem="{Binding SelectedManagedProjectProfile}" Height="280" Background="#0B121A" BorderBrush="#26394C" BorderThickness="1" CornerRadius="8" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="10,8" /></Style></ListBox.Styles>
                        <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemTemplate><DataTemplate x:DataType="vm:ProjectCreationConfigurationOptionViewModel">
                          <StackPanel Spacing="5">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" Text="{Binding Origin}" FontSize="8" Foreground="#65CCA9" VerticalAlignment="Center" /></Grid>
                            <TextBlock Text="{Binding Inventory}" FontSize="9" Foreground="#8294A8" TextWrapping="Wrap" />
                          </StackPanel>
                        </DataTemplate></ListBox.ItemTemplate>
                      </ListBox>
                      <StackPanel DataContext="{Binding SelectedManagedProjectProfile}" x:DataType="vm:ProjectCreationConfigurationOptionViewModel" Spacing="5">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#A4B3C2" TextWrapping="Wrap" />
                      </StackPanel>
                      <TextBlock Text="Les modèles intégrés sont conservés. Personnalisez une copie ; vos profils peuvent ensuite être modifiés, dupliqués ou supprimés depuis l’éditeur." FontSize="10" Foreground="#8294A8" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </StackPanel>

                <StackPanel IsVisible="{Binding IsSettingsLibrarySelected}" Spacing="14">
                  <Border Classes="card">
                    <StackPanel Spacing="10">
                      <TextBlock Text="CACHE DES CATALOGUES ET MINIATURES" FontSize="16" FontWeight="SemiBold" />
                      <TextBlock Text="Choisissez un dossier de cache indépendant pour Fab, Megascans et Unity dans Marketplaces. Il contient le catalogue et les images chargées en arrière-plan. Les téléchargements et bibliothèques se règlent au même endroit." FontSize="10" Foreground="#8294A8" TextWrapping="Wrap" />
                      <Button Classes="accent" Content="Configurer les caches par marketplace" Command="{Binding ConfigureMarketplaceCachesCommand}" HorizontalAlignment="Left" />
                    </StackPanel>
                  </Border>
                  <Border Classes="card"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><StackPanel><TextBlock Text="DÉTECTION DES PROJETS" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="La détection automatique peut être désactivée sans bloquer les ajouts manuels." FontSize="10" Foreground="#8294A8" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel><Button Grid.Column="1" Classes="ghost" Content="{Binding AutoDiscoverProjectsLabel}" Command="{Binding ToggleAutoDiscoverProjectsCommand}" VerticalAlignment="Center" /></Grid></Border>
                  <Border Classes="card"><StackPanel Spacing="10"><TextBlock Text="Ajouter un emplacement de projets" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="La recherche bornée ignore Content, .git, Saved, Intermediate et Binaries." Foreground="#7F91A5" FontSize="11" /><Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><TextBox Classes="path" Text="{Binding ManualProjectRoot}" PlaceholderText="Dossier parent des projets" /><Button Grid.Column="1" Classes="accent" Content="Ajouter" Command="{Binding AddProjectRootCommand}" /></Grid></StackPanel></Border>
                </StackPanel>

                <StackPanel IsVisible="{Binding IsSettingsMarketplacesSelected}" Spacing="14">
                  <Border Background="#132335" BorderBrush="#285682" BorderThickness="1" CornerRadius="10" Padding="18">
                    <StackPanel Spacing="6">
                      <TextBlock Text="MARKETPLACES" FontSize="10" FontWeight="Bold" Foreground="#70A8FA" />
                      <TextBlock Text="Chaque marketplace conserve son propre catalogue, son actualisation et son profil de compression." FontSize="10" Foreground="#BCD0E6" TextWrapping="Wrap" />
                      <TextBlock Text="Le cache reste immédiatement disponible pendant que l’actualisation s’effectue en arrière-plan." FontSize="9" Foreground="#8294A8" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                  <Border Classes="card">
                    <StackPanel Spacing="12">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                        <StackPanel Spacing="6">
                          <TextBlock Text="FAB" FontSize="16" FontWeight="SemiBold" />
                          <TextBlock Text="My Library · compte Epic/Fab" FontSize="10" Foreground="#70A8FA" />
                          <TextBlock Text="{Binding DirectFabStatusSummary}" FontSize="9" Foreground="#8294A8" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoRefreshFabOnStartup}" OnContent="Actualisation automatique" OffContent="Actualisation manuelle" VerticalAlignment="Center" />
                      </Grid>
                      <Grid ColumnDefinitions="*,240" ColumnSpacing="18">
                        <StackPanel Spacing="3">
                          <TextBlock Text="COMPRESSION DES PACKAGES" FontSize="10" FontWeight="Bold" Foreground="#70A8FA" />
                          <TextBlock Text="Le JSON CyEngineHub reste à côté du ZIP pour une lecture immédiate." FontSize="9" Foreground="#8294A8" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding MarketplaceCompressionOptions}" SelectedItem="{Binding SelectedFabCompressionOption}">
                          <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:MarketplaceCompressionOptionViewModel"><StackPanel><TextBlock Text="{Binding Label}" FontWeight="SemiBold" /><TextBlock Text="{Binding Description}" FontSize="9" Foreground="#8294A8" /></StackPanel></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                      </Grid>
                      <Border Height="1" Background="#202C39" />
                      <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                        <TextBlock Text="Dossier de cache" FontSize="10" Foreground="#8294A8" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Classes="path" Text="{Binding FabCacheDirectory}" PlaceholderText="Cache Fab" />
                        <TextBlock Grid.Row="1" Text="Téléchargements temporaires" FontSize="10" Foreground="#8294A8" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" Classes="path" Text="{Binding FabDownloadDirectory}" PlaceholderText="Téléchargements Fab" />
                      </Grid>
                      <Border Background="#0B121A" BorderBrush="#26394C" BorderThickness="1" CornerRadius="8" Padding="11">
                        <StackPanel Spacing="8">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <StackPanel><TextBlock Text="SOURCES NATIVES EPIC GAMES STORE" FontSize="10" FontWeight="Bold" Foreground="#70A8FA" /><TextBlock Text="Vault Cache ou dossiers Epic existants. CyEngineHub ne modifie jamais la source." FontSize="9" Foreground="#8294A8" TextWrapping="Wrap" /></StackPanel>
                            <Button Grid.Column="1" Classes="ghost" Content="+ Ajouter un store Epic" Command="{Binding AddEpicNativeStoreSourceCommand}" />
                          </Grid>
                          <ItemsControl ItemsSource="{Binding EpicNativeStoreSources}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:MarketplaceNativeStoreSourceViewModel">
                                <Border Background="#101922" BorderBrush="#202C39" BorderThickness="1" CornerRadius="7" Padding="9" Margin="0,0,0,6">
                                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <StackPanel><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding ModeLabel}" FontSize="9" FontWeight="Bold" Foreground="#65CCA9" /><TextBlock Text="{Binding AvailabilityLabel}" FontSize="8" Foreground="#D9A55C" /></StackPanel><TextBlock Text="{Binding Path}" FontFamily="Consolas" FontSize="9" Foreground="#A8C9F2" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding ModeDescription}" FontSize="8" Foreground="#718398" TextWrapping="Wrap" /></StackPanel>
                                    <Button Grid.Column="1" Classes="ghost" Content="Dossier" Command="{Binding OpenFolderCommand}" />
                                    <Button Grid.Column="2" Classes="danger" Content="Retirer" Command="{Binding RemoveCommand}" />
                                  </Grid>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <Grid ColumnDefinitions="*,150,Auto" ColumnSpacing="8">
                            <StackPanel>
                              <TextBlock Text="CACHE DE RECONSTRUCTION VAULT" FontSize="9" FontWeight="Bold" Foreground="#70A8FA" />
                              <TextBlock Text="{Binding EpicVaultNativeCacheStatus}" FontSize="8" Foreground="#718398" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBox Grid.Column="1" Text="{Binding FabNativeCacheMaximumGigabytes}" PlaceholderText="Limite Gio · vide = illimité" />
                            <Button Grid.Column="2" Classes="ghost" Content="Appliquer la limite" Command="{Binding TrimEpicVaultNativeCacheCommand}" />
                          </Grid>
                        </StackPanel>
                      </Border>
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <StackPanel><TextBlock Text="BIBLIOTHÈQUES ORDONNÉES" FontSize="10" FontWeight="Bold" Foreground="#70A8FA" /><TextBlock Text="Le premier dossier actif disposant du quota et de l’espace requis est utilisé." FontSize="9" Foreground="#8294A8" /></StackPanel>
                        <Button Grid.Column="1" Classes="ghost" Content="+ Ajouter un dossier" Command="{Binding AddFabLibraryLocationCommand}" />
                      </Grid>
                      <ItemsControl ItemsSource="{Binding FabLibraryLocations}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:MarketplaceLibraryLocationViewModel">
                            <Grid ColumnDefinitions="Auto,34,*,140,Auto,Auto,Auto" ColumnSpacing="7" Margin="0,0,0,6">
                              <CheckBox IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="1" Text="{Binding PriorityLabel}" Foreground="#70A8FA" VerticalAlignment="Center" />
                              <TextBox Grid.Column="2" Classes="path" Text="{Binding Path}" PlaceholderText="Dossier de bibliothèque" />
                              <TextBox Grid.Column="3" Text="{Binding MaximumGigabytes}" PlaceholderText="Quota Gio · illimité" />
                              <Button Grid.Column="4" Classes="ghost" Content="↑" Command="{Binding MoveUpCommand}" />
                              <Button Grid.Column="5" Classes="ghost" Content="↓" Command="{Binding MoveDownCommand}" />
                              <Button Grid.Column="6" Classes="danger" Content="×" Command="{Binding RemoveCommand}" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                  <Border Classes="card">
                    <StackPanel Spacing="12">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                        <StackPanel Spacing="6">
                          <TextBlock Text="MEGASCANS" FontSize="16" FontWeight="SemiBold" />
                          <TextBlock Text="Bibliothèque historique Quixel · compte Epic" FontSize="10" Foreground="#70A8FA" />
                          <TextBlock Text="{Binding QuixelStatusSummary}" FontSize="9" Foreground="#8294A8" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoRefreshQuixelOnStartup}" OnContent="Actualisation automatique" OffContent="Actualisation manuelle" VerticalAlignment="Center" />
                      </Grid>
                      <Grid ColumnDefinitions="*,240" ColumnSpacing="18">
                        <StackPanel Spacing="3">
                          <TextBlock Text="COMPRESSION DES PACKAGES" FontSize="10" FontWeight="Bold" Foreground="#70A8FA" />
                          <TextBlock Text="Réglage appliqué uniquement aux téléchargements Megascans." FontSize="9" Foreground="#8294A8" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding MarketplaceCompressionOptions}" SelectedItem="{Binding SelectedQuixelCompressionOption}">
                          <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:MarketplaceCompressionOptionViewModel"><StackPanel><TextBlock Text="{Binding Label}" FontWeight="SemiBold" /><TextBlock Text="{Binding Description}" FontSize="9" Foreground="#8294A8" /></StackPanel></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                      </Grid>
                      <Border Height="1" Background="#202C39" />
                      <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                        <TextBlock Text="Dossier de cache" FontSize="10" Foreground="#8294A8" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Classes="path" Text="{Binding QuixelCacheDirectory}" PlaceholderText="Cache Megascans" />
                        <TextBlock Grid.Row="1" Text="Téléchargements temporaires" FontSize="10" Foreground="#8294A8" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" Classes="path" Text="{Binding QuixelDownloadDirectory}" PlaceholderText="Téléchargements Megascans" />
                      </Grid>
                      <Border Background="#0B121A" BorderBrush="#26394C" BorderThickness="1" CornerRadius="8" Padding="11">
                        <StackPanel Spacing="8">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <StackPanel><TextBlock Text="SOURCES NATIVES MEGASCANS" FontSize="10" FontWeight="Bold" Foreground="#70A8FA" /><TextBlock Text="Plusieurs bibliothèques Bridge peuvent être indexées ensemble sans déplacement." FontSize="9" Foreground="#8294A8" TextWrapping="Wrap" /></StackPanel>
                            <Button Grid.Column="1" Classes="ghost" Content="+ Ajouter Megascans" Command="{Binding AddMegascansNativeStoreSourceCommand}" />
                          </Grid>
                          <ItemsControl ItemsSource="{Binding MegascansNativeStoreSources}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:MarketplaceNativeStoreSourceViewModel">
                                <Border Background="#101922" BorderBrush="#202C39" BorderThickness="1" CornerRadius="7" Padding="9" Margin="0,0,0,6">
                                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <StackPanel><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding ModeLabel}" FontSize="9" FontWeight="Bold" Foreground="#65CCA9" /><TextBlock Text="{Binding AvailabilityLabel}" FontSize="8" Foreground="#D9A55C" /></StackPanel><TextBlock Text="{Binding Path}" FontFamily="Consolas" FontSize="9" Foreground="#A8C9F2" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding ModeDescription}" FontSize="8" Foreground="#718398" TextWrapping="Wrap" /></StackPanel>
                                    <Button Grid.Column="1" Classes="ghost" Content="Dossier" Command="{Binding OpenFolderCommand}" />
                                    <Button Grid.Column="2" Classes="danger" Content="Retirer" Command="{Binding RemoveCommand}" />
                                  </Grid>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <StackPanel><TextBlock Text="BIBLIOTHÈQUES ORDONNÉES" FontSize="10" FontWeight="Bold" Foreground="#70A8FA" /><TextBlock Text="Le premier dossier actif disposant du quota et de l’espace requis est utilisé." FontSize="9" Foreground="#8294A8" /></StackPanel>
                        <Button Grid.Column="1" Classes="ghost" Content="+ Ajouter un dossier" Command="{Binding AddQuixelLibraryLocationCommand}" />
                      </Grid>
                      <ItemsControl ItemsSource="{Binding QuixelLibraryLocations}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:MarketplaceLibraryLocationViewModel">
                            <Grid ColumnDefinitions="Auto,34,*,140,Auto,Auto,Auto" ColumnSpacing="7" Margin="0,0,0,6">
                              <CheckBox IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="1" Text="{Binding PriorityLabel}" Foreground="#70A8FA" VerticalAlignment="Center" />
                              <TextBox Grid.Column="2" Classes="path" Text="{Binding Path}" PlaceholderText="Dossier de bibliothèque" />
                              <TextBox Grid.Column="3" Text="{Binding MaximumGigabytes}" PlaceholderText="Quota Gio · illimité" />
                              <Button Grid.Column="4" Classes="ghost" Content="↑" Command="{Binding MoveUpCommand}" />
                              <Button Grid.Column="5" Classes="ghost" Content="↓" Command="{Binding MoveDownCommand}" />
                              <Button Grid.Column="6" Classes="danger" Content="×" Command="{Binding RemoveCommand}" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                  <Border Classes="card">
                    <StackPanel Spacing="12">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                        <StackPanel Spacing="6">
                          <TextBlock Text="UNITY ASSET STORE" FontSize="16" FontWeight="SemiBold" />
                          <TextBlock Text="Catalogue Unity isolé" FontSize="10" Foreground="#70A8FA" />
                          <TextBlock Text="L’option sera appliquée automatiquement dès que le connecteur de catalogue Unity sera actif." FontSize="9" Foreground="#8294A8" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoRefreshUnityOnStartup}" OnContent="Actualisation automatique" OffContent="Actualisation manuelle" VerticalAlignment="Center" />
                      </Grid>
                      <Grid ColumnDefinitions="*,240" ColumnSpacing="18">
                        <StackPanel Spacing="3">
                          <TextBlock Text="COMPRESSION DES PACKAGES" FontSize="10" FontWeight="Bold" Foreground="#70A8FA" />
                          <TextBlock Text="Préférence prête pour les futurs téléchargements Unity." FontSize="9" Foreground="#8294A8" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding MarketplaceCompressionOptions}" SelectedItem="{Binding SelectedUnityCompressionOption}">
                          <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:MarketplaceCompressionOptionViewModel"><StackPanel><TextBlock Text="{Binding Label}" FontWeight="SemiBold" /><TextBlock Text="{Binding Description}" FontSize="9" Foreground="#8294A8" /></StackPanel></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                      </Grid>
                      <Border Height="1" Background="#202C39" />
                      <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                        <TextBlock Text="Dossier de cache" FontSize="10" Foreground="#8294A8" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Classes="path" Text="{Binding UnityCacheDirectory}" PlaceholderText="Cache Unity" />
                        <TextBlock Grid.Row="1" Text="Téléchargements temporaires" FontSize="10" Foreground="#8294A8" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" Classes="path" Text="{Binding UnityDownloadDirectory}" PlaceholderText="Téléchargements Unity" />
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <StackPanel><TextBlock Text="BIBLIOTHÈQUES ORDONNÉES" FontSize="10" FontWeight="Bold" Foreground="#70A8FA" /><TextBlock Text="Le premier dossier actif disposant du quota et de l’espace requis est utilisé." FontSize="9" Foreground="#8294A8" /></StackPanel>
                        <Button Grid.Column="1" Classes="ghost" Content="+ Ajouter un dossier" Command="{Binding AddUnityLibraryLocationCommand}" />
                      </Grid>
                      <ItemsControl ItemsSource="{Binding UnityLibraryLocations}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:MarketplaceLibraryLocationViewModel">
                            <Grid ColumnDefinitions="Auto,34,*,140,Auto,Auto,Auto" ColumnSpacing="7" Margin="0,0,0,6">
                              <CheckBox IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="1" Text="{Binding PriorityLabel}" Foreground="#70A8FA" VerticalAlignment="Center" />
                              <TextBox Grid.Column="2" Classes="path" Text="{Binding Path}" PlaceholderText="Dossier de bibliothèque" />
                              <TextBox Grid.Column="3" Text="{Binding MaximumGigabytes}" PlaceholderText="Quota Gio · illimité" />
                              <Button Grid.Column="4" Classes="ghost" Content="↑" Command="{Binding MoveUpCommand}" />
                              <Button Grid.Column="5" Classes="ghost" Content="↓" Command="{Binding MoveDownCommand}" />
                              <Button Grid.Column="6" Classes="danger" Content="×" Command="{Binding RemoveCommand}" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Text="Ces options sont activées par défaut et n’empêchent jamais l’ouverture depuis le cache." FontSize="9" Foreground="#718398" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button Grid.Column="1" Classes="accent" Content="Enregistrer les marketplaces" Command="{Binding SaveMarketplaceSettingsCommand}" />
                  </Grid>
                </StackPanel>

                <StackPanel IsVisible="{Binding IsSettingsStorageSelected}" Spacing="14">
                  <Border Classes="card"><StackPanel><TextBlock Text="Données locales" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="{Binding DataDirectory}" Foreground="#8294A8" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" /><TextBlock Text="{Binding StorageMode}" Foreground="#55C7A6" FontSize="11" Margin="0,5,0,0" /></StackPanel></Border>
                  <Border Classes="card"><Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="14"><StackPanel><TextBlock Text="MOTEURS" FontSize="9" Foreground="#65788D" /><TextBlock Text="{Binding StorageEngineSize}" FontSize="16" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="PROJETS" FontSize="9" Foreground="#65788D" /><TextBlock Text="{Binding StorageProjectSize}" FontSize="16" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="DDC" FontSize="9" Foreground="#65788D" /><TextBlock Text="{Binding StorageDdcSize}" FontSize="16" /></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="VAULT" FontSize="9" Foreground="#65788D" /><TextBlock Text="{Binding StorageVaultSize}" FontSize="16" /></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="GIT LFS" FontSize="9" Foreground="#65788D" /><TextBlock Text="{Binding StorageLfsSize}" FontSize="16" /></StackPanel></Grid></Border>
                  <Button Classes="accent" Content="Ouvrir l’analyse du stockage" Command="{Binding ShowStorageCommand}" HorizontalAlignment="Left" />
                </StackPanel>

                <StackPanel IsVisible="{Binding IsSettingsAdvancedSelected}" Spacing="14">
                  <Border Classes="card">
                    <StackPanel Spacing="12">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel>
                          <TextBlock Text="MISES À JOUR" FontSize="16" FontWeight="SemiBold" />
                          <TextBlock Text="Mises à jour depuis le dépôt GitHub officiel. Les Alpha/Bêta sont proposées uniquement si vous activez les préversions." FontSize="10" Foreground="#8294A8" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#123122" CornerRadius="6" Padding="9,5" VerticalAlignment="Center">
                          <TextBlock Text="SHA-256 REQUIS" FontSize="9" FontWeight="Bold" Foreground="#65CFA1" />
                        </Border>
                      </Grid>
                      <StackPanel Spacing="5">
                        <TextBlock Text="DÉPÔT GITHUB" FontSize="9" FontWeight="Bold" Foreground="#70A8FA" />
                        <TextBox Classes="path" Text="{Binding UpdateRepository, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="https://github.com/propriétaire/cyenginehub" />
                        <TextBlock Text="Dépôt officiel : MrMybal/CyEngineHub. Désactivez la vérification au lancement pour rechercher les mises à jour uniquement à la demande." FontSize="9" Foreground="#718398" TextWrapping="Wrap" />
                      </StackPanel>
                      <Border Background="#0B121A" BorderBrush="#26394C" BorderThickness="1" CornerRadius="8" Padding="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                          <StackPanel>
                            <TextBlock Text="VÉRIFIER AU LANCEMENT" FontSize="10" FontWeight="Bold" Foreground="#70A8FA" />
                            <TextBlock Text="Affiche automatiquement les notes lorsqu’une version plus récente du canal choisi est publiée." FontSize="9" Foreground="#8294A8" Margin="0,4,0,0" TextWrapping="Wrap" />
                          </StackPanel>
                          <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoCheckStableUpdates}" OnContent="Activé" OffContent="Désactivé" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                      <CheckBox IsChecked="{Binding IncludePrereleaseUpdates}" Content="Inclure les préversions Alpha / Bêta (activé par défaut dans cette Alpha)" />
                      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="9">
                        <TextBlock Text="{Binding UpdateStatus}" FontSize="9" Foreground="#8294A8" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Button Grid.Column="1" Classes="ghost" Command="{Binding CheckForUpdatesCommand}" IsEnabled="{Binding CanCheckForUpdates}">
                          <Grid>
                            <TextBlock Text="Vérifier maintenant" IsVisible="{Binding !IsUpdateCheckActive}" />
                            <TextBlock Text="Vérification…" IsVisible="{Binding IsUpdateCheckActive}" />
                          </Grid>
                        </Button>
                        <Button Grid.Column="2" Classes="accent" Content="Enregistrer" Command="{Binding SaveUpdateSettingsCommand}" />
                      </Grid>
                    </StackPanel>
                  </Border>
                  <Border Classes="card">
                    <StackPanel Spacing="12">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel>
                          <TextBlock Text="COMPORTEMENT WINDOWS" FontSize="16" FontWeight="SemiBold" />
                          <TextBlock Text="Fermer la fenêtre masque CyEngineHub dans la zone de notification. Les téléchargements et les tâches en arrière-plan continuent." FontSize="10" Foreground="#8294A8" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#15304A" CornerRadius="6" Padding="9,5" VerticalAlignment="Center">
                          <TextBlock Text="TRAY ACTIF" FontSize="9" FontWeight="Bold" Foreground="#8CC2FF" />
                        </Border>
                      </Grid>
                      <Border Background="#0B121A" BorderBrush="#26394C" BorderThickness="1" CornerRadius="8" Padding="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                          <StackPanel>
                            <TextBlock Text="LANCER AVEC WINDOWS" FontSize="10" FontWeight="Bold" Foreground="#70A8FA" />
                            <TextBlock Text="Au démarrage de la session, CyEngineHub se lance directement dans le tray sans ouvrir la fenêtre principale." FontSize="9" Foreground="#8294A8" Margin="0,4,0,0" TextWrapping="Wrap" />
                          </StackPanel>
                          <ToggleSwitch Grid.Column="1" IsChecked="{Binding LaunchAtWindowsStartup}" IsEnabled="{Binding IsWindowsStartupSupported}" OnContent="Activé" OffContent="Désactivé" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Text="{Binding WindowsStartupStatus}" FontSize="9" Foreground="#718398" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Button Grid.Column="1" Classes="accent" Content="Enregistrer le démarrage Windows" Command="{Binding SaveWindowsStartupSettingsCommand}" IsEnabled="{Binding IsWindowsStartupSupported}" />
                      </Grid>
                    </StackPanel>
                  </Border>
                  <Border Classes="card"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><StackPanel><TextBlock Text="LOGS ET DIAGNOSTIC" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="Le journal RAW conserve les statuts, tâches, erreurs complètes et sorties Git/Build." FontSize="10" Foreground="#8294A8" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel><Button Grid.Column="1" Classes="ghost" Content="{Binding ShowLogsLabel}" Command="{Binding ToggleLogsCommand}" VerticalAlignment="Center" /></Grid></Border>
                  <Border Classes="card"><StackPanel Spacing="9"><TextBlock Text="FICHIER RAW ACTIF" FontSize="10" FontWeight="Bold" Foreground="#65788D" /><TextBlock Text="{Binding RawLogFilePath}" FontFamily="Consolas" FontSize="10" Foreground="#AAB7C5" TextWrapping="Wrap" /><WrapPanel><Button Classes="accent" Content="Afficher les logs" Command="{Binding ShowLogsCommand}" Margin="0,0,8,0" /><Button Classes="ghost" Content="Recharger" Command="{Binding RefreshRawLogCommand}" Margin="0,0,8,0" /><Button Classes="ghost" Content="Ouvrir le dossier" Command="{Binding OpenRawLogFolderCommand}" /></WrapPanel></StackPanel></Border>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>

        <Border IsVisible="{Binding IsRoadmapVisible}" Classes="card" MaxWidth="760" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel HorizontalAlignment="Center">
            <Border Background="#17283B" CornerRadius="28" Width="56" Height="56">
              <TextBlock Text="+" FontSize="28" Foreground="#68A3FA" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="{Binding RoadmapTitle}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,0" />
            <TextBlock Text="{Binding RoadmapDescription}" TextWrapping="Wrap" TextAlignment="Center" Foreground="#8799AC" Margin="0,9,0,0" />
          </StackPanel>
        </Border>
      </Grid>

      <Border Grid.Row="2" BorderBrush="#1C2632" BorderThickness="0,1,0,0" Padding="10,7">
        <Grid ColumnDefinitions="*,220,Auto" ColumnSpacing="12">
          <TextBlock Text="{Binding FooterActivityText}" FontFamily="Consolas" FontSize="10" Foreground="#7D9BB7" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding FooterProgressPercent}" Height="7" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="Offline-first · SQLite WAL · Async" FontSize="10" Foreground="#536477" VerticalAlignment="Center" />
        </Grid>
      </Border>
    </Grid>
  </Grid>

  <Grid IsVisible="{Binding IsNativeStoreSourceEditorVisible}" Panel.ZIndex="2350">
    <Border Background="#D8080C11" />
    <Border Width="820" MaxHeight="690" Margin="42" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#111820" BorderBrush="#438ED1" BorderThickness="1" CornerRadius="14" Padding="24" ClipToBounds="True">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="16">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <StackPanel>
            <TextBlock Text="{Binding PendingNativeStoreTitle}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding PendingNativeStoreDescription}" FontSize="10" Foreground="#8294A8" Margin="0,5,0,0" TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Column="1" Classes="history" Content="✕" Command="{Binding CloseNativeStoreSourceEditorCommand}" ToolTip.Tip="Fermer" />
        </Grid>

        <StackPanel Grid.Row="1" Spacing="5">
          <TextBlock Text="DOSSIER DU STORE" FontSize="9" FontWeight="Bold" Foreground="#70A8FA" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Classes="path" Text="{Binding PendingNativeStorePath, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Dossier Vault Cache ou Megascans Library" />
            <Button Grid.Column="1" Classes="ghost" Content="Parcourir…" Click="BrowseNativeStoreSource" />
          </Grid>
          <TextBlock Text="Le dossier doit déjà exister. Les liens et points de jonction ne sont pas acceptés comme racine." FontSize="8" Foreground="#718398" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="2" Background="#0B121A" BorderBrush="#26394C" BorderThickness="1" CornerRadius="9" Padding="14">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
              <StackPanel>
                <TextBlock Text="MODE D’UTILISATION" FontSize="9" FontWeight="Bold" Foreground="#70A8FA" />
                <TextBlock Text="{Binding PendingNativeStoreModeTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding PendingNativeStoreConvertOnUse}" OnContent="Conversion à la demande" OffContent="Format natif" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="{Binding PendingNativeStoreModeDescription}" FontSize="10" Foreground="#A8B9CA" TextWrapping="Wrap" />
            <Border IsVisible="{Binding PendingNativeStoreConvertOnUse}" Background="#132335" CornerRadius="7" Padding="10">
              <StackPanel Spacing="4"><TextBlock Text="PARAMÈTRES DE CONVERSION DU STORE" FontSize="9" FontWeight="Bold" Foreground="#65CFA1" /><TextBlock Text="{Binding PendingNativeStoreConversionSummary}" FontSize="9" Foreground="#BCD0E6" TextWrapping="Wrap" /></StackPanel>
            </Border>
            <Border IsVisible="{Binding !PendingNativeStoreConvertOnUse}" Background="#13251F" CornerRadius="7" Padding="10">
              <TextBlock Text="Lecture seule garantie : retirer cette source de CyEngineHub ne supprime aucun fichier du store." FontSize="9" Foreground="#A9DCC7" TextWrapping="Wrap" />
            </Border>
          </StackPanel>
        </Border>

        <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="9">
          <TextBlock Text="La conversion n’est jamais appliquée à toute la bibliothèque d’un coup : elle se fait asset par asset lors de l’utilisation." FontSize="9" Foreground="#718398" VerticalAlignment="Center" TextWrapping="Wrap" />
          <Button Grid.Column="1" Classes="ghost" Content="Annuler" Command="{Binding CloseNativeStoreSourceEditorCommand}" />
          <Button Grid.Column="2" Classes="accent" Content="Ajouter le store" Command="{Binding ConfirmNativeStoreSourceCommand}" />
        </Grid>
      </Grid>
    </Border>
  </Grid>

  <Grid IsVisible="{Binding IsUpdateAvailablePopupVisible}" Panel.ZIndex="2400">
    <Border Background="#E3080C11" />
    <Border Width="820" MaxHeight="700" Margin="42" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#111820" BorderBrush="#438ED1" BorderThickness="1" CornerRadius="14" Padding="24" ClipToBounds="True">
      <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <StackPanel>
            <TextBlock Text="NOUVELLE VERSION STABLE" FontSize="10" FontWeight="Bold" Foreground="#70A8FA" />
            <TextBlock Text="{Binding AvailableUpdateTitle}" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap" />
          </StackPanel>
          <Border Grid.Column="1" Background="#15304A" CornerRadius="7" Padding="11,6" VerticalAlignment="Center">
            <TextBlock Text="{Binding AvailableUpdateVersion}" FontSize="13" FontWeight="Bold" Foreground="#8CC2FF" />
          </Border>
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <TextBlock Text="{Binding AvailableUpdatePublishedAt}" FontSize="10" Foreground="#8294A8" />
          <TextBlock Grid.Column="1" Text="{Binding AvailableUpdateInstallerStatus}" FontSize="9" Foreground="#65CFA1" TextWrapping="Wrap" MaxWidth="410" TextAlignment="Right" />
        </Grid>
        <Border Grid.Row="2" Background="#0B121A" BorderBrush="#202C39" BorderThickness="1" CornerRadius="9" Padding="14" MinHeight="220">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <SelectableTextBlock Text="{Binding AvailableUpdateNotes}" FontSize="11" Foreground="#C4D2E1" TextWrapping="Wrap" />
          </ScrollViewer>
        </Border>
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="9">
          <TextBlock Text="L’installateur ne sera lancé qu’après l’arrêt complet de CyEngineHub et de ses services." FontSize="9" Foreground="#718398" VerticalAlignment="Center" TextWrapping="Wrap" />
          <Button Grid.Column="1" Classes="ghost" Content="Plus tard" Command="{Binding PostponeUpdateCommand}" />
          <Button Grid.Column="2" Classes="ghost" Content="Voir la release" Command="{Binding OpenAvailableUpdateReleaseCommand}" />
          <Button Grid.Column="3" Classes="accent" Content="Télécharger et installer" Command="{Binding DownloadAndInstallUpdateCommand}" IsEnabled="{Binding CanInstallAvailableUpdate}" />
        </Grid>
      </Grid>
    </Border>
  </Grid>

  <Grid IsVisible="{Binding IsUpdateDownloadProgressVisible}" Panel.ZIndex="2450">
    <Border Background="#E8080C11" />
    <Border Width="660" Margin="42" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#111820" BorderBrush="#438ED1" BorderThickness="1" CornerRadius="14" Padding="26">
      <StackPanel Spacing="16">
        <StackPanel>
          <TextBlock Text="MISE À JOUR DE CYENGINEHUB" FontSize="10" FontWeight="Bold" Foreground="#70A8FA" />
          <TextBlock Text="{Binding UpdateProgressStatus}" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <ProgressBar Minimum="0" Maximum="100" Value="{Binding UpdateProgressPercent}" Height="8" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <TextBlock Text="{Binding UpdateProgressDetails}" FontFamily="Consolas" FontSize="10" Foreground="#8FA8C1" TextWrapping="Wrap" />
          <TextBlock Grid.Column="1" Text="{Binding UpdateProgressPercent, StringFormat={}{0:0}%}" FontSize="12" FontWeight="SemiBold" Foreground="#8CC2FF" />
        </Grid>
        <Border Background="#132335" CornerRadius="8" Padding="12">
          <TextBlock Text="Ne fermez pas le processus manuellement. Après la vérification SHA-256, CyEngineHub arrêtera ses tâches et le lanceur externe ouvrira l’installateur." FontSize="10" Foreground="#BCD0E6" TextWrapping="Wrap" />
        </Border>
      </StackPanel>
    </Border>
  </Grid>

  <Grid IsVisible="{Binding IsProjectCreatorVisible}" IsEnabled="{Binding !IsProjectProfileEditorVisible}" Panel.ZIndex="2275">
    <Border Background="#D8080C11" />
    <Border MaxWidth="1240" MaxHeight="820" MinWidth="780" MinHeight="560" Margin="28" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#111820" BorderBrush="#438ED1" BorderThickness="1" CornerRadius="14" Padding="22" ClipToBounds="True">
      <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <StackPanel>
            <TextBlock Text="CRÉER UN PROJET" FontSize="21" FontWeight="SemiBold" />
            <TextBlock Text="Moteur, profil, plugins, collections et scripts post-création" FontSize="10" Foreground="#8294A8" Margin="0,4,0,0" />
          </StackPanel>
          <Button Grid.Column="1" Classes="history" Content="✕" Command="{Binding CloseProjectCreatorCommand}" ToolTip.Tip="Fermer" />
        </Grid>

        <TabControl Grid.Row="1" SelectedIndex="{Binding ProjectCreatorTabIndex}">
          <TabItem Header="Projet &amp; profil">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="14" Margin="0,0,8,0">
            <Border Background="#0B121A" BorderBrush="#26394C" BorderThickness="1" CornerRadius="9" Padding="13">
              <StackPanel Spacing="9">
                <TextBlock Text="1 · PROJET ET MOTEUR" FontSize="10" FontWeight="Bold" Foreground="#70A8FA" />
                <Grid ColumnDefinitions="1.05*,1.2*,1.2*" ColumnSpacing="9">
                  <ComboBox ItemsSource="{Binding ProjectCreationPresets}" SelectedItem="{Binding SelectedProjectCreationPreset}" PlaceholderText="Type de projet">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:ProjectCreationPresetOptionViewModel">
                        <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Description}" FontSize="9" Foreground="#718398" TextWrapping="Wrap" /></StackPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <ComboBox Grid.Column="1" IsVisible="{Binding IsUnrealProjectCreation}" ItemsSource="{Binding ProjectCreationEngines}" SelectedItem="{Binding SelectedProjectCreationEngine}" PlaceholderText="Version Unreal installée">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:ProjectCreationEngineOptionViewModel">
                        <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Version}" FontSize="9" Foreground="#70A8FA" /><TextBlock Text="{Binding Path}" FontSize="8" Foreground="#65788D" TextTrimming="CharacterEllipsis" /></StackPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <ComboBox Grid.Column="2" IsVisible="{Binding IsUnrealProjectCreation}" ItemsSource="{Binding ProjectCreationConfigurations}" SelectedItem="{Binding SelectedProjectCreationConfiguration}" PlaceholderText="Profil de configuration">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:ProjectCreationConfigurationOptionViewModel">
                        <StackPanel>
                          <StackPanel Orientation="Horizontal" Spacing="7"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Origin}" FontSize="8" Foreground="#65CFA1" VerticalAlignment="Center" /></StackPanel>
                          <TextBlock Text="{Binding Description}" FontSize="9" Foreground="#718398" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Inventory}" FontSize="8" Foreground="#5F9BD3" />
                        </StackPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>
                <Grid IsVisible="{Binding IsUnrealProjectCreation}" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProjectCreationPluginCompatibilitySummary}" FontSize="9" Foreground="#8FB9F4" TextWrapping="Wrap" />
                    <TextBlock Text="Le profil sélectionné initialise les plugins et les fichiers INI du projet." FontSize="8" Foreground="#65788D" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="ghost" Content="Nouveau profil" Command="{Binding NewProjectProfileCommand}" />
                  <Button Grid.Column="2" Classes="ghost" Content="Modifier / Dupliquer" Command="{Binding EditProjectProfileCommand}" />
                </Grid>
                <Grid ColumnDefinitions="1*,1.55*,0.75*" ColumnSpacing="9">
                  <TextBox Classes="path" Text="{Binding NewProjectName}" PlaceholderText="Nom technique du projet" />
                  <TextBox Grid.Column="1" Classes="path" Text="{Binding NewProjectParentDirectory}" PlaceholderText="Dossier parent existant" />
                  <TextBox Grid.Column="2" Classes="path" Text="{Binding NewProjectEngineAssociation}" PlaceholderText="Association moteur" />
                </Grid>
              </StackPanel>
            </Border>

            <Border Classes="card" Margin="0"><StackPanel Spacing="10">
              <TextBlock Text="{Binding ProjectCompositionSummary}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding ProjectPluginPolicySummary}" Foreground="#65CCA9" TextWrapping="Wrap" />
              <TextBlock Text="Priorité : profil → packs cochés dans leur ordre → choix manuels. Changer de profil réinitialise les choix manuels ; les packs restent sélectionnés." FontSize="11" Foreground="#8294A8" TextWrapping="Wrap" />
              <Button Content="Réinitialiser mes overrides" Classes="ghost" Command="{Binding ResetProjectCompositionCommand}" HorizontalAlignment="Left" />
            </StackPanel></Border>
          </StackPanel>
        </ScrollViewer>
          </TabItem>
          <TabItem Header="Fonctionnalités" IsVisible="{Binding IsUnrealProjectCreation}">
            <Grid RowDefinitions="Auto,*" RowSpacing="12" Margin="0,12,0,0">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="5">
                  <TextBlock Text="PACKS DE FONCTIONNALITÉS" FontWeight="Bold" Foreground="#70A8FA" />
                  <TextBlock Text="Cochez les packs à ajouter. Le plus bas dans la liste gagne en cas de conflit. Les flèches changent leur ordre." FontSize="11" Foreground="#8294A8" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Classes="accent" Content="+ Nouveau pack" Command="{Binding NewProjectFeaturePackCommand}" />
              </Grid>
              <ListBox Grid.Row="1" ItemsSource="{Binding ProjectCreationFeaturePacks}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /></Style></ListBox.Styles>
                <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemTemplate><DataTemplate x:DataType="vm:ProjectFeaturePackOptionViewModel">
                  <Border Background="#0B121A" BorderBrush="#26394C" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,4,8">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="10">
                      <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Order}" Foreground="#65788D" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#A4B3C2" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Detail}" FontSize="9" Foreground="#65CCA9" />
                      </StackPanel>
                      <Button Grid.Column="3" Classes="ghost" Content="↑" Command="{Binding MoveUpCommand}" ToolTip.Tip="Appliquer plus tôt" />
                      <Button Grid.Column="4" Classes="ghost" Content="↓" Command="{Binding MoveDownCommand}" ToolTip.Tip="Appliquer plus tard (priorité supérieure)" />
                      <Button Grid.Column="5" Classes="ghost" Content="Modifier / Dupliquer" Command="{Binding EditCommand}" />
                    </Grid>
                  </Border>
                </DataTemplate></ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </TabItem>
          <TabItem Header="Plugins" IsVisible="{Binding IsUnrealProjectCreation}">
            <Grid Margin="0,12,0,0">
            <Border IsVisible="{Binding IsUnrealProjectCreation}" Background="#0B121A" BorderBrush="#26394C" BorderThickness="1" CornerRadius="9" Padding="13">
              <Grid RowDefinitions="Auto,Auto,*" RowSpacing="9">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel>
                    <TextBlock Text="2 · PLUGINS DU MOTEUR SÉLECTIONNÉ" FontSize="10" FontWeight="Bold" Foreground="#70A8FA" />
                    <TextBlock Text="Coché = actif · profil et packs forment la base ; vos choix sont prioritaires." FontSize="8" Foreground="#718398" Margin="0,3,0,0" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding ProjectCreationPluginActivationSummary}" FontSize="9" Foreground="#8294A8" VerticalAlignment="Center" />
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <TextBox Classes="path" Text="{Binding ProjectCreationPluginSearchQuery, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Rechercher un plugin, une catégorie ou une source…" />
                  <CheckBox Grid.Column="1" Content="Actifs uniquement" IsChecked="{Binding ShowActiveProjectCreationPluginsOnly}" />
                </Grid>
                <Grid Grid.Row="2" ColumnDefinitions="210,*" ColumnSpacing="12">
                <ListBox ItemsSource="{Binding ProjectCreationPluginCategories}" SelectedItem="{Binding SelectedProjectCreationPluginCategory}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                <ListBox Grid.Column="1" ItemsSource="{Binding VisibleProjectCreationPlugins}" Background="#0D141C" BorderBrush="#202C39" BorderThickness="1" CornerRadius="7" Padding="7" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListBox.Styles>
                    <Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" /></Style>
                  </ListBox.Styles>
                  <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel CacheLength="0.5" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProjectProfilePluginOptionViewModel">
                      <Border BorderBrush="#202C39" BorderThickness="0,0,0,1" Padding="7">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                          <CheckBox IsChecked="{Binding IsActive}" VerticalAlignment="Center" />
                          <StackPanel Grid.Column="1"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Detail}" FontSize="8" Foreground="#718398" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding ActivationOrigin}" FontSize="8" Foreground="#65CCA9" /></StackPanel>
                          <Button Grid.Column="2" Classes="ghost" Content="↺" Command="{Binding ResetToDefaultCommand}" ToolTip.Tip="Rétablir le profil et les packs" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                </Grid>
              </Grid>
            </Border>

            </Grid>
          </TabItem>
          <TabItem Header="Configuration INI" IsVisible="{Binding IsUnrealProjectCreation}">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10" Margin="0,12,0,0">
              <TextBlock Text="Aperçu exact des fichiers Config/*.ini créés, avant les scripts post-création. Un fichier édité reste prioritaire en entier ; réinitialisez-le pour reprendre le profil et les packs." FontSize="11" Foreground="#A4B3C2" TextWrapping="Wrap" />
              <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <TextBox Classes="path" Text="{Binding NewProjectIniFileName}" PlaceholderText="DefaultInput.ini" />
                <Button Grid.Column="1" Content="+ Ajouter un fichier" Classes="ghost" Command="{Binding AddProjectIniDocumentCommand}" />
                <Button Grid.Column="2" Content="Réinitialiser ce fichier" Classes="ghost" Command="{Binding ResetProjectIniDocumentCommand}" />
              </Grid>
              <Grid Grid.Row="2" ColumnDefinitions="195,*" ColumnSpacing="12">
                <ListBox ItemsSource="{Binding ProjectCreationIniDocuments}" SelectedItem="{Binding SelectedProjectIniDocument}">
                  <ListBox.ItemTemplate><DataTemplate x:DataType="vm:ProjectIniDocumentViewModel">
                    <StackPanel Spacing="3"><TextBlock Text="{Binding FileName}" /><TextBlock Text="Modifié" IsVisible="{Binding IsEdited}" FontSize="9" Foreground="#65CCA9" /></StackPanel>
                  </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" RowSpacing="8" DataContext="{Binding SelectedProjectIniDocument}" x:DataType="vm:ProjectIniDocumentViewModel">
                  <TextBlock Text="{Binding Origin}" Foreground="#65CCA9" FontSize="10" />
                  <TextBox Grid.Row="1" Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                  <TextBlock Grid.Row="2" Text="{Binding Error}" TextWrapping="Wrap" Foreground="#F5B95F" FontSize="11" />
                </Grid>
              </Grid>
            </Grid>
          </TabItem>
          <TabItem Header="Collections">
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,12,8,0">
            <Border Background="#0B121A" BorderBrush="#26394C" BorderThickness="1" CornerRadius="9" Padding="13">
              <StackPanel Spacing="8">
                <TextBlock Text="COLLECTIONS ET PACKAGES INITIAUX" FontSize="10" FontWeight="Bold" Foreground="#70A8FA" />
                <TextBlock IsVisible="{Binding !HasProjectCreationCollections}" Text="Aucune collection personnelle n’est encore définie dans la Bibliothèque." FontSize="10" Foreground="#718398" />
                <ItemsControl ItemsSource="{Binding ProjectCreationCollections}" IsVisible="{Binding HasProjectCreationCollections}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProjectCreationCollectionOptionViewModel">
                      <Border Background="#111C27" BorderBrush="#26384B" BorderThickness="1" CornerRadius="7" Padding="10" Width="245" Margin="0,0,8,8">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"><CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Top" /><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Summary}" FontSize="9" Foreground="#718398" TextWrapping="Wrap" /></StackPanel></Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Les contenus Fab, Megascans et locaux de ces collections seront installés en arrière-plan après la création." FontSize="9" Foreground="#8294A8" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            </StackPanel></ScrollViewer>
          </TabItem>
          <TabItem Header="Post-création">
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,12,8,0">
            <Border Background="#0B121A" BorderBrush="#26394C" BorderThickness="1" CornerRadius="9" Padding="13">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                  <StackPanel><TextBlock Text="SCRIPTS POST-CRÉATION" FontSize="10" FontWeight="Bold" Foreground="#70A8FA" /><TextBlock Text="Actions exécutées après la structure de base du projet." FontSize="9" Foreground="#718398" /></StackPanel>
                  <Button Grid.Column="1" Classes="ghost" Content="Actualiser" Command="{Binding RefreshProjectCreationScriptsCommand}" />
                  <Button Grid.Column="2" Classes="ghost" Content="Dossier des scripts" Command="{Binding OpenProjectCreationScriptsFolderCommand}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding ProjectPostCreationScripts}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProjectPostCreationScriptOptionViewModel">
                      <Border Background="#111C27" BorderBrush="#26384B" BorderThickness="1" CornerRadius="7" Padding="11" Margin="0,0,0,8">
                        <StackPanel Spacing="9">
                          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9"><CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Top" /><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Description}" FontSize="9" Foreground="#8294A8" TextWrapping="Wrap" /></StackPanel><TextBlock Grid.Column="2" Text="{Binding Origin}" FontSize="8" Foreground="#65CFA1" /></Grid>
                          <ItemsControl ItemsSource="{Binding Options}" IsVisible="{Binding IsSelected}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:ProjectPostCreationOptionValueViewModel">
                                <StackPanel Width="245" Margin="0,0,9,7" Spacing="3"><TextBlock Text="{Binding Name}" FontSize="9" FontWeight="Bold" Foreground="#8FB9F4" /><TextBox IsVisible="{Binding IsText}" Classes="path" Text="{Binding Value}" /><ComboBox IsVisible="{Binding IsChoice}" ItemsSource="{Binding Choices}" SelectedItem="{Binding Value}" /><CheckBox IsVisible="{Binding IsBoolean}" IsChecked="{Binding BooleanValue}" Content="{Binding Description}" /><TextBlock IsVisible="{Binding !IsBoolean}" Text="{Binding Description}" FontSize="8" Foreground="#65788D" TextWrapping="Wrap" /></StackPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
          </TabItem>
        </TabControl>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
          <StackPanel Spacing="4" VerticalAlignment="Center"><TextBlock Text="{Binding ProjectCompositionIssues}" FontSize="10" Foreground="#F5B95F" TextWrapping="Wrap" MaxHeight="55" /><TextBlock Text="Aucun dossier existant n’est écrasé. Seul le nouveau projet est modifié." FontSize="9" Foreground="#8294A8" TextWrapping="Wrap" /></StackPanel>
          <Button Grid.Column="1" Classes="ghost" Content="Annuler" Command="{Binding CloseProjectCreatorCommand}" />
          <Button Grid.Column="2" Classes="accent" Content="Créer le projet" Command="{Binding CreateProjectCommand}" IsEnabled="{Binding CanCreateProjectConfiguration}" Padding="20,10" />
        </Grid>
      </Grid>
    </Border>
  </Grid>

  <Grid IsVisible="{Binding IsProjectProfileEditorVisible}" Panel.ZIndex="2300">
    <Border Background="#D8080C11" />
    <Border MaxWidth="1240" MaxHeight="790" MinWidth="780" MinHeight="540" Margin="28" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#111820" BorderBrush="#438ED1" BorderThickness="1" CornerRadius="14" Padding="22" ClipToBounds="True">
      <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <StackPanel>
            <TextBlock Text="{Binding ProjectProfileEditorTitle}" FontSize="10" FontWeight="Bold" Foreground="#70A8FA" />
            <TextBlock Text="Plugins du moteur, fichiers INI et import depuis un projet existant" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" />
          </StackPanel>
          <Button Grid.Column="1" Classes="history" Content="✕" Command="{Binding CloseProjectProfileEditorCommand}" ToolTip.Tip="Fermer" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="1.05*,1.45*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="9">
          <StackPanel Spacing="4">
            <TextBlock Text="NOM" FontSize="9" FontWeight="Bold" Foreground="#65788D" />
            <TextBox Classes="path" Text="{Binding ProjectProfileName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Ex. UE5 jeu optimisé" />
            <CheckBox Content="Base minimale : plugins moteur désactivés par défaut" IsChecked="{Binding ProjectProfileDisableEnginePluginsByDefault}" IsVisible="{Binding !IsEditingProjectFeaturePack}" FontSize="10" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock Text="DESCRIPTION" FontSize="9" FontWeight="Bold" Foreground="#65788D" />
            <TextBox Classes="path" Text="{Binding ProjectProfileDescription, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="But et compromis de ce profil" />
          </StackPanel>
          <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#0B121A" BorderBrush="#26394C" BorderThickness="1" CornerRadius="8" Padding="10">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
              <TextBlock Text="COPIER DEPUIS UN PROJET" FontSize="9" FontWeight="Bold" Foreground="#65CFA1" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProjectProfileSourceProject}" PlaceholderText="Projet Unreal existant">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProjectCardViewModel">
                    <StackPanel>
                      <TextBlock Text="{Binding SelectionLabel}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Path}" FontSize="8" Foreground="#718398" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Grid.Column="2" Classes="ghost" Content="Importer plugins + INI" Command="{Binding ImportProjectProfileCommand}" />
            </Grid>
          </Border>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="1.05*,1.25*" ColumnSpacing="12">
          <Border Background="#0B121A" BorderBrush="#26394C" BorderThickness="1" CornerRadius="9" Padding="12">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="9">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="PLUGINS DU MOTEUR SÉLECTIONNÉ" FontSize="10" FontWeight="Bold" Foreground="#70A8FA" />
                  <TextBlock Text="Coché = activer · vide = désactiver · tiret = ne pas modifier" FontSize="8" Foreground="#718398" Margin="0,3,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding ProjectProfilePluginCount, StringFormat='{}{0} plugin(s)'}" FontSize="9" Foreground="#8294A8" VerticalAlignment="Center" />
              </Grid>
              <TextBox Grid.Row="1" Classes="path" Text="{Binding ProjectProfilePluginSearchQuery, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Rechercher un plugin, une catégorie ou une source…" />
              <ListBox Grid.Row="2" ItemsSource="{Binding ProjectProfilePlugins}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate><VirtualizingStackPanel CacheLength="0.5" /></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProjectProfilePluginOptionViewModel">
                    <Border IsVisible="{Binding IsVisible}" BorderBrush="#202C39" BorderThickness="0,0,0,1" Padding="7">
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                        <CheckBox IsThreeState="True" IsChecked="{Binding State}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Detail}" FontSize="8" Foreground="#718398" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <Border Grid.Column="1" Background="#0B121A" BorderBrush="#26394C" BorderThickness="1" CornerRadius="9" Padding="12">
            <Grid RowDefinitions="Auto,*" RowSpacing="9">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="CONFIGURATION INI" FontSize="10" FontWeight="Bold" Foreground="#70A8FA" />
                  <TextBlock Text="Chaque entrée est écrite dans Config/Default*.ini lors de la création." FontSize="8" Foreground="#718398" Margin="0,3,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Classes="ghost" Content="+ Ajouter une clé" Command="{Binding AddProjectProfileIniSettingCommand}" />
              </Grid>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding ProjectProfileIniSettings}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProjectProfileIniSettingViewModel">
                      <Border Background="#101922" BorderBrush="#202C39" BorderThickness="1" CornerRadius="7" Padding="9" Margin="0,0,0,8">
                        <Grid ColumnDefinitions="1*,1.35*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                          <StackPanel Spacing="3">
                            <TextBlock Text="FICHIER" FontSize="8" Foreground="#65788D" />
                            <TextBox Classes="path" Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}" FontSize="11" ToolTip.Tip="{Binding FileName}" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="SECTION" FontSize="8" Foreground="#65788D" />
                            <TextBox Classes="path" Text="{Binding Section, UpdateSourceTrigger=PropertyChanged}" FontSize="11" ToolTip.Tip="{Binding Section}" />
                          </StackPanel>
                          <StackPanel Grid.Row="1" Spacing="3">
                            <TextBlock Text="CLÉ" FontSize="8" Foreground="#65788D" />
                            <TextBox Classes="path" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" FontSize="11" ToolTip.Tip="{Binding Key}" />
                          </StackPanel>
                          <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3">
                            <TextBlock Text="VALEUR" FontSize="8" Foreground="#65788D" />
                            <TextBox Classes="path" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" FontSize="11" ToolTip.Tip="{Binding Value}" />
                          </StackPanel>
                          <Button Grid.Column="2" Grid.RowSpan="2" Classes="danger" Content="✕" Command="{Binding RemoveCommand}" VerticalAlignment="Center" ToolTip.Tip="Retirer cette clé" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>

        <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="9">
          <TextBlock Text="Enregistré dans CyEngineHub. Les modèles intégrés restent intacts et sont dupliqués avant modification." FontSize="9" Foreground="#718398" VerticalAlignment="Center" TextWrapping="Wrap" />
          <Button Grid.Column="1" Classes="danger" IsVisible="{Binding CanDeleteSelectedProjectProfile}" Content="{Binding ProjectProfileDeleteLabel}" Command="{Binding DeleteProjectProfileCommand}" />
          <Button Grid.Column="2" Classes="ghost" Content="Annuler" Command="{Binding CloseProjectProfileEditorCommand}" />
          <Button Grid.Column="3" Classes="accent" Content="{Binding ProjectProfileSaveLabel}" Command="{Binding SaveProjectProfileCommand}" />
        </Grid>
      </Grid>
    </Border>
  </Grid>

  <Grid IsVisible="{Binding IsFabOptionsModalVisible}" Panel.ZIndex="2000">
    <Border Background="#C9080C11" />
    <Border MaxWidth="980" MaxHeight="720" MinHeight="360" Margin="64" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#111820" BorderBrush="#438ED1" BorderThickness="1" CornerRadius="14" Padding="24" ClipToBounds="True">
      <Grid>
        <Grid IsVisible="{Binding IsFabDownloadOptionsVisible}" RowDefinitions="Auto,*,Auto" RowSpacing="18">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
            <StackPanel>
              <TextBlock Text="VARIANTES À TÉLÉCHARGER" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="Sélectionnez les formats RAW, résolutions ou versions Unreal. Le téléchargement reste dans le stockage de la Bibliothèque." FontSize="10" Foreground="#8294A8" Margin="0,5,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Classes="history" Content="✕" Command="{Binding CloseFabDownloadOptionsCommand}" ToolTip.Tip="Fermer" />
          </Grid>
          <Border Grid.Row="1" Background="#0B121A" BorderBrush="#202C39" BorderThickness="1" CornerRadius="9" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding FabInstallVersions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:FabInstallVersionOptionViewModel">
                    <CheckBox IsChecked="{Binding IsSelected}" Margin="0,0,0,8">
                      <StackPanel>
                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ArtifactLabel}" FontSize="9" Foreground="#718398" />
                      </StackPanel>
                    </CheckBox>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
          <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Text="Les variantes sélectionnées seront téléchargées et préparées selon les paramètres de package de la Bibliothèque." FontSize="9" Foreground="#718398" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button Grid.Column="1" Classes="accent" Content="Télécharger les versions sélectionnées" Command="{Binding DownloadSelectedFabVersionsCommand}" />
          </Grid>
        </Grid>

        <Grid IsVisible="{Binding IsFabInstallOptionsVisible}" RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="12">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
            <StackPanel>
              <TextBlock Text="INSTALLER DANS DES CIBLES" FontSize="20" FontWeight="SemiBold" />
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                <Border Background="#123122" CornerRadius="5" Padding="7,3">
                  <TextBlock Text="{Binding SelectedRemoteFabAssetCard.ContentKindLabel}" FontSize="10" FontWeight="Bold" Foreground="#5BDBA5" />
                </Border>
                <TextBlock Text="{Binding SelectedRemoteFabAssetCard.ContentKindReason}" FontSize="10" Foreground="#8294A8" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="{Binding SelectedRemoteFabAssetCard.InstallModeGuidance}" FontSize="10" Foreground="#9EB0C4" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Classes="history" Content="✕" Command="{Binding CloseFabInstallOptionsCommand}" ToolTip.Tip="Fermer" VerticalAlignment="Top" />
          </Grid>
          <Border Grid.Row="3" Background="#0B121A" BorderBrush="#202C39" BorderThickness="1" CornerRadius="9" Padding="12">
            <Grid RowDefinitions="Auto,*" RowSpacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="2 · VARIANTES CORRESPONDANT AUX MOTEURS SÉLECTIONNÉS" FontSize="10" FontWeight="Bold" Foreground="#70A8FA" />
              <TextBlock Grid.Column="1" Text="{Binding FabInstallVersionResultsLabel}" FontSize="9" Foreground="#8294A8" />
            </Grid>
            <ScrollViewer Grid.Row="1" MaxHeight="145" VerticalScrollBarVisibility="Auto">
              <Grid>
              <TextBlock IsVisible="{Binding !HasSelectedFabInstallTargets}" Text="Sélectionnez d’abord un ou plusieurs projets : seules leurs versions moteur seront proposées." Foreground="#8294A8" TextWrapping="Wrap" Margin="4" />
              <TextBlock IsVisible="{Binding HasNoCompatibleFabInstallVersions}" Text="Aucune variante de ce produit ne correspond aux versions moteur des cibles sélectionnées." Foreground="#E0A04D" TextWrapping="Wrap" Margin="4" />
              <ItemsControl IsVisible="{Binding HasCompatibleFabInstallVersions}" ItemsSource="{Binding CompatibleFabInstallVersions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:FabInstallVersionOptionViewModel">
                    <CheckBox IsChecked="{Binding IsSelected}" Margin="0,0,0,6">
                      <StackPanel>
                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ArtifactLabel}" FontSize="9" Foreground="#718398" />
                      </StackPanel>
                    </CheckBox>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              </Grid>
            </ScrollViewer>
            </Grid>
          </Border>
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="7">
            <TextBlock Text="1 · CHOISIR LES PROJETS CIBLES" FontSize="10" FontWeight="Bold" Foreground="#70A8FA" />
            <TextBlock Grid.Column="1" Text="{Binding FabInstallTargetResultsLabel}" FontSize="9" Foreground="#8294A8" HorizontalAlignment="Right" />
            <TextBox Grid.Row="1" Classes="path" Text="{Binding FabInstallTargetSearchQuery, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Rechercher un projet, un moteur, une version ou un chemin…" />
            <CheckBox Grid.Row="1" Grid.Column="1" IsVisible="{Binding IsFabInstallCompatibilityFilterVisible}" IsChecked="{Binding ShowOnlyCompatibleFabTargets}" Content="Compatibles uniquement" VerticalAlignment="Center" />
            <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel IsVisible="{Binding IsFabPluginTargetFilterVisible}" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <TextBlock Text="AFFICHER" FontSize="8" FontWeight="Bold" Foreground="#70A8FA" VerticalAlignment="Center" />
                <CheckBox IsChecked="{Binding ShowFabProjectInstallTargets}" Content="Projets" />
                <CheckBox IsChecked="{Binding ShowFabEngineInstallTargets}" Content="Moteurs" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Classes="ghost" Content="Actualiser les scripts" Command="{Binding RefreshFabInstallationScriptsCommand}" />
                <Button Classes="ghost" Content="Dossier des scripts" Command="{Binding OpenFabInstallationScriptsFolderCommand}" />
              </StackPanel>
            </Grid>
          </Grid>
          <ListBox Grid.Row="2" MinHeight="150" ItemsSource="{Binding FilteredFabInstallTargets}" Background="#0B121A" BorderBrush="#202C39" BorderThickness="1" CornerRadius="9" Padding="10" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate><VirtualizingStackPanel CacheLength="0.5" /></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:FabInstallTargetOptionViewModel">
                <Border IsVisible="{Binding IsVisible}" BorderBrush="#202C39" BorderThickness="0,0,0,1" Padding="8">
                  <Grid RowDefinitions="Auto">
                    <Grid ColumnDefinitions="Auto,*,300,Auto" ColumnSpacing="12">
                      <CheckBox IsChecked="{Binding IsSelected}" ToolTip.Tip="{Binding Path}" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="7">
                          <TextBlock Text="{Binding Kind}" FontSize="9" Foreground="#8294A8" />
                          <TextBlock Text="{Binding EngineVersion}" FontSize="9" Foreground="#AFC5DD" />
                          <TextBlock Text="{Binding CompatibilityLabel}" FontSize="8" Foreground="#D9A55C" />
                        </StackPanel>
                      </StackPanel>
                      <StackPanel Grid.Column="2" IsVisible="{Binding HasInstallationScripts}" Spacing="3">
                        <TextBlock Text="SCRIPT D’INSTALLATION" FontSize="8" FontWeight="Bold" Foreground="#70A8FA" />
                        <ComboBox ItemsSource="{Binding AvailableInstallationScripts}" SelectedItem="{Binding SelectedInstallationScript}">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:FabInstallationScriptOptionViewModel">
                              <StackPanel>
                                <TextBlock Text="{Binding DisplayName}" />
                                <TextBlock Text="{Binding OriginLabel}" FontSize="8" Foreground="#718398" />
                              </StackPanel>
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{Binding InstallationScriptEngineVersionLabel}" FontSize="8" Foreground="#8CC2FF" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <Button Grid.Column="3" IsVisible="{Binding HasInstallationConfiguration}" Command="{Binding OpenInstallationConfigurationCommand}" Content="Configurer" VerticalAlignment="Bottom" />
                      <TextBlock Grid.Column="2" IsVisible="{Binding !HasInstallationScripts}" Text="Aucun script compatible" Foreground="#D66A74" VerticalAlignment="Center" />
                    </Grid>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
            <TextBlock Text="Le script et sa configuration sont mémorisés par projet et par type d’asset. La sélection multiple est autorisée." FontSize="9" Foreground="#718398" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button Grid.Column="1" Classes="ghost" Content="Télécharger seulement" Command="{Binding DownloadSelectedFabVersionsCommand}" />
            <Button Grid.Column="2" Classes="accent" Content="Installer dans les cibles" Command="{Binding InstallSelectedFabVersionsCommand}" />
          </Grid>
        </Grid>
      </Grid>
    </Border>
  </Grid>

  <Grid IsVisible="{Binding IsFabInstallationScriptConfigurationVisible}" Panel.ZIndex="2050">
    <Border Background="#D0080C11" />
    <Border MaxWidth="720" MaxHeight="620" MinWidth="560" Margin="56" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#111820" BorderBrush="#438ED1" BorderThickness="1" CornerRadius="14" Padding="22" ClipToBounds="True">
      <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <StackPanel>
            <TextBlock Text="CONFIGURATION DU SCRIPT" FontSize="10" FontWeight="Bold" Foreground="#70A8FA" />
            <TextBlock Text="{Binding SelectedFabInstallationScriptTarget.SelectedInstallationScript.DisplayName}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" />
          </StackPanel>
          <Button Grid.Column="1" Classes="history" Content="✕" Command="{Binding CloseFabInstallationScriptConfigurationCommand}" ToolTip.Tip="Fermer" />
        </Grid>
        <Border Grid.Row="1" Background="#0B121A" BorderBrush="#26394C" BorderThickness="1" CornerRadius="8" Padding="12">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel>
              <TextBlock Text="{Binding SelectedFabInstallationScriptTarget.Name}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding SelectedFabInstallationScriptTarget.Path}" FontSize="9" Foreground="#718398" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Border Grid.Column="1" Background="#15304A" CornerRadius="6" Padding="9,5" VerticalAlignment="Center">
              <TextBlock Text="{Binding SelectedFabInstallationScriptTarget.InstallationScriptEngineVersionLabel}" FontSize="10" FontWeight="SemiBold" Foreground="#8CC2FF" />
            </Border>
          </Grid>
        </Border>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="12">
            <TextBlock Text="{Binding SelectedFabInstallationScriptTarget.InstallationScriptSummary}" Foreground="#9EB0C4" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding SelectedFabInstallationScriptTarget.InstallationConfiguration}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FabInstallationConfigurationOptionViewModel">
                  <Border Background="#0B121A" BorderBrush="#202C39" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto" ColumnSpacing="14">
                      <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <CheckBox Grid.Column="1" IsVisible="{Binding IsBoolean}" IsChecked="{Binding BooleanValue}" />
                      <TextBox Grid.Column="1" IsVisible="{Binding IsText}" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                      <ComboBox Grid.Column="1" IsVisible="{Binding IsChoice}" ItemsSource="{Binding Choices}" SelectedItem="{Binding Value}" />
                      <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Description}" FontSize="9" Foreground="#718398" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
          <TextBlock Text="Les modifications sont enregistrées automatiquement pour cette cible et ce type d’asset." FontSize="9" Foreground="#718398" VerticalAlignment="Center" TextWrapping="Wrap" />
          <Button Grid.Column="1" Classes="accent" Content="Terminer" Command="{Binding CloseFabInstallationScriptConfigurationCommand}" />
        </Grid>
      </Grid>
    </Border>
  </Grid>

  <Grid IsVisible="{Binding IsFabImagePreviewVisible}" Panel.ZIndex="2100">
    <Border Background="#D0080C11" />
    <Border MaxWidth="1260" MaxHeight="780" Margin="42" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#080D13" BorderBrush="#438ED1" BorderThickness="1" CornerRadius="14" Padding="18" ClipToBounds="True">
      <Grid RowDefinitions="Auto,*" RowSpacing="14">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
          <StackPanel>
            <TextBlock Text="APERÇU GRAND FORMAT" FontSize="10" FontWeight="Bold" Foreground="#70A8FA" />
            <TextBlock Text="{Binding SelectedRemoteFabAssetCard.Organization.DisplayName}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
          </StackPanel>
          <Button Grid.Column="1" Classes="history" Content="✕" Command="{Binding CloseFabImagePreviewCommand}" ToolTip.Tip="Fermer" />
        </Grid>
        <Border Grid.Row="1" Background="#030609" BorderBrush="#202C39" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
          <Image Source="{Binding SelectedRemoteFabAssetCard.PreviewImage}" IsVisible="{Binding SelectedRemoteFabAssetCard.HasPreviewImage}" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        </Border>
      </Grid>
    </Border>
  </Grid>

  <Grid IsVisible="{Binding IsEngineRemovalConfirmationVisible}" Panel.ZIndex="2200">
    <Border Background="#D0080C11" />
    <Border MaxWidth="640" Margin="42" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#111820" BorderBrush="#438ED1" BorderThickness="1" CornerRadius="14" Padding="24">
      <StackPanel Spacing="16">
        <TextBlock Text="RETIRER LE MOTEUR DE CYENGINEHUB" FontSize="19" FontWeight="SemiBold" />
        <TextBlock Text="{Binding SelectedEngineManagementName}" FontSize="15" FontWeight="SemiBold" Foreground="#A8C9F2" />
        <TextBlock Text="{Binding SelectedEngineManagementPath}" FontFamily="Consolas" FontSize="10" Foreground="#718398" TextWrapping="Wrap" />
        <Border Background="#132335" CornerRadius="8" Padding="12">
          <TextBlock Text="Le moteur sera uniquement retiré de la liste. Aucun fichier ne sera supprimé et il pourra être restauré depuis Paramètres → Moteurs." TextWrapping="Wrap" Foreground="#BCD0E6" />
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="9">
          <Button Classes="ghost" Content="Annuler" Command="{Binding CancelRemoveSelectedEngineCommand}" />
          <Button Classes="accent" Content="Retirer de la liste" Command="{Binding ConfirmRemoveSelectedEngineCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>

  <Grid IsVisible="{Binding IsEngineUninstallConfirmationVisible}" Panel.ZIndex="2250">
    <Border Background="#D0080C11" />
    <Border MaxWidth="680" Margin="42" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#111820" BorderBrush="#B84D5C" BorderThickness="1" CornerRadius="14" Padding="24">
      <StackPanel Spacing="16">
        <TextBlock Text="DÉSINSTALLER LE MOTEUR" FontSize="19" FontWeight="SemiBold" Foreground="#F0B4B7" />
        <TextBlock Text="{Binding SelectedEngineManagementName}" FontSize="15" FontWeight="SemiBold" />
        <TextBlock Text="{Binding SelectedEngineManagementPath}" FontFamily="Consolas" FontSize="10" Foreground="#718398" TextWrapping="Wrap" />
        <Border Background="#321A1D" CornerRadius="8" Padding="12">
          <TextBlock Text="Cette action supprime définitivement tout le dossier du moteur. Les projets ne sont pas supprimés. Vérifiez qu’aucun éditeur ni outil de build n’utilise cette installation." TextWrapping="Wrap" Foreground="#F0B4B7" />
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="9">
          <Button Classes="ghost" Content="Annuler" Command="{Binding CancelUninstallSelectedEngineCommand}" />
          <Button Classes="danger" Content="Confirmer la désinstallation" Command="{Binding ConfirmUninstallSelectedEngineCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
  </Grid>
</Window>
