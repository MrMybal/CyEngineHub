<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../../../src/CyEngineHub.Desktop/CyEngineHub.Desktop.csproj" /></ItemGroup>
  <Target Name="UseWebView2CoreOnly" BeforeTargets="ResolveAssemblyReferences">
